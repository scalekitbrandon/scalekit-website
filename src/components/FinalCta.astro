---
// Section 11 — Final CTA. Real, approved copy per copy.md. The optional
// founder-capacity urgency line noted in copy.md is NOT included — it
// needed explicit confirmation before use and wasn't confirmed.
interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  ctaLabel?: string;
  ctaMicrocopy?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Run Your Own Numbers',
  headline = "What's One More Automated Lead Actually Worth?",
  subheadline = 'Every missed follow-up is money you already spent to get. ScaleKit makes sure it doesn\'t happen again.',
  ctaLabel = 'Book Your Free Strategy Call',
  ctaMicrocopy = "20 minutes. Free. We'll show you exactly what an AI-powered version of your business looks like.",
  ctaHref = '#book-call',
} = Astro.props;
---

<section class="final-cta">
  <div class="inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="headline">{headline}</h2>
    <p class="sub">{subheadline}</p>
    <a href={ctaHref} class="cta">
      {ctaLabel}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
    </a>
    <p class="cta-micro">{ctaMicrocopy}</p>
  </div>
</section>

<style>
  .final-cta {
    background-color: var(--color-dark-bg);
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
    padding: var(--space-cta) var(--space-6);
    text-align: center;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 700px; margin: 0 auto; }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(30px, 4.5vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.022em;
    line-height: 1.1;
    color: var(--color-dark-fg);
    margin: 0 0 var(--space-4);
  }
  .sub {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 var(--space-6);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 17px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
  }
  .cta:hover { background: var(--color-primary-hover); border-color: var(--color-primary-hover); }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }
  .cta-micro {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    margin: var(--space-3) 0 0;
  }

  @media (max-width: 560px) {
    .final-cta { padding: 72px var(--space-5); }
  }
</style>
