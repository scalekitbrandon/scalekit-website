---
// Hero for the per-industry service pages (src/pages/services/<industry>.astro).
// Reuses ScaleKit's own brand tokens (cream bg, lime accent, near-black
// text, Plus Jakarta Sans) — not the industry-template's own placeholder
// branding, since this page is ScaleKit selling TO that industry, not a
// mockup of a site built FOR them (that's what TemplateShowcase is for).
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  headline: string;
  subheadline: string;
  painPoints?: string[];
  // Default false everywhere (red alert-circle icon, problem-framed
  // copy) to preserve every existing page's behavior — pass true to get
  // a green checkmark instead, for pages that want to list benefits
  // instead of pain points.
  positive?: boolean;
  // Two-column benefits grid — separate from painPoints/positive above.
  // Uses the exact checkmark treatment from the homepage's own
  // Hero.astro (.check: 28px lime circle, 2px black border, black
  // checkmark) rather than the smaller stroke-only icon painPoints
  // uses, per explicit request to match the homepage exactly.
  checklist?: string[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow,
  headline,
  subheadline,
  painPoints,
  positive = false,
  checklist,
  ctaLabel = 'Book Your Free Strategy Call',
  ctaHref = '#book-call',
} = Astro.props;
---

<section class="industry-hero">
  <div class="inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="headline">{headline}</h1>
    <p class="sub">{subheadline}</p>

    {checklist && (
      <ul class="hero-checklist">
        {checklist.map((item) => (
          <li>
            <span class="check">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    )}

    {painPoints && (
      <div class="pain-points">
        {painPoints.map((point) => (
          <div class="pain-point">
            {positive ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="8 12.5 10.5 15 16 9"/></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="#cc2222" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            )}
            <span>{point}</span>
          </div>
        ))}
      </div>
    )}

    <Button href={ctaHref} variant="primary">{ctaLabel}</Button>
  </div>
</section>

<style>
  .industry-hero {
    background: var(--color-bg);
    padding: var(--space-8) var(--space-6) var(--space-7);
    font-family: var(--font-body);
  }
  .inner { max-width: 780px; margin: 0 auto; text-align: center; }

  .eyebrow {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: var(--radius-pill, 100px);
    margin: 0 0 22px;
  }
  .headline {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-fg);
    margin: 0 0 20px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0 0 36px;
  }

  .hero-checklist {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 28px;
    max-width: 640px;
    margin-inline: auto;
    text-align: left;
  }
  .hero-checklist li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-fg);
  }
  .hero-checklist .check {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-checklist .check svg { width: 14px; height: 14px; }

  .pain-points {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    max-width: 480px;
    margin: 0 auto 40px;
    text-align: left;
  }
  .pain-point {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-fg);
  }
  .pain-point svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }

  @media (max-width: 560px) {
    .industry-hero { padding: var(--space-7) var(--space-5) var(--space-6); }
    .hero-checklist { grid-template-columns: 1fr; }
  }
</style>
