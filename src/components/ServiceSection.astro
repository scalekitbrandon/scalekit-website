---
// Full standalone section for one service on the multi-service vertical
// hub pages (public-adjusters.astro and future ones) — headline,
// subheadline, a fuller explanation paragraph, optional custom content
// via the default slot (e.g. the website thumbnail carousel), and two
// CTAs. Built to upgrade ServiceOverviewGrid's compact cards into full
// sections one at a time ("build this section and we will move on to
// the next one") — the other 4 services stay in the compact grid until
// their turn.
interface Props {
  eyebrow: string;
  // Two-line headline, second line gets the homepage's signature
  // black-box/lime-text accent treatment (same pattern as
  // WebsitesFunnels.astro / SaveTimeScale.astro on the homepage) —
  // per explicit request to mimic the homepage's per-service headlines
  // instead of a single plain bold line.
  headlineLine1: string;
  headlineLine2: string;
  subheadline: string;
  body?: string;
  // Optional 2-col checkmark benefits grid, same checkmark treatment as
  // IndustryHero's .hero-checklist — for services (like Local SEO) whose
  // real landing page has a defined benefits list worth surfacing here
  // instead of/alongside a slotted visual.
  checklist?: string[];
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref: string;
  background?: 'bg' | 'bg-alt';
  // 'stacked' (default): header full-width, then slot content below —
  // used by Websites & Funnels' full-width thumbnail carousel. 'side-by-
  // side': header and slot content sit in a 2-col row (copy left, visual
  // right) — used by Local SEO's rank-grid graphic, which reads as a
  // supporting visual next to the copy rather than a full-width block.
  layout?: 'stacked' | 'side-by-side';
}

const {
  eyebrow,
  headlineLine1,
  headlineLine2,
  subheadline,
  body = '',
  checklist,
  primaryCtaLabel = 'Book a Call',
  primaryCtaHref = '#book-call',
  secondaryCtaLabel = 'Learn More',
  secondaryCtaHref,
  background = 'bg',
  layout = 'stacked',
} = Astro.props;
---

<section class:list={['service-section', `bg-${background}`]}>
  <div class="inner">
    <div class:list={['content', `layout-${layout}`]}>
      <div class="header">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="headline">
          <span class="line">{headlineLine1}</span>
          <span class="line accent">{headlineLine2}</span>
        </h2>
        <p class="sub">{subheadline}</p>
        {body && <p class="body">{body}</p>}

        {checklist && (
          <ul class="benefits-checklist">
            {checklist.map((item) => (
              <li>
                <span class="check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="visual">
        <slot />
      </div>
    </div>

    <div class="cta-row">
      <a href={primaryCtaHref} class="cta primary">
        {primaryCtaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
      <a href={secondaryCtaHref} class="cta secondary">{secondaryCtaLabel}</a>
    </div>
  </div>
</section>

<style>
  .service-section {
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .bg-bg { background: var(--color-bg); }
  .bg-bg-alt { background: var(--color-bg-alt); }

  .inner { max-width: 1100px; margin: 0 auto; }

  .content.layout-stacked { display: block; }
  .content.layout-side-by-side {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-7);
    align-items: center;
    margin: 0 0 var(--space-7);
  }
  .content.layout-side-by-side .header { max-width: none; margin: 0; }
  .content.layout-side-by-side .visual:empty {
    aspect-ratio: 1 / 1;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .content.layout-side-by-side .visual:empty::after { content: 'Photo'; }

  .header { max-width: 700px; margin: 0 0 var(--space-7); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(30px, 4.2vw, 46px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
  }
  .headline .line { display: block; color: var(--color-fg); }
  .headline .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 4px 18px;
    border-radius: var(--radius-sm);
    margin-top: 10px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0 0 var(--space-3);
  }
  .body {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-text-mid);
    margin: 0;
  }

  .benefits-checklist {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 28px;
  }
  .benefits-checklist li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--color-fg);
  }
  .benefits-checklist .check {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .benefits-checklist .check svg { width: 13px; height: 13px; }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-7);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 15px 30px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }
  .cta.primary {
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border: 2px solid var(--color-primary);
  }
  .cta.primary:hover { background: var(--color-primary-hover); border-color: var(--color-primary-hover); }
  .cta.secondary {
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
  }
  .cta.secondary:hover { background: var(--color-fg); color: #ffffff; }

  @media (max-width: 800px) {
    .content.layout-side-by-side {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .content.layout-side-by-side .header { margin: 0 0 var(--space-6); }
  }

  @media (max-width: 560px) {
    .service-section { padding: var(--space-7) var(--space-5); }
  }
</style>
