---
// "Websites & Funnels That Convert & Rank" — industry showcase carousel.
// Structure now modeled directly on a template-marketplace reference
// Brandon supplied (clean image card: rounded thumbnail, name below,
// horizontal scroll with left/right arrows) — colors, type, and copy
// stay ScaleKit's own.
// Card thumbnails are REAL screenshots of each real industry template's
// actual nav+hero (captured via a headless browser against this same
// site's own real components — not a fabricated/stock image, not an
// AI-generated mockup). This replaces two earlier live-DOM approaches
// (a width:400%/transform:scale "mini-page" hack, and later a natural-
// render browser-chrome frame) that each required guessing at CSS
// numbers with no way to see the real rendered result and kept coming
// out wrong. A real screenshot is what the reference itself uses, is
// pixel-exact by construction, and needs zero per-template tuning.
// Every screenshot is captured at the exact same fixed crop — 1440px
// wide x 820px tall, from the top of the page — not each template's own
// natural hero height. Natural height varies a lot per template (a
// floating-nav template like Therapists is much shorter than one with a
// tall embedded lead form like Roofing); cropping each to its own
// natural height, or letting the img keep its own ratio, both produced
// visibly different-sized cards in the same row. A single fixed crop
// means every card is identically sized — for shorter templates that
// crop dips slightly into the section after the hero, which is fine.
// Regenerating a thumbnail (after a template's hero copy/design
// changes): spin up a throwaway page rendering that template's
// <Header /><Hero /> (plus whatever section comes after the hero, so
// there's real content to show if the crop runs past it — see git
// history on this file for the exact pages used), screenshot it with
// Playwright at viewport width 1440, `clip: { x: 0, y: 0, width: 1440,
// height: 820 }`, save over the matching file in
// public/images/template-previews/, delete the throwaway page.
interface Card {
  industry: string;
  description: string;
  slug: string;
  image: string;
}

interface Props {
  eyebrow?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subheadline?: string;
  cards?: Card[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Website Design',
  headlineLine1 = 'Websites & Funnels',
  headlineLine2 = 'Built to Rank and Convert',
  subheadline = 'Your website needs to build trust, establish authority, and turn visitors into customers. We build the sites that do exactly that. Start from our proven structures and we customize everything from there.',
  cards = [
    { industry: 'Home Services', description: 'Bold video-hero layout built to turn browsers into booked estimates.', slug: 'home-services', image: '/images/template-previews/home-services.jpg' },
    { industry: 'Roofing', description: 'Storm-damage focused, built around the insurance claim process.', slug: 'roofing', image: '/images/template-previews/roofing.jpg' },
    { industry: 'Therapists & Advisors', description: 'A warm, elegant design built to build trust before the first conversation.', slug: 'therapists-advisors', image: '/images/template-previews/therapists-advisors.jpg' },
    { industry: 'Landscaping', description: 'Portfolio-first design built to showcase real project photos.', slug: 'landscaping', image: '/images/template-previews/landscaping.jpg' },
    { industry: 'Agency & Consultant', description: 'AI-powered SaaS positioning built to convert agencies and consultants.', slug: 'agency-consultant', image: '/images/template-previews/agency-consultant.jpg' },
    { industry: 'Restoration', description: '24/7 emergency response front and center, claims-ready.', slug: 'restoration', image: '/images/template-previews/restoration.jpg' },
  ],
  // NOTE: dedicated service page doesn't exist yet — placeholder path,
  // wire up once /services/websites-funnels (or similar) is built.
  ctaLabel = 'Explore Websites & Funnels',
  ctaHref = '/services/websites-funnels',
} = Astro.props;
---

<section class="showcase" id="websites-funnels">
  <div class="showcase-inner">

    <div class="showcase-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">
        <span class="line">{headlineLine1}</span>
        <span class="line accent">{headlineLine2}</span>
      </h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="carousel-row">
      <button type="button" class="carousel-arrow prev" data-carousel-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="carousel-track" data-carousel-track>
        {cards.map((card) => (
          <a href={`/services/${card.slug}`} class="card">
            <div class="card-thumb">
              <img src={card.image} alt={`${card.industry} website template preview`} loading="lazy" />
            </div>
            <div class="card-body">
              <h3 class="industry">{card.industry}</h3>
              <p class="description">{card.description}</p>
              <span class="learn-more">
                See How We'd Build This For You
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <button type="button" class="carousel-arrow next" data-carousel-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="cta">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .showcase {
    background: var(--color-bg);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .showcase-inner { max-width: 1200px; margin: 0 auto; }

  .showcase-header { max-width: 700px; margin: 0 0 var(--space-8); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
  }
  .headline .line { display: block; color: var(--color-fg); }
  .headline .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 4px 18px;
    border-radius: var(--radius-sm);
    margin-top: 10px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .carousel-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .carousel-arrow {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: #ffffff;
    color: var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .carousel-arrow svg { width: 19px; height: 19px; }
  .carousel-arrow:hover { background: var(--color-primary); border-color: var(--color-primary); }
  .carousel-arrow:disabled { opacity: 0.35; cursor: default; }
  .carousel-arrow:disabled:hover { background: #ffffff; border-color: var(--color-border); }

  .carousel-track {
    flex: 1;
    min-width: 0;
    display: flex;
    /* Cards are naturally different heights now (see .card-thumb img
       comment) — flex-start keeps each one its own height instead of
       stretching to match the tallest and leaving blank space below
       the shorter ones. */
    align-items: flex-start;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }

  .card {
    flex: 0 0 calc(33.333% - var(--space-5) * 2 / 3);
    scroll-snap-align: start;
    min-width: 280px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .card:hover {
    box-shadow: 0 16px 32px rgba(10, 10, 10, 0.1);
    transform: translateY(-2px);
  }
  .card-thumb {
    /* All 6 screenshots were captured at the same fixed 1440x820 crop
       (see the file-header comment) — some show a bit of the section
       after the hero, some don't, but every card ends up the same size,
       matching the reference exactly. aspect-ratio here is just a
       responsive-width safety net since the images already match it. */
    aspect-ratio: 1440 / 820;
    overflow: hidden;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body { padding: var(--space-5); }
  .industry {
    font-size: 19px;
    font-weight: var(--font-weight-max);
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .description {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-mid);
    margin: 0 0 18px;
  }
  .learn-more {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-fg);
    border-bottom: 1.5px solid var(--color-primary);
    padding-bottom: 2px;
  }
  .learn-more svg { width: 13px; height: 13px; flex-shrink: 0; }

  .cta-row {
    text-align: center;
    margin-top: var(--space-8);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--color-fg); color: #ffffff; }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .card { flex-basis: calc(50% - var(--space-5) / 2); }
  }
  @media (max-width: 560px) {
    .showcase { padding: var(--space-7) var(--space-5); }
    .carousel-row { gap: var(--space-3); }
    .carousel-arrow { width: 38px; height: 38px; }
    .carousel-arrow svg { width: 16px; height: 16px; }
    .card { flex-basis: 84%; min-width: 0; }
  }
</style>

<script>
  const track = document.querySelector('[data-carousel-track]');
  const prevBtn = document.querySelector('[data-carousel-prev]');
  const nextBtn = document.querySelector('[data-carousel-next]');

  function scrollStep() {
    const card = track?.querySelector('.card');
    const gap = 24;
    return card ? card.getBoundingClientRect().width + gap : 320;
  }

  function updateArrows() {
    if (!track || !(prevBtn instanceof HTMLButtonElement) || !(nextBtn instanceof HTMLButtonElement)) return;
    const maxScroll = track.scrollWidth - track.clientWidth - 2;
    prevBtn.disabled = track.scrollLeft <= 0;
    nextBtn.disabled = track.scrollLeft >= maxScroll;
  }

  prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -scrollStep(), behavior: 'smooth' }));
  nextBtn?.addEventListener('click', () => track?.scrollBy({ left: scrollStep(), behavior: 'smooth' }));
  track?.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();
</script>
