---
// "Websites & Funnels That Convert & Rank" — industry showcase grid.
// Structure adapted from a reference layout (eyebrow / 2-line accent
// headline / subhead / 3x2 mockup card grid); colors, type, and copy are
// ScaleKit's own, not carried over from the reference.
// NOTE: no real mockup screenshots exist yet — most cards use placeholder
// preview boxes. The Roofing card renders the REAL industry-template
// components (~/Astro-Sites/_industry-templates/roofing/) at full size,
// scaled down via CSS transform inside a clipped frame — same technique
// as .sk-mini-page in funnel-library/scalekit-main-landing-page/styles.css.
// This is the actual design, just small — not an abstraction, not a
// fabricated fake screenshot.
import RoofingHeader from '../vendor/industry-templates/roofing/Header.astro';
import RoofingHero from '../vendor/industry-templates/roofing/Hero.astro';
import RoofingServices from '../vendor/industry-templates/roofing/Services.astro';
import LandscapingHeader from '../vendor/industry-templates/landscaping/Header.astro';
import LandscapingHero from '../vendor/industry-templates/landscaping/Hero.astro';
import LandscapingGallery from '../vendor/industry-templates/landscaping/Gallery.astro';
import RestorationHeader from '../vendor/industry-templates/restoration/Header.astro';
import RestorationHero from '../vendor/industry-templates/restoration/Hero.astro';
import RestorationServices from '../vendor/industry-templates/restoration/Services.astro';
import AgencyHeader from '../vendor/industry-templates/agency/Header.astro';
import AgencyHero from '../vendor/industry-templates/agency/Hero.astro';
import AgencyFeatures from '../vendor/industry-templates/agency/Features.astro';
import HomeServicesHeader from '../vendor/anchor-home-services/Header.astro';
import HomeServicesHero from '../vendor/anchor-home-services/Hero.astro';
import HomeServicesServices from '../vendor/anchor-home-services/Services.astro';
import TherapistsHeader from '../vendor/industry-templates/therapists-advisors/Header.astro';
import TherapistsHero from '../vendor/industry-templates/therapists-advisors/Hero.astro';
import TherapistsSpecialties from '../vendor/industry-templates/therapists-advisors/Specialties.astro';
import TherapistsIntro from '../vendor/industry-templates/therapists-advisors/Intro.astro';

interface Card {
  industry: string;
  description: string;
  slug: string;
}

interface Props {
  eyebrow?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subheadline?: string;
  cards?: Card[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Website Design',
  headlineLine1 = 'Websites & Funnels',
  headlineLine2 = 'Built to Rank and Convert',
  subheadline = 'Your website needs to build trust, establish authority, and turn visitors into customers. We build the sites that do exactly that. Start from our proven structures and we customize everything from there.',
  cards = [
    { industry: 'Home Services', description: 'Bold video-hero layout built to turn browsers into booked estimates.', slug: 'home-services' },
    { industry: 'Roofing', description: 'Storm-damage focused, built around the insurance claim process.', slug: 'roofing' },
    { industry: 'Therapists & Advisors', description: 'A warm, elegant design built to build trust before the first conversation.', slug: 'therapists-advisors' },
    { industry: 'Landscaping', description: 'Portfolio-first design built to showcase real project photos.', slug: 'landscaping' },
    { industry: 'Agency & Consultant', description: 'AI-powered SaaS positioning built to convert agencies and consultants.', slug: 'agency-consultant' },
    { industry: 'Restoration', description: '24/7 emergency response front and center, claims-ready.', slug: 'restoration' },
  ],
  // NOTE: dedicated service page doesn't exist yet — placeholder path,
  // wire up once /services/websites-funnels (or similar) is built.
  ctaLabel = 'Explore Websites & Funnels',
  ctaHref = '/services/websites-funnels',
} = Astro.props;
---

<section class="showcase" id="websites-funnels">
  <div class="showcase-inner">

    <div class="showcase-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">
        <span class="line">{headlineLine1}</span>
        <span class="line accent">{headlineLine2}</span>
      </h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="card-grid">
      {cards.map((card) => (
        <div class="card">
          {card.industry === 'Therapists & Advisors' ? (
            <div class="card-preview therapists-preview" aria-hidden="true">
              <div class="mini-page-wrap">
                <div class="mini-page">
                  <TherapistsHeader />
                  <TherapistsHero heroImageUrl="https://assets.cdn.filesafe.space/xqDaZG0jn1TlXwXyX8Jk/media/6aa6fbbf85b9b36bdb29026e.jpg" />
                  <TherapistsSpecialties />
                  <TherapistsIntro />
                </div>
              </div>
            </div>
          ) : card.industry === 'Home Services' ? (
            <div class="card-preview home-services-preview" aria-hidden="true">
              <div class="mini-page-wrap">
                <div class="mini-page">
                  <HomeServicesHeader />
                  <HomeServicesHero />
                  <HomeServicesServices />
                </div>
              </div>
            </div>
          ) : card.industry === 'Roofing' ? (
            <div class="card-preview roofing-preview" aria-hidden="true">
              <div class="mini-page-wrap">
                <div class="mini-page">
                  <RoofingHeader />
                  <RoofingHero />
                  <RoofingServices />
                </div>
              </div>
            </div>
          ) : card.industry === 'Landscaping' ? (
            <div class="card-preview landscaping-preview" aria-hidden="true">
              <div class="mini-page-wrap">
                <div class="mini-page">
                  <LandscapingHeader />
                  <LandscapingHero />
                  <LandscapingGallery />
                </div>
              </div>
            </div>
          ) : card.industry === 'Restoration' ? (
            <div class="card-preview restoration-preview" aria-hidden="true">
              <div class="mini-page-wrap">
                <div class="mini-page">
                  <RestorationHeader />
                  <RestorationHero />
                  <RestorationServices />
                </div>
              </div>
            </div>
          ) : card.industry === 'Agency & Consultant' ? (
            <div class="card-preview agency-preview" aria-hidden="true">
              <div class="mini-page-wrap">
                <div class="mini-page">
                  <AgencyHeader />
                  <AgencyHero />
                  <AgencyFeatures />
                </div>
              </div>
            </div>
          ) : (
            <div class="card-preview" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="M2 8h20"/>
                <circle cx="5" cy="6" r="0.5" fill="currentColor"/>
                <circle cx="7" cy="6" r="0.5" fill="currentColor"/>
              </svg>
              <span class="preview-label">Preview Coming Soon</span>
            </div>
          )}
          <div class="card-body">
            <h3 class="industry">{card.industry}</h3>
            <p class="description">{card.description}</p>
            <a href={`/services/${card.slug}`} class="learn-more">
              See How We'd Build This For You
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="cta">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .showcase {
    background: var(--color-bg);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .showcase-inner { max-width: 1200px; margin: 0 auto; }

  .showcase-header { max-width: 700px; margin: 0 0 var(--space-8); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
  }
  .headline .line { display: block; color: var(--color-fg); }
  .headline .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 4px 18px;
    border-radius: var(--radius-sm);
    margin-top: 10px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    /* Roofing's preview is intentionally taller than the others (see
       .roofing-preview below) — align-items:start keeps that from
       stretching sibling cards' height to match. */
    align-items: start;
  }
  .card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .card-preview {
    aspect-ratio: 4 / 3;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--color-text-light);
  }
  .card-preview svg { width: 40px; height: 40px; opacity: 0.5; }
  .preview-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }
  /*
    Roofing mini preview — renders the REAL industry-template components
    (~/Astro-Sites/_industry-templates/roofing/Header.astro + Hero.astro)
    at their actual full-desktop layout width, then scales the whole
    thing down to fit the card. Same technique as .sk-mini-page in
    funnel-library/scalekit-main-landing-page/styles.css: the inner
    element is sized at 300% of its (card-sized) container and scaled by
    exactly 1/3, so it renders as if in a ~3x-wider viewport — comfortably
    past this component's own mobile breakpoints — then shrinks back to
    precisely fit the card at any card size, responsively.
  */
  .roofing-preview {
    display: block;
    padding: 0;
    position: relative;
    background: #ffffff;
    /* Back to the same 4/3 box every other card uses (inherited from
       .card-preview) — the taller crop showed more of the page but made
       this card visibly bigger than its siblings. */
  }
  /* Landscaping mini preview — same live-component-scaled recipe as
     Roofing above (real Header.astro + Hero.astro from
     _industry-templates/landscaping/, scaled via .mini-page-wrap /
     .mini-page). Its own class names (.nav-links, .headline, .sub)
     match Roofing's, so the shared :global() overrides below apply to
     both automatically — no separate override block needed. */
  .landscaping-preview {
    display: block;
    padding: 0;
    position: relative;
    background: #ffffff;
  }
  /* Restoration mini preview — same recipe again (Header + Hero +
     Services from _industry-templates/restoration/). Its Hero headline
     and Services headline both use class="headline" too, so they pick
     up the same font-size cap automatically. */
  .restoration-preview {
    display: block;
    padding: 0;
    position: relative;
    background: #ffffff;
  }
  /* Agency & Consultant mini preview — same recipe (Header + Hero +
     Features from _industry-templates/agency/). First non-trade
     template in the set; still shares the .headline/.nav-links class
     names so the existing overrides apply without changes. */
  .agency-preview {
    display: block;
    padding: 0;
    position: relative;
    background: #ffffff;
  }
  /* Home Services mini preview — same recipe (Header + Hero + Services
     from anchor-home-services/src/components/). Its Hero.astro has a real
     <video> background, but the placeholder heroVideoUrl never resolves
     to a real source, so the thumbnail shows the navy gradient fallback
     — same graceful-degradation behavior the full-size page gets before
     a real client video is supplied. */
  .home-services-preview {
    display: block;
    padding: 0;
    position: relative;
    background: #ffffff;
  }
  /* Therapists & Advisors mini preview — same recipe (Header + Hero +
     Specialties from _industry-templates/therapists-advisors/). This
     template's Header.astro is itself `position: absolute` (it floats
     over Hero's photo by design), which resolves correctly against
     .mini-page below since .mini-page is also positioned — no extra
     override needed for that to line up inside the thumbnail. */
  .therapists-preview {
    display: block;
    padding: 0;
    position: relative;
    background: #ffffff;
  }
  .mini-page-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .mini-page {
    position: absolute;
    top: 0;
    left: 0;
    /* 400%/0.25 instead of 300%/0.3333 — renders as if the card were 4x
       wider, giving real margin above the header's own 980px
       nav-collapse breakpoint (390px-ish cards were landing right at
       ~980px effective width, too tight — nav labels wrapped and the
       CTA overflowed). Also makes every element read smaller/more
       proportionate at thumbnail size, which helps the oversized
       headline too. */
    width: 400%;
    transform: scale(0.25);
    transform-origin: top left;
    pointer-events: none;
    -webkit-font-smoothing: antialiased;
  }
  /* Nav links (Home/About/Residential/etc.) aren't legible at thumbnail
     size regardless of width — hiding them removes the wrapping risk
     entirely and leaves room for logo + phone + CTA to breathe. */
  .mini-page :global(.nav-links) {
    display: none !important;
  }
  /* Hero headline was still visually dominating the small preview even
     at the wider effective render — sized down explicitly rather than
     relying on the component's own desktop clamp() scale. */
  .mini-page :global(.headline) {
    font-size: 34px !important;
  }
  .mini-page :global(.sub) {
    font-size: 15px !important;
  }

  .card-body { padding: var(--space-5); }
  .industry {
    font-size: 20px;
    font-weight: var(--font-weight-max);
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .description {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-mid);
    margin: 0 0 18px;
  }
  .learn-more {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-fg);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-primary);
    padding-bottom: 2px;
    transition: opacity 0.15s;
  }
  .learn-more:hover { opacity: 0.7; }
  .learn-more svg { width: 13px; height: 13px; flex-shrink: 0; }

  .cta-row {
    text-align: center;
    margin-top: var(--space-8);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--color-fg); color: #ffffff; }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .showcase { padding: var(--space-7) var(--space-5); }
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
