---
// 3-visible-column thumbnail carousel showing real website templates,
// for the Websites & Funnels ServiceSection on the multi-service
// vertical hub pages (public-adjusters.astro first). No public-adjuster-
// specific template exists yet, so per explicit direction this shows
// our existing real "home services" category templates as a stand-in
// ("use the home services templates for now") — Home Services/Anchor,
// Roofing, Landscaping, Restoration, and the real Brush Hour Painting
// client build.
// Standardized to the same real-screenshot approach as WebsitesFunnels.astro
// (see that file's header comment for the full reasoning) — this used to
// use the .mini-page live-scaled-render technique (400% width + transform:
// scale(0.25)), the same fragile pattern that caused repeated sizing
// problems on the homepage. Same fixed 1440x820 crop convention as the
// homepage's images (see public/images/template-previews/), so any
// template reused in both places (Home Services, Roofing, Landscaping,
// Restoration) uses the exact same image file — no duplicate screenshots.
const thumbs = [
  { label: 'Home Services', image: '/images/template-previews/home-services.jpg' },
  { label: 'Roofing', image: '/images/template-previews/roofing.jpg' },
  { label: 'Landscaping', image: '/images/template-previews/landscaping.jpg' },
  { label: 'Restoration', image: '/images/template-previews/restoration.jpg' },
  { label: 'Painting', image: '/images/template-previews/painting.jpg' },
];
---

<div class="thumb-carousel">
  <button type="button" class="thumb-arrow prev" data-thumb-prev aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
  </button>

  <div class="thumb-track" data-thumb-track>
    {thumbs.map((thumb) => (
      <div class="thumb">
        <div class="thumb-preview">
          <img src={thumb.image} alt={`${thumb.label} website template preview`} loading="lazy" />
        </div>
        <p class="thumb-label">{thumb.label}</p>
      </div>
    ))}
  </div>

  <button type="button" class="thumb-arrow next" data-thumb-next aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
  </button>
</div>

<style>
  .thumb-carousel {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
  }
  .thumb-arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: #ffffff;
    color: var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .thumb-arrow svg { width: 18px; height: 18px; }
  .thumb-arrow:hover { background: var(--color-primary); border-color: var(--color-primary); }
  .thumb-arrow:disabled { opacity: 0.35; cursor: default; }
  .thumb-arrow:disabled:hover { background: #ffffff; border-color: var(--color-border); }

  .thumb-track {
    flex: 1;
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .thumb-track::-webkit-scrollbar { display: none; }

  .thumb {
    flex: 0 0 calc(33.333% - var(--space-4) * 2 / 3);
    scroll-snap-align: start;
    min-width: 260px;
  }
  .thumb-preview {
    aspect-ratio: 1440 / 820;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 0 0 var(--space-3);
  }
  .thumb-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb-label {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-fg);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 900px) {
    .thumb { flex-basis: calc(50% - var(--space-4) / 2); }
  }
  @media (max-width: 560px) {
    .thumb { flex-basis: 82%; min-width: 0; }
    .thumb-arrow { width: 36px; height: 36px; }
  }
</style>

<script>
  const track = document.querySelector('[data-thumb-track]');
  const prevBtn = document.querySelector('[data-thumb-prev]');
  const nextBtn = document.querySelector('[data-thumb-next]');

  function scrollStep() {
    const thumb = track?.querySelector('.thumb');
    const gap = 24;
    return thumb ? thumb.getBoundingClientRect().width + gap : 280;
  }

  function updateArrows() {
    if (!track || !(prevBtn instanceof HTMLButtonElement) || !(nextBtn instanceof HTMLButtonElement)) return;
    const maxScroll = track.scrollWidth - track.clientWidth - 2;
    prevBtn.disabled = track.scrollLeft <= 0;
    nextBtn.disabled = track.scrollLeft >= maxScroll;
  }

  prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -scrollStep(), behavior: 'smooth' }));
  nextBtn?.addEventListener('click', () => track?.scrollBy({ left: scrollStep(), behavior: 'smooth' }));
  track?.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();
</script>
