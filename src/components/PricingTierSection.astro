---
// One per-service pricing block on /pricing (Websites & Funnels, Local
// SEO, Ads, CRM & Automation, AI Agents). Sections alternate --color-bg /
// --color-bg-alt like the reference layout, for visual separation without
// hard dividers. Renders a centered single card when there's only one
// (Scout, which has one locked price instead of a low/high tier) instead
// of stretching it across a grid built for 2+.
import PricingCard from './PricingCard.astro';

interface CardConfig {
  name: string;
  price?: string;
  period?: string;
  description?: string;
  features?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  featured?: boolean;
  badgeLabel?: string;
  placeholder?: boolean;
}

interface Props {
  id?: string;
  eyebrow: string;
  headline: string;
  subheadline?: string;
  cards: CardConfig[];
  note?: string;
  background?: 'bg' | 'bg-alt';
}

const {
  id = '',
  eyebrow,
  headline,
  subheadline = '',
  cards,
  note = '',
  background = 'bg',
} = Astro.props;

const isSingle = cards.length === 1;
const cols = Math.min(cards.length, 3);
---

<section class:list={['pricing-tier-section', `bg-${background}`]} id={id}>
  <div class="inner">
    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
      {subheadline && <p class="sub">{subheadline}</p>}
    </div>

    <div class:list={['grid', isSingle && 'is-single']} style={`--cols: ${cols}`}>
      {cards.map((c) => <PricingCard {...c} />)}
    </div>

    {note && <p class="note">{note}</p>}
  </div>
</section>

<style>
  .pricing-tier-section {
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .bg-bg { background: var(--color-bg); }
  .bg-bg-alt { background: var(--color-bg-alt); }

  .inner { max-width: var(--container-max-nav); margin: 0 auto; }

  .header { text-align: center; max-width: 620px; margin: 0 auto var(--space-7); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    margin: 0 0 var(--space-3);
  }
  .sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-5);
    align-items: stretch;
  }
  .grid.is-single {
    grid-template-columns: minmax(0, 400px);
    justify-content: center;
  }

  .note {
    text-align: center;
    font-size: 14px;
    color: var(--color-text-mid);
    max-width: 560px;
    margin: var(--space-6) auto 0;
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .pricing-tier-section { padding: var(--space-7) var(--space-5); }
  }
</style>
