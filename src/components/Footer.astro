---
// Restructured per reference layout: dark full-bleed footer, a wider
// brand column (logo + tagline + contact email) on the left, link
// group columns on the right, a divider, then a copyright row. Colors
// use ScaleKit's own dark-section tokens (--color-dark-bg, near-black)
// rather than the reference's navy, matching every other dark section
// already on the site (StartCta, FinalCta, BookCall, the Scout
// spotlight) — structure is cloned, brand color is not.
// `tagline` and `contactEmail` are new, optional — a future client site
// scaffolded from this starter kit can omit them and get the previous,
// simpler brand-block treatment.
interface LinkGroup {
  heading: string;
  links: { label: string; href: string }[];
}

interface Props {
  logoText?: string;
  tagline?: string;
  contactEmail?: string;
  groups?: LinkGroup[];
}

const { logoText = 'Logo', tagline = '', contactEmail = '', groups = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-logo">{logoText}</p>
        {tagline && <p class="footer-tagline">{tagline}</p>}
        {contactEmail && <a href={`mailto:${contactEmail}`} class="footer-email">{contactEmail}</a>}
      </div>

      <div class="footer-groups">
        {groups.map((group) => (
          <div class="footer-group">
            <h4>{group.heading}</h4>
            <ul>
              {group.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {year} {logoText}. All rights reserved.</p>
      {/* Standing rule for every site built from this starter kit — do not
          remove or make optional. See astro-dept SKILL.md Universal Standards. */}
      <p class="built-by">Website by <a href="https://scalekit.io" target="_blank" rel="noopener noreferrer">ScaleKit.io</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark-bg);
    color: var(--color-dark-fg);
    padding-block: var(--space-8) var(--space-6);
    font-family: var(--font-body);
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-7);
    margin-bottom: var(--space-7);
  }

  .footer-brand { max-width: 300px; flex-shrink: 0; }
  .footer-logo {
    font-size: 20px;
    font-weight: var(--font-weight-max);
    letter-spacing: -0.01em;
    color: var(--color-dark-fg);
    margin: 0 0 var(--space-3);
  }
  .footer-tagline {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-dark-text-mid);
    margin: 0 0 var(--space-3);
  }
  .footer-email {
    display: inline-block;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-dark-fg);
    text-decoration: none;
  }
  .footer-email:hover { color: var(--color-primary); }

  .footer-groups {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
  }
  .footer-group { min-width: 130px; }
  .footer-group h4 {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-dark-fg);
    margin: 0 0 var(--space-3);
  }
  .footer-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-group a {
    font-size: 15px;
    color: var(--color-dark-text-mid);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-group a:hover { color: var(--color-dark-fg); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-dark-border);
  }
  .footer-copyright {
    font-size: 13.5px;
    color: var(--color-dark-text-mid);
    margin: 0;
  }
  .built-by {
    font-size: 13.5px;
    color: var(--color-dark-text-mid);
    margin: 0;
  }
  .built-by a {
    color: var(--color-dark-text-mid);
    transition: color 0.15s;
  }
  .built-by a:hover { color: var(--color-dark-fg); }

  @media (max-width: 860px) {
    .footer-brand { max-width: none; width: 100%; }
  }
  @media (max-width: 560px) {
    .footer-groups { gap: var(--space-5); }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
