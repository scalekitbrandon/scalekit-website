---
// "How Scout Keyword-Optimizes Your Reviews" — feature row 2 of "How
// Scout Works" on /scout, matching ScoutGbpFeature.astro's rich
// two-column pattern (text + CTA, graphic; sides alternate via `order`).
// Structure cloned from the same reference landing page's review
// feature (business profile card + a "please leave a review" prompt +
// stacked review cards + capability badges) — colors, copy, and every
// name/quote in the graphic are ScaleKit's own invented placeholders,
// not carried over from the reference. Explicitly addresses keyword
// optimization (per direction) rather than just "more reviews" — the
// reference's own headline emphasized "Keyword Optimized" reviews and
// the first rewrite had dropped that angle. Same "Your Business Name"
// placeholder as the GBP scorecard section, reinforcing that both
// graphics show the same illustrative example business.
interface Review {
  name: string;
  daysAgo: string;
  quote: string;
}

interface Props {
  headline?: string;
  paragraph1?: string;
  paragraph2?: string;
  paragraph3?: string;
  paragraph4?: string;
  ctaLabel?: string;
  ctaHref?: string;
  businessName?: string;
  businessCategory?: string;
  rating?: string;
  reviews?: Review[];
  badges?: string[];
}

const {
  headline = 'Generate Reviews That Help You Rank',
  paragraph1 = 'Scout comes with a complete review management system designed to help you consistently generate more Google reviews without manually chasing customers.',
  paragraph2 = "Automatically request reviews after a job is completed, follow up with customers who haven't responded, and even generate personalized responses to new reviews on your behalf.",
  paragraph3 = 'Scout integrates with the tools your business already uses, turning review generation into an automated system that runs in the background.',
  paragraph4 = 'More reviews. More trust. Stronger local rankings. Without the manual follow-up.',
  ctaLabel = 'Get Started',
  ctaHref = '#book-call',
  businessName = 'Your Business Name',
  businessCategory = 'Local Service Business',
  rating = '4.9',
  reviews = [
    { name: 'Alex R.', daysAgo: '2 days ago', quote: 'Great experience from start to finish — highly recommend.' },
    { name: 'Jamie T.', daysAgo: '4 days ago', quote: 'Fast, professional, and easy to work with.' },
  ],
  badges = ['Keyword-Targeted Requests', 'Auto-Replies to Reviews'],
} = Astro.props;
---

<div class="reviews-feature">
  <div class="reviews-copy">
    <h3 class="reviews-headline">{headline}</h3>
    <p class="reviews-p">{paragraph1}</p>
    <p class="reviews-p">{paragraph2}</p>
    <p class="reviews-p">{paragraph3}</p>
    <p class="reviews-p">{paragraph4}</p>
    <a href={ctaHref} class="reviews-cta">
      {ctaLabel}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
    </a>
  </div>

  <div class="reviews-graphic">
    <div class="biz-card">
      <div class="biz-top">
        <div class="biz-logo">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 9l1-5h16l1 5"/><path d="M9 21v-4h6v4"/></svg>
        </div>
        <div class="biz-info">
          <p class="biz-name">{businessName}</p>
          <p class="biz-meta"><span class="biz-rating">{rating}</span> ★★★★★ · {businessCategory}</p>
          <p class="biz-status">Open</p>
        </div>
      </div>

      <div class="biz-tabs">
        <span class="tab is-active">Overview</span>
        <span class="tab">Reviews</span>
        <span class="tab">Photos</span>
      </div>

      <div class="biz-actions">
        <div class="action">
          <span class="action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92V19.92C22.0011 20.4853 21.7669 21.0251 21.3533 21.4132C20.9397 21.8013 20.3871 22.0067 19.823 21.98C16.7428 21.6227 13.7893 20.5805 11.19 18.93C8.77383 17.4233 6.72534 15.3748 5.21801 12.96C3.56226 10.3484 2.51997 7.3801 2.17001 4.28C2.1437 3.71754 2.34727 3.16776 2.73386 2.75523C3.12045 2.34269 3.65653 2.10713 4.22001 2.11H7.22001C8.10561 2.10083 8.86143 2.73545 9.00001 3.61C9.12662 4.48 9.34688 5.33422 9.65001 6.16C9.89284 6.78937 9.7418 7.50207 9.26001 7.98L8.09001 9.15C9.51356 11.6488 11.5712 13.7065 14.07 15.13L15.24 13.96C15.7179 13.4782 16.4306 13.3272 17.06 13.57C17.8858 13.8731 18.74 14.0934 19.61 14.22C20.4969 14.3598 21.1345 15.1302 21.12 16.02L22 16.92Z"/></svg></span>
          <span>Call</span>
        </div>
        <div class="action">
          <span class="action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21C12 21 19 15.5 19 10C19 5.58 15.87 2 12 2C8.13 2 5 5.58 5 10C5 15.5 12 21 12 21Z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <span>Directions</span>
        </div>
        <div class="action">
          <span class="action-icon"><svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
          <span>Message</span>
        </div>
      </div>
    </div>

    <div class="review-prompt">
      <span class="prompt-dot">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 4.8L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.2L12 3z"/></svg>
      </span>
      Please leave a review
    </div>

    <div class="review-stack">
      {reviews.map((r) => (
        <div class="review-card">
          <div class="review-top">
            <span class="avatar"></span>
            <div>
              <p class="review-name">{r.name}</p>
              <p class="review-meta">★★★★★ · {r.daysAgo}</p>
            </div>
          </div>
          <p class="review-quote">{r.quote}</p>
        </div>
      ))}
    </div>

    <div class="badge-stack">
      {badges.map((b) => (
        <div class="capability-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>
          {b}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .reviews-feature {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-8);
    align-items: center;
    margin-bottom: var(--space-8);
  }
  /* Alternates with ScoutGbpFeature above (text left / graphic right) —
     graphic moved visually first via `order`, not by reordering the
     markup, so reading/DOM order stays copy-then-graphic for a11y. */
  .reviews-graphic { order: -1; }

  .reviews-headline {
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .reviews-p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text-mid);
    margin: 0 0 var(--space-4);
    max-width: 480px;
  }
  .reviews-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 16px 30px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    margin-top: var(--space-2);
    transition: background 0.15s;
  }
  .reviews-cta:hover { background: var(--color-primary-hover); }
  .reviews-cta svg { width: 15px; height: 15px; }

  .reviews-graphic {
    position: relative;
    background-color: var(--color-bg-alt);
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    min-height: 460px;
  }

  .biz-card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: 0 20px 44px rgba(10, 10, 10, 0.14);
    max-width: 340px;
  }
  .biz-top { display: flex; align-items: flex-start; gap: var(--space-3); margin-bottom: var(--space-4); }
  .biz-logo {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .biz-logo svg { width: 22px; height: 22px; }
  .biz-name { font-size: 16px; font-weight: 800; color: var(--color-fg); margin: 0 0 4px; }
  .biz-meta { font-size: 12.5px; color: var(--color-text-mid); margin: 0 0 2px; }
  .biz-rating { font-weight: 800; color: var(--color-fg); }
  .biz-status { font-size: 12px; font-weight: 700; color: var(--color-success); margin: 0; }

  .biz-tabs {
    display: flex;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
    padding-bottom: 10px;
  }
  .tab { font-size: 12.5px; font-weight: 600; color: var(--color-text-light); }
  .tab.is-active { color: var(--color-fg); position: relative; }
  .tab.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -11px;
    width: 100%;
    height: 2px;
    background: var(--color-primary);
  }

  .biz-actions { display: flex; gap: var(--space-4); }
  .action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    font-weight: 700;
    color: var(--color-fg);
  }
  .action-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .action-icon svg { width: 15px; height: 15px; }

  .review-prompt {
    position: absolute;
    top: 28px;
    right: 28px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border-radius: var(--radius-pill);
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-fg);
    box-shadow: 0 10px 24px rgba(10, 10, 10, 0.12);
  }
  .prompt-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .prompt-dot svg { width: 10px; height: 10px; }

  .review-stack {
    position: absolute;
    right: 24px;
    bottom: 96px;
    width: 250px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .review-card {
    background: #ffffff;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    box-shadow: 0 16px 34px rgba(10, 10, 10, 0.14);
  }
  .review-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .review-name { font-size: 12.5px; font-weight: 800; color: var(--color-fg); margin: 0; }
  .review-meta { font-size: 10.5px; color: var(--color-text-light); margin: 2px 0 0; }
  .review-quote { font-size: 12px; line-height: 1.5; color: var(--color-text-mid); margin: 0; }

  .badge-stack {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .capability-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border-radius: var(--radius-pill);
    padding: 8px 14px;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-fg);
    box-shadow: 0 10px 24px rgba(10, 10, 10, 0.1);
  }
  .capability-badge svg { width: 15px; height: 15px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .reviews-feature { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .reviews-graphic { padding: var(--space-5); min-height: 520px; }
    .biz-card { max-width: 100%; }
    .review-stack { width: 210px; right: 14px; bottom: 90px; }
    .review-prompt { top: 18px; right: 14px; }
    .badge-stack { left: 14px; bottom: 14px; }
  }
</style>
