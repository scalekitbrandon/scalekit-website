---
// "Get Found" (Local SEO) service section. Same structural language as
// WebsitesFunnels.astro (eyebrow / 2-line headline with black-chip lime
// accent / subhead), followed by a 6-item deliverables grid instead of
// mockup cards, since this service isn't portfolio-driven.
interface Item {
  title: string;
  description: string;
  icon: string; // 'pin' | 'list' | 'doc' | 'star' | 'map' | 'gauge'
}

interface Props {
  eyebrow?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subheadline?: string;
  scoutBadge?: string;
  scoutHeadline?: string;
  scoutDescription?: string;
  scoutCtaLabel?: string;
  scoutCtaHref?: string;
  scoutCtaMicrocopy?: string;
  items?: Item[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Local SEO',
  headlineLine1 = 'Get Found',
  headlineLine2 = 'Before Your Competitors Do',
  subheadline = "Most customers never scroll past the map pack. If you're not showing up there, you're invisible — no matter how good the work you do is. We build the whole system that gets you found.",
  scoutBadge = 'ScaleKit Local SEO — Powered by Scout™',
  scoutHeadline = 'Meet Scout. Your AI Local SEO Agent.',
  scoutDescription = "Scout continuously optimizes your Google Business Profile, strengthens your local search presence, monitors ranking opportunities, and helps your business get discovered by more customers in your service area.",
  scoutCtaLabel = 'Meet Scout',
  scoutCtaHref = '/scout',
  scoutCtaMicrocopy = 'A standalone solution for your local SEO strategy — $399/month',
  items = [
    {
      icon: 'pin',
      title: 'Google Business Profile Optimization',
      description: 'A fully optimized listing so you show up in the map pack when it matters most.',
    },
    {
      icon: 'list',
      title: 'Local Citations & Directories',
      description: 'Consistent business info across every directory Google actually trusts.',
    },
    {
      icon: 'doc',
      title: 'On-Page SEO',
      description: 'Pages built and written to rank for the exact searches your customers use.',
    },
    {
      icon: 'star',
      title: 'Review Generation',
      description: 'A system that gets you more 5-star reviews, automatically.',
    },
    {
      icon: 'map',
      title: 'Service Area Pages',
      description: 'Dedicated pages for every city and neighborhood you serve.',
    },
    {
      icon: 'gauge',
      title: 'Technical SEO Health',
      description: 'Fast, mobile-friendly, and structured the way Google wants to see it.',
    },
  ],
  ctaLabel = 'Explore Local SEO',
  ctaHref = '/scout',
} = Astro.props;

const icons: Record<string, string> = {
  pin: '<path d="M12 21C12 21 19 15.5 19 10C19 5.58 15.87 2 12 2C8.13 2 5 5.58 5 10C5 15.5 12 21 12 21Z"/><circle cx="12" cy="10" r="3"/>',
  list: '<path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/>',
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h6"/>',
  star: '<path d="M12 2L14.5 8.5L21.5 9L16 13.5L17.5 20.5L12 16.5L6.5 20.5L8 13.5L2.5 9L9.5 8.5L12 2Z"/>',
  map: '<path d="M9 20l-6-3V4l6 3 6-3 6 3v13l-6-3-6 3z"/><path d="M9 4v13M15 7v13"/>',
  gauge: '<path d="M12 21a9 9 0 1 0-9-9"/><path d="M12 12l4-4"/><path d="M3 12h1M12 3v1M20 12h1"/>',
};
---

<section class="get-found" id="local-seo">
  <div class="inner">

    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">
        <span class="line">{headlineLine1}</span>
        <span class="line accent">{headlineLine2}</span>
      </h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="scout-spotlight">
      <span class="scout-badge">{scoutBadge}</span>
      <h3 class="scout-headline">{scoutHeadline}</h3>
      <p class="scout-desc">{scoutDescription}</p>
      <a href={scoutCtaHref} class="scout-cta">
        {scoutCtaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
      <p class="scout-microcopy">{scoutCtaMicrocopy}</p>
    </div>

    <div class="item-grid">
      {items.map((item) => (
        <div class="item">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
          </div>
          <h3 class="item-title">{item.title}</h3>
          <p class="item-desc">{item.description}</p>
        </div>
      ))}
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="cta">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .get-found {
    background: var(--color-bg-alt);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1200px; margin: 0 auto; }

  .header { max-width: 700px; margin: 0 0 var(--space-8); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
  }
  .headline .line { display: block; color: var(--color-fg); }
  .headline .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 4px 18px;
    border-radius: var(--radius-sm);
    margin-top: 10px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .scout-spotlight {
    position: relative;
    background: var(--color-dark-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    margin-bottom: var(--space-8);
    text-align: center;
    overflow: hidden;
  }
  .scout-spotlight::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(215, 255, 0, 0.16), transparent 60%);
    pointer-events: none;
  }
  .scout-badge {
    position: relative;
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    margin: 0 0 24px;
  }
  .scout-headline {
    position: relative;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-dark-fg);
    max-width: 640px;
    margin: 0 auto 18px;
  }
  .scout-desc {
    position: relative;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-dark-text-mid);
    max-width: 620px;
    margin: 0 auto 32px;
  }
  .scout-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 19px 40px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .scout-cta:hover { background: var(--color-primary-hover); }
  .scout-cta svg { width: 17px; height: 17px; flex-shrink: 0; }
  .scout-microcopy {
    position: relative;
    font-size: 13px;
    color: var(--color-dark-text-mid);
    margin: 16px 0 0;
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(215, 255, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  .icon-wrap svg { width: 22px; height: 22px; color: var(--color-fg); }
  .item-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin: 0 0 8px;
  }
  .item-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-mid);
    margin: 0;
  }

  .cta-row {
    text-align: center;
    margin-top: var(--space-8);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--color-fg); color: #ffffff; }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .item-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .get-found { padding: var(--space-7) var(--space-5); }
    .scout-spotlight { padding: var(--space-7) var(--space-5); }
    .scout-cta { width: 100%; }
    .item-grid { grid-template-columns: 1fr; }
  }
</style>
