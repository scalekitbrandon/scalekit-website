---
// Section 7 — Trust Strip. Real, approved copy per copy.md. Deliberately
// quiet/lower-key than surrounding sections — no eyebrow/headline.
interface Item {
  title: string;
  description: string;
}

interface Props {
  items?: Item[];
}

const {
  items = [
    { title: '7–14 Day Launch', description: 'Your system live fast, not "eventually."' },
    { title: 'One Team, Start to Finish', description: 'Not a bundle of connected tools.' },
    { title: 'Built Around Your Business', description: 'Not a generic template. Shaped around how you actually work.' },
    { title: 'No Wasted Spend', description: "You only pay for the stage you're actually ready for." },
    { title: 'Built From Real Experience', description: 'Not theory. The problem this fixes was lived first, then solved.' },
  ],
} = Astro.props;
---

<section class="trust-strip">
  <div class="inner">
    {items.map((item) => (
      <div class="item">
        <h3 class="title">{item.title}</h3>
        <p class="desc">{item.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-strip {
    background: #ffffff;
    padding: var(--space-6) var(--space-6);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-5);
  }
  .item { text-align: center; }
  .title {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.005em;
    color: var(--color-fg);
    margin: 0 0 4px;
  }
  .desc {
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-text-light);
    margin: 0;
  }

  @media (max-width: 900px) {
    .inner { grid-template-columns: repeat(3, 1fr); row-gap: var(--space-6); }
  }
  @media (max-width: 560px) {
    .inner { grid-template-columns: 1fr 1fr; }
  }
</style>
