---
// Faithful port of funnel-library/clients/scale-kit-home-page/section-01-nav.html,
// restructured per site-structure audit: original links (Capabilities,
// Case Studies, Pricing, About) pointed to anchors that don't exist on the
// rebuilt page. Now: Home, a Services dropdown (the 6 real service
// sections), How We Work, Who We Work With — plus a working CTA.
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  homeHref?: string;
  services?: NavLink[];
  // Feature pages shown under a Features dropdown. "Features" itself
  // stays a real link to /features/; any plain "Features" entry passed in
  // `links` is dropped so it isn't rendered twice.
  features?: NavLink[];
  // Industry pages shown under the "Who We Work With" dropdown, which
  // replaces any plain "Who We Work With" entry passed in `links`.
  industries?: NavLink[];
  links?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  homeHref = '#home',
  services = [
    { label: 'Websites & Funnels', href: '#websites-funnels' },
    { label: 'Local SEO', href: '/scout/' },
    { label: 'Google & Meta Ads', href: '/services/ads/' },
    { label: 'CRM & Automation', href: '/services/automation/' },
    { label: 'Reactivation', href: '/services/reactivation/' },
    { label: 'AI Agents & Solutions', href: '/services/ai-agents/' },
  ],
  features = [
    { label: 'All Features', href: '/features/' },
    { label: 'Missed Call Text Back', href: '/services/missed-call-text-back/' },
    { label: 'Lead Follow-Up Automation', href: '/services/lead-follow-up-automation/' },
    { label: 'Google Review Automation', href: '/services/google-review-automation/' },
    { label: 'Google Business Profile Management', href: '/services/google-business-profile-management/' },
  ],
  industries = [
    { label: 'All Industries', href: '/#built-for' },
    { label: 'Roofing', href: '/industries/roofing/' },
    { label: 'Restoration', href: '/industries/restoration/' },
    { label: 'Landscaping', href: '/industries/landscaping/' },
    { label: 'Home Services', href: '/industries/home-services/' },
    { label: 'Public Adjusters', href: '/industries/public-adjusters/' },
    { label: 'Therapists', href: '/industries/therapists/' },
    { label: 'Travel Advisors', href: '/industries/travel-advisors/' },
    { label: 'Coaches & Consultants', href: '/industries/agency-consultant/' },
  ],
  links = [
    { label: 'Features', href: '/features' },
    { label: 'How We Work', href: '#process' },
    { label: 'Who We Work With', href: '#built-for' },
    { label: 'Pricing', href: '/pricing' },
  ],
  ctaLabel = 'Book Your Free Strategy Call',
  ctaHref = '#book-call',
} = Astro.props;

// Labels that render as dropdowns in place of a plain link, keeping the
// position each page's `links` order gives them.
const menus: Record<string, { href: string; items: NavLink[] }> = {
  Features: { href: '/features/', items: features },
  'Who We Work With': { href: '/#built-for', items: industries },
};
---

<header class="site-header">
  <div class="header-inner">
    <a href={homeHref} class="logo">
      <span class="logo-text">Scale</span><span class="logo-badge">Kit</span>
    </a>

    <div class="nav-links" id="navLinks">
      <a href={homeHref} class="nav-link">Home</a>

      <div class="dropdown">
        <button type="button" class="nav-link dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          Services
          <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="dropdown-menu">
          {services.map((s) => (
            <a href={s.href} class="dropdown-link">{s.label}</a>
          ))}
        </div>
      </div>

      {links.map((link) => {
        const menu = menus[link.label];
        return menu ? (
          <div class="dropdown">
            <a href={menu.href} class="nav-link dropdown-trigger" aria-haspopup="true">
              {link.label}
              <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="dropdown-menu">
              {menu.items.map((item) => (
                <a href={item.href} class="dropdown-link">{item.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={link.href} class="nav-link">{link.label}</a>
        );
      })}

      <!-- Mobile-only services list (no dropdown at this width) -->
      <div class="mobile-services">
        <p class="mobile-services-label">Services</p>
        {services.map((s) => (
          <a href={s.href} class="nav-link mobile-service-link">{s.label}</a>
        ))}
        <p class="mobile-services-label">Features</p>
        {features.map((f) => (
          <a href={f.href} class="nav-link mobile-service-link">{f.label}</a>
        ))}
        <p class="mobile-services-label">Who We Work With</p>
        {industries.map((i) => (
          <a href={i.href} class="nav-link mobile-service-link">{i.label}</a>
        ))}
      </div>

      <a href={ctaHref} class="header-cta cta-mobile">{ctaLabel}</a>
    </div>

    <a href={ctaHref} class="header-cta cta-desktop">{ctaLabel}</a>

    <button type="button" class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    background-color: var(--color-bg);
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .header-inner {
    max-width: var(--container-max-nav);
    margin: 0 auto;
    padding: 0 var(--space-5);
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }
  .logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    font-size: 20px;
    font-weight: var(--font-weight-max);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .logo-text { color: var(--color-fg); }
  .logo-badge {
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    margin-left: 3px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 16.15px;
    font-weight: var(--font-weight-button);
    color: var(--color-fg);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.15s;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }
  .nav-link:hover { opacity: 1; }

  /* Services dropdown (desktop) */
  .dropdown { position: relative; }
  .dropdown-trigger svg { width: 10px; height: 10px; transition: transform 0.15s; }
  .dropdown:hover .dropdown-trigger svg,
  .dropdown:focus-within .dropdown-trigger svg,
  .dropdown-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .dropdown-menu {
    /* Flush against the trigger (top: 100%, no gap) with the visual
       breathing room added as padding-top instead of a position offset —
       a positioned gap creates a dead zone the cursor has to cross where
       it's hovering neither the trigger nor the menu, which (combined
       with pointer-events:none below) closes the menu before you can
       reach it. Keeping pointer-events:auto at all times means the box
       stays hit-testable across that transition instead of needing the
       mouse to "already be hovering" a target that only becomes
       hoverable once hovered. */
    position: absolute;
    top: 100%;
    left: 50%;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    padding: 14px 8px 8px;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    /* Closed menu is hidden from the pointer too: an invisible but
       hit-testable box sat under the trigger and opened the menu when the
       cursor merely passed over the page below it. The menu opens only
       from the trigger, then stays open while the cursor moves into it
       (it's flush with the trigger, so there's no gap to cross).
       Visibility flips after the fade on close, immediately on open. */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%) translateY(-6px);
    transition: opacity 0.15s, transform 0.15s, visibility 0s linear 0.15s;
  }
  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu,
  .dropdown-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    transition-delay: 0s;
  }
  .dropdown-link {
    padding: 10px 14px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .dropdown-link:hover { background: var(--color-bg-alt); }

  .mobile-services { display: none; }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 22px;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-size: 14px;
    font-weight: var(--font-weight-button);
    letter-spacing: 0.01em;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .header-cta:hover { background: var(--color-primary-hover); }
  .cta-mobile { display: none; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }
  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-fg);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .nav-toggle.is-open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-2) var(--space-6) var(--space-5);
      max-height: calc(100vh - 64px);
      overflow-y: auto;
    }
    .nav-links.is-open { display: flex; }
    .nav-link { width: 100%; padding: 12px 0; opacity: 1; border-bottom: 1px solid var(--color-border); }

    /* Hide desktop dropdown trigger/menu on mobile, show flat list instead */
    .dropdown { display: none; }
    .mobile-services { display: block; width: 100%; }
    .mobile-services-label {
      margin: 14px 0 4px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-light);
    }
    .mobile-service-link { padding-left: var(--space-3); font-size: 15px; }

    .cta-desktop { display: none; }
    .nav-links.is-open .cta-mobile {
      display: inline-flex;
      margin-top: var(--space-2);
      width: 100%;
    }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const navToggle = document.getElementById('navToggle');
  const navLinks = document.getElementById('navLinks');
  if (navToggle && navLinks) {
    navToggle.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('is-open');
      navToggle.classList.toggle('is-open', isOpen);
      navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    // Close the mobile menu once a visitor actually picks a link, instead
    // of leaving it open until they manually tap the hamburger again.
    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('is-open');
        navToggle.classList.remove('is-open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Click-to-toggle fallback for the Services dropdown (hover already
  // works via CSS; this adds touch support). The Features trigger is a real
  // link to /features/, so it navigates on click instead.
  document.querySelectorAll('.dropdown').forEach((dropdown) => {
    const trigger = dropdown.querySelector('button.dropdown-trigger');
    const menu = dropdown.querySelector('.dropdown-menu');
    if (!trigger || !menu) return;
    trigger.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
