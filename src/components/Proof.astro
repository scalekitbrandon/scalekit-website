---
// Section 8 — Proof / "See It In Action". Real, approved copy per copy.md.
// FLAG (per copy.md): ScaleKit has no client logos, stats, or case studies
// yet (first-10-clients stage). This section intentionally leads with the
// product itself rather than invented results or fabricated social proof.
// The 3 "screenshots" below are honest placeholders, not fake mockups —
// swap in real product screenshots via astro:assets <Image /> the moment
// they exist. Do NOT fill this with placeholder numbers/stats before then.
interface Screenshot {
  label: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  screenshots?: Screenshot[];
  ctaLabel?: string;
  ctaMicrocopy?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'See It In Action',
  headline = "This Isn't Software You Have To Figure Out",
  subheadline = "You don't get a login and a tutorial video. You get a system that's already running before your first customer calls.",
  screenshots = [
    { label: 'Dashboard View' },
    { label: 'Automation Workflow Builder' },
    { label: 'Mobile Lead Notification' },
  ],
  ctaLabel = 'Book Your Free Strategy Call',
  ctaMicrocopy = 'See your actual system mapped out on the call — not a generic demo.',
  ctaHref = '#book-call',
} = Astro.props;
---

<section class="proof" id="proof">
  <div class="inner">

    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="screenshot-grid">
      {screenshots.map((s) => (
        <div class="screenshot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 8h20"/>
            <circle cx="5" cy="6" r="0.5" fill="currentColor"/>
            <circle cx="7" cy="6" r="0.5" fill="currentColor"/>
          </svg>
          <span class="label">{s.label}</span>
          <span class="sub-label">Coming Soon</span>
        </div>
      ))}
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="cta">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
      <p class="cta-micro">{ctaMicrocopy}</p>
    </div>

  </div>
</section>

<style>
  .proof {
    background: var(--color-bg);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1100px; margin: 0 auto; }

  .header { max-width: 640px; margin: 0 auto var(--space-8); text-align: center; }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .screenshot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .screenshot {
    aspect-ratio: 16 / 10;
    background: var(--color-bg-alt);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--color-text-light);
  }
  .screenshot svg { width: 32px; height: 32px; opacity: 0.5; }
  .label {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text-mid);
    text-align: center;
    padding: 0 var(--space-4);
  }
  .sub-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-light);
  }

  .cta-row { text-align: center; }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--color-fg); color: #ffffff; }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }
  .cta-micro {
    font-size: 13px;
    color: var(--color-text-light);
    margin: var(--space-3) 0 0;
  }

  @media (max-width: 780px) {
    .screenshot-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .proof { padding: var(--space-7) var(--space-5); }
  }
</style>
