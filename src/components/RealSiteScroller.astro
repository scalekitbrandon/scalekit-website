---
// A horizontal-scroll strip of real, live ScaleKit website builds, each
// framed in a browser-chrome mockup (traffic-light dots + address bar).
// Meant to sit inline inside another section's content column (e.g.
// ContentBlocks' "Website" block), not as its own full-bleed section —
// so it has no outer section/background of its own.
// Each card embeds the real page in an iframe rather than a static
// screenshot: hovering and scrolling moves through that page's actual
// full homepage, not just a cropped image. `src` is either an external
// live domain (Brooklyn Therapy Services) or one of this project's own
// unlinked /preview/ routes for sample templates that don't have a
// public URL of their own (see src/pages/preview/).
interface SampleItem {
  label: string;
  addressLabel: string;
  src: string;
  href: string;
}

interface Props {
  items: SampleItem[];
}

const { items } = Astro.props;
---

<div class="site-scroller">
  <div class="site-scroller-inner">
  <div class="scroller-row">
    <button type="button" class="scroller-arrow prev" data-scroller-prev aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="scroller-track" data-scroller-track>
      {items.map((item) => (
        <div class="site-card">
          <div class="browser-chrome">
            <div class="dots"><span></span><span></span><span></span></div>
            <a class="address-pill" href={item.href} target="_blank" rel="noopener noreferrer">{item.addressLabel}</a>
          </div>
          <div class="site-thumb">
            <iframe src={item.src} title={`${item.label} — scroll to explore`} loading="lazy"></iframe>
          </div>
        </div>
      ))}
    </div>

    <button type="button" class="scroller-arrow next" data-scroller-next aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
  </div>
</div>

<style>
  .site-scroller {
    /* Breaks out of the narrow ~780px text column its parent block
       keeps everything else inside, so these cards can be as large as
       a real full-width showcase instead of being capped by the
       article-width column — that's what was making them read "too
       small" even after widening them to 50% of that narrow column. */
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: var(--space-6) var(--space-6) 0;
    margin-top: var(--space-6);
    margin-bottom: 0;
    box-sizing: border-box;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .site-scroller-inner { max-width: 1200px; margin: 0 auto; }

  .scroller-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .scroller-arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: #ffffff;
    color: var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .scroller-arrow svg { width: 17px; height: 17px; }
  .scroller-arrow:hover { background: var(--color-primary); border-color: var(--color-primary); }
  .scroller-arrow:disabled { opacity: 0.35; cursor: default; }
  .scroller-arrow:disabled:hover { background: #ffffff; border-color: var(--color-border); }

  .scroller-track {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scroller-track::-webkit-scrollbar { display: none; }

  .site-card {
    flex: 0 0 calc(50% - var(--space-4) / 2);
    min-width: 280px;
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.08);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(10, 10, 10, 0.16);
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: #f0eee6;
  }
  .dots { display: flex; gap: 6px; flex-shrink: 0; }
  .dots span { width: 9px; height: 9px; border-radius: 50%; background: rgba(10, 10, 10, 0.25); }
  .address-pill {
    min-width: 0;
    font-size: 13px;
    font-weight: 400;
    color: var(--color-text-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
  }
  .address-pill:hover { color: var(--color-text-mid); }

  .site-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 1440 / 900;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  .site-thumb iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1440px;
    height: 900px;
    border: 0;
    transform-origin: top left;
    /* Combined scale (real desktop layout, not a reflowed mobile one)
       + vertical offset (auto-scroll on hover) — both written by the
       script below. */
  }

  @media (max-width: 560px) {
    .site-scroller { padding: var(--space-5) var(--space-4) 0; }
    .scroller-row { gap: var(--space-2); }
    .scroller-arrow { width: 34px; height: 34px; }
    .scroller-arrow svg { width: 15px; height: 15px; }
    .site-card { flex: 0 0 94%; }
  }
</style>

<script>
  const track = document.querySelector('[data-scroller-track]');
  const prevBtn = document.querySelector('[data-scroller-prev]');
  const nextBtn = document.querySelector('[data-scroller-next]');

  function scrollStep() {
    const card = track?.querySelector('.site-card');
    const gap = 16;
    return card ? card.getBoundingClientRect().width + gap : 340;
  }

  function updateArrows() {
    if (!track || !(prevBtn instanceof HTMLButtonElement) || !(nextBtn instanceof HTMLButtonElement)) return;
    const maxScroll = track.scrollWidth - track.clientWidth - 2;
    prevBtn.disabled = track.scrollLeft <= 0;
    nextBtn.disabled = track.scrollLeft >= maxScroll;
  }

  prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -scrollStep(), behavior: 'smooth' }));
  nextBtn?.addEventListener('click', () => track?.scrollBy({ left: scrollStep(), behavior: 'smooth' }));
  track?.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();

  // Each card's iframe is scaled down to the card's real rendered width
  // (so the site shows its actual desktop layout, not a reflowed mobile
  // one) AND, while hovered, translated upward to auto-scroll through
  // the page. Both live in one transform, applied together below —
  // this works even for the cross-origin Brooklyn Therapy Services card
  // because it only ever repositions our own iframe element from the
  // parent page; it never reaches into the iframe's own document (which
  // cross-origin JS can't do anyway).
  const VIEWPORT_HEIGHT = 900; // matches the iframe's aspect-ratio crop
  const SCROLL_DURATION = 7000; // ms to reach the bottom while hovered
  const RESET_DURATION = 450; // ms to snap back on mouseleave
  const animationIds = new WeakMap();

  function applyTransform(iframe: HTMLIFrameElement) {
    const scale = parseFloat(iframe.dataset.scale || '1');
    const offset = parseFloat(iframe.dataset.offset || '0');
    iframe.style.transform = `scale(${scale}) translateY(${-offset}px)`;
  }

  function scaleThumbs() {
    document.querySelectorAll('.site-thumb').forEach((thumb) => {
      const iframe = thumb.querySelector('iframe');
      if (!(iframe instanceof HTMLIFrameElement)) return;
      iframe.dataset.scale = String(thumb.clientWidth / 1440);
      applyTransform(iframe);
    });
  }
  window.addEventListener('resize', scaleThumbs);
  scaleThumbs();

  function animateOffset(iframe: HTMLIFrameElement, toOffset: number, duration: number) {
    const existing = animationIds.get(iframe);
    if (existing) cancelAnimationFrame(existing);

    const fromOffset = parseFloat(iframe.dataset.offset || '0');
    const start = performance.now();

    function step(now: number) {
      const t = Math.min((now - start) / duration, 1);
      iframe.dataset.offset = String(fromOffset + (toOffset - fromOffset) * t);
      applyTransform(iframe);
      if (t < 1) {
        animationIds.set(iframe, requestAnimationFrame(step));
      } else {
        animationIds.delete(iframe);
      }
    }
    animationIds.set(iframe, requestAnimationFrame(step));
  }

  document.querySelectorAll('.site-card').forEach((card) => {
    const iframe = card.querySelector('iframe');
    if (!(iframe instanceof HTMLIFrameElement)) return;
    const nativeHeight = parseFloat(iframe.getAttribute('height') || String(VIEWPORT_HEIGHT));
    const maxOffset = Math.max(nativeHeight - VIEWPORT_HEIGHT, 0);

    card.addEventListener('mouseenter', () => animateOffset(iframe, maxOffset, SCROLL_DURATION));
    card.addEventListener('mouseleave', () => animateOffset(iframe, 0, RESET_DURATION));
  });
</script>
