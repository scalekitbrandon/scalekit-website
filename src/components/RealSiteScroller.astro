---
// A horizontal-scroll strip of real, live ScaleKit website builds, each
// framed in a browser-chrome mockup (traffic-light dots + address bar) —
// sized per Brandon's reference screenshot (large cards, two visible at
// once on desktop), not the small rounded-thumbnail cards WebsitesFunnels
// uses on the homepage. Meant to sit directly under a page's "Website"
// content block as real proof, not as its own separate pitch section.
// Screenshots are real captures (Playwright, 1440x900, top of page) of
// each site's own live URL — see public/images/site-showcase/ — never a
// mockup or AI-generated image.
interface SampleItem {
  label: string;
  addressLabel: string;
  image: string;
  href?: string;
}

interface Props {
  items: SampleItem[];
}

const { items } = Astro.props;
---

<section class="site-scroller">
  <div class="site-scroller-inner">
    <div class="scroller-row">
      <button type="button" class="scroller-arrow prev" data-scroller-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="scroller-track" data-scroller-track>
        {items.map((item) => {
          const Tag = item.href ? 'a' : 'div';
          const linkProps = item.href ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' } : {};
          return (
            <Tag class="site-card" {...linkProps}>
              <div class="browser-chrome">
                <div class="dots"><span></span><span></span><span></span></div>
                <div class="address-pill">{item.addressLabel}</div>
              </div>
              <div class="site-thumb">
                <img src={item.image} alt={`${item.label} website`} loading="lazy" />
              </div>
            </Tag>
          );
        })}
      </div>

      <button type="button" class="scroller-arrow next" data-scroller-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .site-scroller {
    background: var(--color-bg);
    padding: var(--space-6) var(--space-6) var(--space-8);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .site-scroller-inner { max-width: 1200px; margin: 0 auto; }

  .scroller-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .scroller-arrow {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: #ffffff;
    color: var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .scroller-arrow svg { width: 19px; height: 19px; }
  .scroller-arrow:hover { background: var(--color-primary); border-color: var(--color-primary); }
  .scroller-arrow:disabled { opacity: 0.35; cursor: default; }
  .scroller-arrow:disabled:hover { background: #ffffff; border-color: var(--color-border); }

  .scroller-track {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scroller-track::-webkit-scrollbar { display: none; }

  .site-card {
    flex: 0 0 calc(50% - var(--space-5) / 2);
    scroll-snap-align: start;
    min-width: 320px;
    display: block;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 20px 40px rgba(10, 10, 10, 0.08);
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .site-card:hover { box-shadow: 0 24px 48px rgba(10, 10, 10, 0.12); transform: translateY(-2px); }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }
  .dots { display: flex; gap: 6px; flex-shrink: 0; }
  .dots span { width: 9px; height: 9px; border-radius: 50%; background: var(--color-border); }
  .address-pill {
    flex: 1;
    min-width: 0;
    padding: 6px 14px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-text-mid);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .site-thumb {
    aspect-ratio: 1440 / 900;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  .site-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  @media (max-width: 860px) {
    .site-card { flex-basis: 86%; min-width: 0; }
  }
  @media (max-width: 560px) {
    .site-scroller { padding: var(--space-5) var(--space-5) var(--space-7); }
    .scroller-row { gap: var(--space-3); }
    .scroller-arrow { width: 38px; height: 38px; }
    .scroller-arrow svg { width: 16px; height: 16px; }
  }
</style>

<script>
  const track = document.querySelector('[data-scroller-track]');
  const prevBtn = document.querySelector('[data-scroller-prev]');
  const nextBtn = document.querySelector('[data-scroller-next]');

  function scrollStep() {
    const card = track?.querySelector('.site-card');
    const gap = 24;
    return card ? card.getBoundingClientRect().width + gap : 400;
  }

  function updateArrows() {
    if (!track || !(prevBtn instanceof HTMLButtonElement) || !(nextBtn instanceof HTMLButtonElement)) return;
    const maxScroll = track.scrollWidth - track.clientWidth - 2;
    prevBtn.disabled = track.scrollLeft <= 0;
    nextBtn.disabled = track.scrollLeft >= maxScroll;
  }

  prevBtn?.addEventListener('click', () => track?.scrollBy({ left: -scrollStep(), behavior: 'smooth' }));
  nextBtn?.addEventListener('click', () => track?.scrollBy({ left: scrollStep(), behavior: 'smooth' }));
  track?.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();
</script>
