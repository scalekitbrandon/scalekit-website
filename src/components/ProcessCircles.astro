---
// "How It Works" — circle-and-dashed-line variant, used on the 6
// Websites & Funnels /services/<industry> pages in place of the
// default Process.astro (which stays as-is everywhere else, including
// the homepage). Structure cloned from a reference 3-step "what working
// with us looks like" section (numbered circles connected by a dashed
// line, title, description below) — colors and copy are ScaleKit's
// own, not carried over from the reference. Durations (20 mins, 7–14
// days) were dropped from step titles per explicit request, so every
// step's title sits at the same height and descriptions all start on
// the same row regardless of title length.
// Now 4 steps, not 3 — step 2 ("Share Your Vision") absorbs what used
// to be a separate ShareInspiration.astro section (deleted), since that
// content chronologically belongs right after the strategy call, not
// bolted on after the whole process as its own section. Step 3
// deliberately does NOT claim a mid-build draft-review/revision
// checkpoint — that would be a real offer-structure claim, and it
// hasn't been confirmed as real. Add it if/when Brandon confirms it.
interface Step {
  number: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  steps?: Step[];
  // Optional CTA row below the steps — off by default (the industry
  // pages that originated this component don't use one), opt in by
  // passing ctaLabel (e.g. the homepage's own real "Book Your Free
  // Strategy Call" / "Free. 20 minutes. No pressure." copy).
  ctaLabel?: string;
  ctaHref?: string;
  ctaMicrocopy?: string;
}

const {
  eyebrow = 'How We Work',
  headline = "Here's What Working With Us Looks Like",
  ctaLabel,
  ctaHref = '#book-call',
  ctaMicrocopy,
  steps = [
    {
      number: '1',
      title: 'Strategy Call',
      description: "We learn your business. We know what converts. We combine the two to build a website designed around how your customers actually make decisions.",
    },
    {
      number: '2',
      title: 'Share Your Vision',
      description: "If you have inspiration or ideas, send it our way. If not, no problem — we'll handle the creative direction.",
    },
    {
      number: '3',
      title: 'We Build Your Site',
      description: "Give us the basics about your business and we'll take it from there—building your website and marketing system with minimal work on your end.",
    },
    {
      number: '4',
      title: 'Launch Call',
      description: 'We walk you through everything, answer every question, and make sure you know exactly how it works.',
    },
  ],
} = Astro.props;
---

<section class="process-circles" id="process">
  <div class="inner">
    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
    </div>

    <div class="step-row">
      {steps.map((step, i) => (
        <div class="step">
          <div class="circle-row">
            <span class="circle">{step.number}</span>
            {i < steps.length - 1 && <span class="dashed-line" aria-hidden="true"></span>}
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </div>
      ))}
    </div>

    {ctaLabel && (
      <div class="cta-row">
        <a href={ctaHref} class="cta">
          {ctaLabel}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        </a>
        {ctaMicrocopy && <p class="cta-micro">{ctaMicrocopy}</p>}
      </div>
    )}
  </div>
</section>

<style>
  .process-circles {
    background: #ffffff;
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1000px; margin: 0 auto; }

  .header { text-align: center; margin: 0 auto var(--space-8); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    margin: 0;
  }

  .step-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }
  .step { text-align: center; }

  .circle-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--space-5);
  }
  .circle {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: var(--font-weight-max);
  }
  .dashed-line {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateY(-50%);
    width: calc(100% + var(--space-5) - 32px);
    height: 0;
    border-top: 2.5px dashed var(--color-border);
  }

  .step-title {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin: 0 0 12px;
  }
  .step-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
    max-width: 280px;
    margin-inline: auto;
  }

  .cta-row { text-align: center; margin-top: var(--space-8); }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
  }
  .cta:hover { background: var(--color-primary-hover); border-color: var(--color-primary-hover); }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }
  .cta-micro {
    font-size: 13px;
    color: var(--color-text-light);
    margin: var(--space-3) 0 0;
  }

  @media (max-width: 760px) {
    .step-row { grid-template-columns: 1fr; gap: var(--space-7); }
    .dashed-line { display: none; }
  }
  @media (max-width: 560px) {
    .process-circles { padding: var(--space-7) var(--space-5); }
  }
</style>
