---
// Hero for /pricing. Same structural language as ScoutHero (pill eyebrow,
// centered headline/sub, lime-grid bg) but without the proof collage or
// CTA buttons — this hero's job is just to set the "pay for what you
// need" framing and state real, confirmed billing terms as badges below
// the subhead. Only confirmed terms go in `badges` (month-to-month, no
// contract) — do not add exclusivity/notice-period/minimum-term claims
// without explicit confirmation, see decisions.md Section 9.
interface BadgeItem {
  text: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  badges?: BadgeItem[];
}

const {
  eyebrow = 'Pricing',
  headline = 'Pricing Built Around What Your Business Actually Needs',
  subheadline = 'Start with one service or combine multiple systems. ScaleKit lets you build around what your business needs today—and add more as you grow.',
  badges = [
    { text: 'Month-to-month' },
    { text: 'No long-term contracts' },
    { text: 'Free Strategy Call — No CC Required' },
    { text: 'Cancel Anytime' },
  ],
} = Astro.props;
---

<section class="pricing-hero" id="home">
  <div class="inner">
    <p class="eyebrow-label">{eyebrow}</p>
    <h1 class="headline">{headline}</h1>
    <p class="sub">{subheadline}</p>

    <ul class="badges">
      {badges.map((b) => (
        <li>
          <span class="check">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
          {b.text}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pricing-hero {
    background-color: var(--color-bg);
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
    padding: var(--space-hero-top) var(--space-6) var(--space-8);
    text-align: center;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .eyebrow-label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(34px, 4.6vw, 54px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--color-fg);
    margin: 0 0 var(--space-5);
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    max-width: 600px;
    margin: 0 auto var(--space-6);
  }

  .badges {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .badges li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 8px 18px 8px 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-fg);
  }
  .check {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .check svg { width: 10px; height: 10px; }

  @media (max-width: 560px) {
    .pricing-hero { padding: 140px 20px 56px; }
  }
</style>
