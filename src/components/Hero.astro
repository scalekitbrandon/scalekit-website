---
// Faithful port of funnel-library/clients/scale-kit-home-page/section-02-hero.html
// Single centered column: pill eyebrow, 2-line headline, subhead, checklist,
// primary/secondary CTAs. Sits directly under the fixed Header.
interface ChecklistItem {
  text: string;
}

interface Props {
  eyebrow?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subheadline?: string;
  checklist?: ChecklistItem[];
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
}

const {
  eyebrow = 'Growth & Automation Agency for Service Businesses',
  headlineLine1 = 'Everything Your Business',
  headlineLine2 = 'Needs to Grow',
  subheadline = 'ScaleKit helps service businesses get found, convert more leads, automate the work that slows them down, generate repeat business, and scale with AI and Automations—all with one growth partner.',
  checklist = [
    { text: 'Websites & Funnels Built to Convert' },
    { text: 'Rank Higher on Google Maps & AI Search' },
    { text: 'Automated Follow-Up So You Never Miss a Lead' },
    { text: 'Meta & Google Ads That Drive Qualified Leads' },
    { text: 'AI Agents & Automations So You Can Effortlessly Scale' },
  ],
  primaryCtaLabel = 'Book Your Free Strategy Call',
  primaryCtaHref = '#book-call',
} = Astro.props;
---

<section class="hero" id="home">
  <div class="hero-inner">

    <div class="eyebrow">
      <span class="eyebrow-dot"></span>
      <span class="eyebrow-text">{eyebrow}</span>
    </div>

    <h1 class="hero-h1">
      <span class="line">{headlineLine1}</span>
      <span class="line">{headlineLine2}</span>
    </h1>

    <p class="hero-sub">{subheadline}</p>

    <ul class="checklist">
      {checklist.map((item) => (
        <li>
          <span class="check">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-fg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
          {item.text}
        </li>
      ))}
    </ul>

    <div class="hero-ctas">
      <a href={primaryCtaHref} class="btn btn-primary">
        {primaryCtaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .hero {
    background-color: var(--color-bg);
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
    padding: 171.1px 24px 88.3px;
    text-align: center;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 7px 16px 7px 12px;
    margin: 0 0 25.8px;
  }
  .eyebrow-dot {
    width: 7px;
    height: 7px;
    background: var(--color-primary);
    border-radius: 50%;
    outline: 2px solid var(--color-primary-outline);
    flex-shrink: 0;
  }
  .eyebrow-text {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-mid);
  }
  .hero-h1 {
    font-size: clamp(38px, 5.4vw, 58px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 22.1px;
  }
  .hero-h1 .line {
    display: block;
    color: var(--color-fg);
  }
  .hero-sub {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.6;
    color: #333333;
    max-width: 620px;
    margin: 0 auto 29.4px;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 14.7px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 17px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .btn svg { width: 15px; height: 15px; flex-shrink: 0; }
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    border: 2px solid var(--color-primary);
  }
  .btn-primary:hover { background: var(--color-primary-hover); border-color: var(--color-primary-hover); }

  .checklist {
    list-style: none;
    margin: 0 0 29.4px;
    padding: 0;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    text-align: left;
  }
  .checklist li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 19px;
    font-weight: 700;
    color: var(--color-fg);
  }
  .check {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-fg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .check svg { width: 14px; height: 14px; }

  @media (max-width: 640px) {
    .hero { padding: 139.8px 20px 58.9px; }
    .checklist li { font-size: 17px; }
  }
</style>
