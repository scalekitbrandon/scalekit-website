---
// Section 6 — Built For / Verticals Grid. Real, approved copy per copy.md.
// No CTA — matches the source clone's "breadth signal, not a conversion
// moment" intent.
interface Vertical {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  verticals?: Vertical[];
}

// Pills link to a real dedicated /services/<industry> page where one
// exists (naming doesn't need to match exactly — "Therapists" ->
// therapists-advisors, "Home Service Teams" -> home-services,
// "Coaches & Consultants" -> agency-consultant, per explicit direction).
// "General Contractors" is deliberately NOT mapped to /services/
// restoration — that page is specifically framed around insurance-claim
// disaster restoration, a different audience than general contracting,
// so force-matching them would be misleading. Every vertical without a
// real dedicated page today falls back to /features until it gets its
// own page later, one at a time (matches the site's existing build
// pattern — see decisions.md Section 9).
const FEATURES_FALLBACK = '/features';

const {
  eyebrow = 'Who We Work With',
  headline = 'Built For Service Businesses And The People Who Run Them.',
  subheadline = 'From solo operators to growing teams — if leads, follow-up, and scattered systems are slowing you down, this is built for you.',
  verticals = [
    { label: 'Public Adjusters', href: '/services/public-adjusters' },
    { label: 'Real Estate Agents', href: FEATURES_FALLBACK },
    { label: 'Attorneys', href: FEATURES_FALLBACK },
    { label: 'Roofers', href: '/services/roofing' },
    { label: 'General Contractors', href: FEATURES_FALLBACK },
    { label: 'HVAC Companies', href: FEATURES_FALLBACK },
    { label: 'Plumbers', href: FEATURES_FALLBACK },
    { label: 'Electricians', href: FEATURES_FALLBACK },
    { label: 'Insurance Agents', href: FEATURES_FALLBACK },
    { label: 'Therapists', href: '/services/therapists-advisors' },
    { label: 'Home Service Teams', href: '/services/home-services' },
    { label: 'Coaches & Consultants', href: '/services/agency-consultant' },
    { label: 'Travel Advisors', href: FEATURES_FALLBACK },
    { label: 'Moving Companies', href: FEATURES_FALLBACK },
    { label: 'Fencing', href: FEATURES_FALLBACK },
    { label: 'Pest Control', href: FEATURES_FALLBACK },
    { label: 'All Local Service Businesses', href: FEATURES_FALLBACK },
  ],
} = Astro.props;
---

<section class="built-for" id="built-for">
  <div class="inner">

    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="vertical-grid">
      {verticals.map((v) => (
        <a href={v.href} class="vertical">{v.label}</a>
      ))}
    </div>

  </div>
</section>

<style>
  .built-for {
    background: var(--color-bg-alt);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1100px; margin: 0 auto; }

  .header { max-width: 640px; margin: 0 auto var(--space-7); text-align: center; }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .vertical-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .vertical {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-fg);
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .vertical:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-fg);
  }

  @media (max-width: 560px) {
    .built-for { padding: var(--space-7) var(--space-5); }
  }
</style>
