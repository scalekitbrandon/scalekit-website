---
// "How it works": three stacked step cards, each with a number circle,
// body, and a small tag pill.
import RxHead from './RxHead.astro';
import RxCta from './RxCta.astro';
import type { ReceptionistPage } from '../../data/ai-receptionist';

type Props = ReceptionistPage['steps'];
const { headline, items } = Astro.props;
---

<section class="rx-steps" id="how-it-works">
  <div class="inner">
    <RxHead eyebrow="How It Works" headline={headline} />
    <ol class="list">
      {items.map((step, i) => (
        <li class="card">
          <span class="num">{i + 1}</span>
          <div>
            <h3 class="title">{step.title}</h3>
            <p class="body">{step.body}</p>
            <span class="tag">{step.tag}</span>
          </div>
        </li>
      ))}
    </ol>
    <RxCta />
  </div>
</section>

<style>
  .rx-steps {
    background: var(--color-bg-alt);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 780px; margin: 0 auto; }
  .list { list-style: none; padding: 0; margin: 0 0 var(--space-7); display: flex; flex-direction: column; gap: var(--space-4); }
  .card {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-5);
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 30px 32px;
  }
  .num {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-fg);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: var(--font-weight-max);
  }
  .title { font-size: 19px; font-weight: var(--font-weight-max); color: var(--color-fg); margin: 4px 0 10px; }
  .body { font-size: 15.5px; line-height: 1.65; color: var(--color-text-mid); margin: 0 0 14px; }
  .tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
  }

  @media (max-width: 560px) {
    .rx-steps { padding: var(--space-7) var(--space-3); }
    .card { grid-template-columns: 1fr; gap: var(--space-3); padding: 24px 20px; }
    .num { width: 44px; height: 44px; font-size: 19px; }
  }
</style>
