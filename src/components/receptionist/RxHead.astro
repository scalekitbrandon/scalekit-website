---
// Eyebrow + H2 (+ optional subhead) opener shared by the receptionist sections.
interface Props { eyebrow?: string; headline: string; sub?: string; align?: 'center' | 'left'; dark?: boolean }
const { eyebrow, headline, sub, align = 'center', dark = false } = Astro.props;
---

<div class:list={['rx-head', align, { dark }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="headline">{headline}</h2>
  {sub && <p class="sub">{sub}</p>}
</div>

<style>
  .rx-head { margin: 0 0 var(--space-7); }
  .rx-head.center { text-align: center; max-width: 820px; margin-inline: auto; }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(28px, 3.8vw, 44px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-fg);
    margin: 0;
  }
  .sub { font-size: 17px; line-height: 1.6; color: var(--color-text-mid); margin: var(--space-4) 0 0; }
  .dark .headline { color: var(--color-dark-fg); }
  .dark .eyebrow { color: var(--color-primary); }
  .dark .sub { color: var(--color-dark-text-mid); }
</style>
