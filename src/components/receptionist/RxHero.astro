---
// Hero for the AI Receptionist pages. Two columns: pitch on the left,
// one video on the right. Uses the same
// cream + lime-grid background, pill eyebrow and black/lime accent chip as
// the rest of the site.
// The video plays through Swarmify (<smartvideo>, script loaded site-wide
// in BaseLayout). Until a video URL is set in src/data/ai-receptionist.ts, it
// shows a "coming soon" frame that points to the sample calls below,
// never a fake player that does nothing.
import RxCta from './RxCta.astro';

interface Props {
  eyebrowLead: string;
  eyebrow: string;
  headline: string;
  headlineAccent: string;
  subheadline: string;
  proof: string[];
  videoUrl?: string;
  videoWidth?: number;
  videoHeight?: number;
  hasCalls?: boolean;
}

const { eyebrowLead, eyebrow, headline, headlineAccent, subheadline, proof, videoUrl, videoWidth = 1280, videoHeight = 720, hasCalls = false } = Astro.props;
const portrait = !!videoUrl && videoHeight > videoWidth;

---

<section class="rx-hero">
  <div class="inner">
    <div class="copy">
      <p class="eyebrow">
        <span class="dot"></span>
        <span><strong>{eyebrowLead}</strong> {eyebrow}</span>
      </p>
      <h1 class="h1">
        {headline} <span class="accent">{headlineAccent}</span>
      </h1>
      <p class="sub">{subheadline}</p>
      <RxCta align="left" />
    </div>

    <div class="media">
      <div class:list={['frame', { portrait }]} style={videoUrl ? `--video-ratio: ${videoWidth} / ${videoHeight}` : undefined}>
        {videoUrl ? (
          <smartvideo src={videoUrl} width={videoWidth} height={videoHeight} class="swarm-fluid" controls playsinline></smartvideo>
        ) : (
          <div class="placeholder">
            <span class="play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <p class="ph-title">Video walkthrough coming soon</p>
            {hasCalls && <a class="ph-link" href="#calls">Read sample calls below ↓</a>}
          </div>
        )}
      </div>

      <ul class="proof">
        {proof.map((item) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>


<style>
  .rx-hero {
    background-color: var(--color-bg);
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
    padding: 160px var(--space-6) var(--space-8);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner {
    max-width: var(--container-max-nav);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-2);
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 10px 20px 10px 14px;
    margin: 0 0 var(--space-5);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-fg);
  }
  .eyebrow strong { font-weight: 800; }
  .dot {
    width: 7px;
    height: 7px;
    margin-top: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    outline: 2px solid var(--color-primary-outline);
    flex-shrink: 0;
  }
  .h1 {
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-fg);
    margin: 0 0 var(--space-5);
  }
  .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 2px 14px;
    border-radius: var(--radius-sm);
    margin-top: 8px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0 0 var(--space-6);
  }

  .frame {
    aspect-ratio: var(--video-ratio, 16 / 9);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-dark-bg);
    box-shadow: 0 24px 60px rgba(10, 10, 10, 0.18);
  }
  .frame :global(smartvideo), .frame :global(video), .frame :global(video-js) { width: 100%; height: 100%; display: block; }
  /* Vertical video: cap the height so it fits beside the headline, and
     center the narrower frame in the column. */
  .frame.portrait {
    width: min(100%, calc(min(640px, 78vh) * 9 / 16));
    margin-inline: auto;
  }
  .placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: var(--space-5);
    text-align: center;
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
  }
  .play {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .play svg { width: 28px; height: 28px; margin-left: 4px; }
  .ph-title { color: var(--color-dark-fg); font-size: 16px; font-weight: 700; margin: 4px 0 0; }
  .ph-link { color: var(--color-primary); font-size: 14px; font-weight: 600; text-decoration: none; }
  .ph-link:hover { text-decoration: underline; }

  .proof {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
  }
  .proof li {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-fg);
  }
  .proof svg {
    width: 18px;
    height: 18px;
    padding: 3px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }

  @media (max-width: 900px) {
    .inner { grid-template-columns: 1fr; gap: var(--space-7); }
  }
  @media (max-width: 560px) {
    .rx-hero { padding: 130px var(--space-3) var(--space-7); }
  }
</style>
