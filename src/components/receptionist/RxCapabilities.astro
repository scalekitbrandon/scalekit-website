---
// 3x3 capability tiles beside the pitch (tinted band).
import RxIcon from './RxIcon.astro';
import RxCta from './RxCta.astro';
import type { ReceptionistPage } from '../../data/ai-receptionist';

type Props = ReceptionistPage['capabilities'];
const { tiles, headline, body, bold } = Astro.props;
---

<section class="rx-caps">
  <div class="inner">
    <ul class="tiles">
      {tiles.map((t) => (
        <li class="tile">
          <RxIcon name={t.icon} />
          <span>{t.label}</span>
        </li>
      ))}
    </ul>
    <div class="pitch">
      <h2 class="headline">{headline}</h2>
      <p class="body">{body}</p>
      <p class="bold">{bold}</p>
      <RxCta align="left" />
    </div>
  </div>
</section>

<style>
  .rx-caps {
    background: var(--color-bg-alt);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner {
    max-width: var(--container-max-nav);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .tile {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 26px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg);
  }
  .tile :global(svg) {
    width: 40px;
    height: 40px;
    padding: 9px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }
  .headline {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .body { font-size: 17px; line-height: 1.7; color: var(--color-text-mid); margin: 0 0 var(--space-4); }
  .bold { font-size: 17px; font-weight: 800; color: var(--color-fg); margin: 0 0 var(--space-6); }

  @media (max-width: 900px) {
    .inner { grid-template-columns: 1fr; gap: var(--space-7); }
    .pitch { order: -1; }
  }
  @media (max-width: 560px) {
    .rx-caps { padding: var(--space-7) var(--space-3); }
    .tiles { gap: 8px; }
    .tile { padding: 18px 6px; font-size: 10.5px; }
    .tile :global(svg) { width: 34px; height: 34px; padding: 7px; }
  }
</style>
