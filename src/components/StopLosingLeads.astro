---
// "Stop Losing Leads" (CRM & Automation) service section. Same structural
// language as the other service sections.
interface Item {
  title: string;
  description: string;
  icon: string; // 'bolt' | 'message' | 'loop' | 'database' | 'calendar' | 'kanban'
}

interface Props {
  eyebrow?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subheadline?: string;
  items?: Item[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'CRM & Automation',
  headlineLine1 = 'Never Miss',
  headlineLine2 = 'Another Lead Again',
  subheadline = "Most leads don't disappear because they weren't interested. They disappear because nobody followed up fast enough. We build the system that never forgets to.",
  items = [
    {
      icon: 'bolt',
      title: 'Instant Lead Response',
      description: 'Every new lead gets a text or call within minutes, automatically.',
    },
    {
      icon: 'message',
      title: 'Missed Call Text-Back',
      description: "Can't answer? We text them back before they call your competitor.",
    },
    {
      icon: 'loop',
      title: 'Automated Follow-Up Sequences',
      description: 'Leads get nurtured with texts, emails, and calls until they respond.',
    },
    {
      icon: 'database',
      title: 'Centralized CRM',
      description: 'Every lead, call, and conversation in one place — not scattered across apps.',
    },
    {
      icon: 'calendar',
      title: 'Appointment Reminders',
      description: 'Fewer no-shows with automatic confirmations and reminders.',
    },
    {
      icon: 'kanban',
      title: 'Pipeline & Deal Tracking',
      description: 'See exactly where every lead is in the process, at a glance.',
    },
  ],
  ctaLabel = 'Explore CRM & Automation',
  ctaHref = '/services/automation',
} = Astro.props;

const icons: Record<string, string> = {
  bolt: '<path d="M13 2L3 14h7l-1 8 11-14h-7l1-6z"/>',
  message: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  loop: '<path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  kanban: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
};
---

<section class="automation" id="automation">
  <div class="inner">

    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">
        <span class="line">{headlineLine1}</span>
        <span class="line accent">{headlineLine2}</span>
      </h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="item-grid">
      {items.map((item) => (
        <div class="item">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
          </div>
          <h3 class="item-title">{item.title}</h3>
          <p class="item-desc">{item.description}</p>
        </div>
      ))}
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="cta">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .automation {
    background: var(--color-bg-alt);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1200px; margin: 0 auto; }

  .header { max-width: 700px; margin: 0 0 var(--space-8); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
  }
  .headline .line { display: block; color: var(--color-fg); }
  .headline .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 4px 18px;
    border-radius: var(--radius-sm);
    margin-top: 10px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(215, 255, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  .icon-wrap svg { width: 22px; height: 22px; color: var(--color-fg); }
  .item-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin: 0 0 8px;
  }
  .item-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-mid);
    margin: 0;
  }

  .cta-row {
    text-align: center;
    margin-top: var(--space-8);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--color-fg); color: #ffffff; }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .item-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .automation { padding: var(--space-7) var(--space-5); }
    .item-grid { grid-template-columns: 1fr; }
  }
</style>
