---
// "Get More Leads" (Google & Meta Ads) service section. Same structural
// language as GetFound.astro / WebsitesFunnels.astro.
interface Item {
  title: string;
  description: string;
  icon: string; // 'target' | 'badge' | 'megaphone' | 'layout' | 'track' | 'chart'
}

interface Props {
  eyebrow?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subheadline?: string;
  items?: Item[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Google & Meta Ads',
  headlineLine1 = 'Get More Leads',
  headlineLine2 = 'Without Wasting Ad Spend',
  subheadline = "Clicks don't pay the bills. We build campaigns around the people who are actually ready to hire you — and we track every dollar back to a real lead.",
  items = [
    {
      icon: 'target',
      title: 'Google Search Ads',
      description: 'Show up right when someone searches for what you do.',
    },
    {
      icon: 'badge',
      title: 'Local Services Ads',
      description: 'Google Guaranteed badge, and you pay per lead, not per click.',
    },
    {
      icon: 'megaphone',
      title: 'Meta Ads (Facebook & Instagram)',
      description: 'Reach people before they even know they need you.',
    },
    {
      icon: 'layout',
      title: 'Landing Pages Built to Convert',
      description: 'Every campaign gets its own page, built to turn clicks into leads.',
    },
    {
      icon: 'track',
      title: 'Conversion Tracking',
      description: 'Know exactly which ads and keywords turn into paying customers.',
    },
    {
      icon: 'chart',
      title: 'Budget & ROI Reporting',
      description: "Clear reporting on what you're spending and what it's actually making you.",
    },
  ],
  ctaLabel = 'Explore Google & Meta Ads',
  ctaHref = '/services/ads',
} = Astro.props;

const icons: Record<string, string> = {
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
  badge: '<path d="M12 2L14.5 8.5L21.5 9L16 13.5L17.5 20.5L12 16.5L6.5 20.5L8 13.5L2.5 9L9.5 8.5L12 2Z"/>',
  megaphone: '<path d="M3 11v2a2 2 0 0 0 2 2h1l3 6h2l-1-6h4l6 4V5l-6 4H6a2 2 0 0 0-2 2z"/><path d="M9 15v4a2 2 0 0 0 2 2h1"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 9v12"/>',
  track: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  chart: '<path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12.5" y="8" width="3" height="10"/><rect x="18" y="5" width="3" height="13"/>',
};
---

<section class="ads" id="ads">
  <div class="inner">

    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">
        <span class="line">{headlineLine1}</span>
        <span class="line accent">{headlineLine2}</span>
      </h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="item-grid">
      {items.map((item) => (
        <div class="item">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
          </div>
          <h3 class="item-title">{item.title}</h3>
          <p class="item-desc">{item.description}</p>
        </div>
      ))}
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="cta">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .ads {
    background: #ffffff;
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1200px; margin: 0 auto; }

  .header { max-width: 700px; margin: 0 0 var(--space-8); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
  }
  .headline .line { display: block; color: var(--color-fg); }
  .headline .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 4px 18px;
    border-radius: var(--radius-sm);
    margin-top: 10px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(215, 255, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  .icon-wrap svg { width: 22px; height: 22px; color: var(--color-fg); }
  .item-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin: 0 0 8px;
  }
  .item-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-mid);
    margin: 0;
  }

  .cta-row {
    text-align: center;
    margin-top: var(--space-8);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--color-fg); color: #ffffff; }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .item-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .ads { padding: var(--space-7) var(--space-5); }
    .item-grid { grid-template-columns: 1fr; }
  }
</style>
