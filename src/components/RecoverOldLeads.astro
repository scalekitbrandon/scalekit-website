---
// "Recover Old Leads" (Reactivation) service section. Same structural
// language as the other service sections.
interface Item {
  title: string;
  description: string;
  icon: string; // 'refresh' | 'tag' | 'users' | 'layers' | 'star' | 'chart'
}

interface Props {
  eyebrow?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  subheadline?: string;
  items?: Item[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Reactivation',
  headlineLine1 = 'Recover Old Leads',
  headlineLine2 = 'Sitting in Your CRM',
  subheadline = "You already paid to get those leads. Most of them never booked — not because they weren't interested, but because nobody followed back up. We bring them back without spending another dollar on ads.",
  items = [
    {
      icon: 'refresh',
      title: 'Database Reactivation Campaigns',
      description: 'We message everyone in your CRM who never booked, automatically.',
    },
    {
      icon: 'tag',
      title: 'Win-Back Offers',
      description: 'Targeted offers that bring dormant leads back to life.',
    },
    {
      icon: 'users',
      title: 'Past Customer Re-Engagement',
      description: 'Turn one-time customers into repeat business.',
    },
    {
      icon: 'layers',
      title: 'Multi-Channel Outreach',
      description: 'Text, email, and voicemail drops working together, not just one channel.',
    },
    {
      icon: 'star',
      title: 'Automated Review Requests',
      description: 'Turn happy past customers into 5-star reviews.',
    },
    {
      icon: 'chart',
      title: 'Revenue Recovered Reporting',
      description: "See exactly how much old leads are worth once we reactivate them.",
    },
  ],
  ctaLabel = 'Explore Reactivation',
  ctaHref = '/services/reactivation',
} = Astro.props;

const icons: Record<string, string> = {
  refresh: '<path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10"/><path d="M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>',
  tag: '<path d="M20.59 13.41L11 3.83L4 4L3.83 11L13.41 20.59C13.7893 20.9611 14.3149 21.1852 14.87 21.19C15.4251 21.1852 15.9507 20.9611 16.33 20.59L20.59 16.33C20.9611 15.9507 21.1852 15.4251 21.19 14.87C21.1852 14.3149 20.9611 13.7893 20.59 13.41Z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  layers: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  star: '<path d="M12 2L14.5 8.5L21.5 9L16 13.5L17.5 20.5L12 16.5L6.5 20.5L8 13.5L2.5 9L9.5 8.5L12 2Z"/>',
  chart: '<path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12.5" y="8" width="3" height="10"/><rect x="18" y="5" width="3" height="13"/>',
};
---

<section class="reactivation" id="reactivation">
  <div class="inner">

    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">
        <span class="line">{headlineLine1}</span>
        <span class="line accent">{headlineLine2}</span>
      </h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="item-grid">
      {items.map((item) => (
        <div class="item">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
          </div>
          <h3 class="item-title">{item.title}</h3>
          <p class="item-desc">{item.description}</p>
        </div>
      ))}
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="cta">
        {ctaLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

  </div>
</section>

<style>
  .reactivation {
    background: #ffffff;
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1200px; margin: 0 auto; }

  .header { max-width: 700px; margin: 0 0 var(--space-8); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
  }
  .headline .line { display: block; color: var(--color-fg); }
  .headline .accent {
    display: inline-block;
    background: var(--color-fg);
    color: var(--color-primary);
    padding: 4px 18px;
    border-radius: var(--radius-sm);
    margin-top: 10px;
  }
  .sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0;
  }

  .item-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .item {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(215, 255, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  .icon-wrap svg { width: 22px; height: 22px; color: var(--color-fg); }
  .item-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin: 0 0 8px;
  }
  .item-desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-mid);
    margin: 0;
  }

  .cta-row {
    text-align: center;
    margin-top: var(--space-8);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    background: transparent;
    border: 2px solid var(--color-fg);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .cta:hover { background: var(--color-fg); color: #ffffff; }
  .cta svg { width: 15px; height: 15px; flex-shrink: 0; }

  @media (max-width: 900px) {
    .item-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .reactivation { padding: var(--space-7) var(--space-5); }
    .item-grid { grid-template-columns: 1fr; }
  }
</style>
