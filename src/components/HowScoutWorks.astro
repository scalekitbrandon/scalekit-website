---
// "How Scout Works" — rich feature-row section for /scout. Each row is
// its own component (ScoutGbpFeature, ScoutReviewsFeature, etc.), built
// up one at a time; the original plain icon-panel list this started
// from (including "Publishes Service Area Pages" and "Monitors Rankings
// & Technical Health") has been fully replaced/removed.
import ScoutGbpFeature from './ScoutGbpFeature.astro';
import ScoutReviewsFeature from './ScoutReviewsFeature.astro';
import ScoutCitationsFeature from './ScoutCitationsFeature.astro';
import ScoutSocialFeature from './ScoutSocialFeature.astro';
import ScoutAiSeoFeature from './ScoutAiSeoFeature.astro';
import ScoutWebsiteSeoFeature from './ScoutWebsiteSeoFeature.astro';
import ScoutYoutubeFeature from './ScoutYoutubeFeature.astro';
import ScoutDoesItAllBanner from './ScoutDoesItAllBanner.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
}

const {
  eyebrow = 'How Scout Ranks Your Local Business',
  headline = 'One AI Agent, Working Your Local Search Every Day',
} = Astro.props;
---

<section class="how-scout-works" id="how-it-works">
  <div class="inner">

    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
    </div>

    <ScoutGbpFeature />

    <ScoutReviewsFeature />

    <ScoutCitationsFeature />

    <ScoutSocialFeature />

    <ScoutAiSeoFeature />

    <ScoutWebsiteSeoFeature />

    <ScoutYoutubeFeature />

    <ScoutDoesItAllBanner />

  </div>
</section>

<style>
  .how-scout-works {
    background: var(--color-bg);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 1100px; margin: 0 auto; }

  .header { max-width: 640px; margin: 0 auto var(--space-8); text-align: center; }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    margin: 0;
  }

  @media (max-width: 560px) {
    .how-scout-works { padding: var(--space-7) var(--space-5); }
  }
</style>
