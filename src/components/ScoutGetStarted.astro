---
// "Get Started" choice section for /scout, id="get-started" — every
// "Get Started"-labeled CTA on this page (ScoutHero, all 7 feature
// rows, footer) now scrolls here first instead of jumping straight to
// the lead form, so visitors see the Buy Now / Book a Demo choice
// before committing to either. Sits directly above the real
// <BookCall /> section, which was a dead #book-call anchor until this
// same round of changes, since scout.astro never actually included
// <BookCall />.
// Two framed paths per Brandon's direction: "Buy Now" (ready to start)
// vs "Book a Demo Call" (wants a walkthrough first). "Buy Now" goes to
// the real Scout pricing card on /pricing#local-seo (that section's
// real id — not /pricing#scout) rather than a fabricated instant-
// checkout link, since there's no separate Stripe/GHL order form built
// yet. "Book a Demo Call" goes to the real lead-form-then-calendar flow
// in #book-call below.
interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  buyNowHref?: string;
  demoHref?: string;
}

const {
  eyebrow = 'Get Started',
  headline = 'Two Ways to Get Scout Working For You',
  subheadline = "Ready to buy? Head straight to pricing. Want to see it first? Book a quick call and we'll walk you through it.",
  buyNowHref = '/pricing#local-seo',
  demoHref = '#book-call',
} = Astro.props;
---

<section class="get-started" id="get-started">
  <div class="inner">
    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
      <p class="sub">{subheadline}</p>
    </div>

    <div class="choice-grid">
      <a href={buyNowHref} class="choice">
        <span class="choice-badge">Ready Now</span>
        <h3 class="choice-title">Buy Now</h3>
        <p class="choice-desc">Skip the exploring — let's get Scout set up on your Google Business Profile and start ranking.</p>
        <span class="choice-cta">
          Get Started
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        </span>
      </a>

      <a href={demoHref} class="choice">
        <span class="choice-badge">Want To See It First</span>
        <h3 class="choice-title">Book a Demo Call</h3>
        <p class="choice-desc">Have questions or want a walkthrough before committing? We'll show you exactly how Scout works for your business.</p>
        <span class="choice-cta">
          Book a Demo Call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .get-started {
    background: var(--color-bg-alt);
    padding: var(--space-8) var(--space-6);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 900px; margin: 0 auto; }

  .header { text-align: center; margin: 0 auto var(--space-7); }
  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 18px;
  }
  .headline {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0 auto;
    max-width: 560px;
  }

  .choice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  .choice {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .choice:hover {
    border-color: var(--color-primary);
    box-shadow: 0 16px 32px rgba(10, 10, 10, 0.08);
    transform: translateY(-2px);
  }
  .choice-badge {
    display: inline-block;
    background: rgba(215, 255, 0, 0.2);
    color: var(--color-fg);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    margin: 0 0 var(--space-4);
  }
  .choice-title {
    font-size: 22px;
    font-weight: var(--font-weight-max);
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin: 0 0 10px;
  }
  .choice-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-mid);
    margin: 0 0 var(--space-5);
    flex: 1;
  }
  .choice-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-fg);
    border-bottom: 1.5px solid var(--color-primary);
    padding-bottom: 2px;
  }
  .choice-cta svg { width: 14px; height: 14px; flex-shrink: 0; }

  @media (max-width: 700px) {
    .choice-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .get-started { padding: var(--space-7) var(--space-5); }
  }
</style>
