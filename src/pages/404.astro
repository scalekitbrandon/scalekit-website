---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const footerGroups = [
  {
    heading: 'Company',
    links: [
      { label: 'Home', href: '/' },
      { label: 'How We Work', href: '/#process' },
      { label: 'Who We Work With', href: '/#built-for' },
    ],
  },
  {
    heading: 'Services',
    links: [
      { label: 'Websites & Funnels', href: '/#websites-funnels' },
      { label: 'Local SEO', href: '/#local-seo' },
      { label: 'Google & Meta Ads', href: '/#ads' },
      { label: 'CRM & Automation', href: '/#automation' },
      { label: 'Reactivation', href: '/#reactivation' },
      { label: 'AI Agents & Solutions', href: '/#ai-agents' },
    ],
  },
  {
    heading: 'Get Started',
    links: [{ label: 'Book Your Free Strategy Call', href: '/#book-call' }],
  },
];
---

<BaseLayout title="Page Not Found | ScaleKit" description="This page doesn't exist — let's get you back on track.">
  <Header slot="header" homeHref="/" />

  <section class="not-found">
    <div class="inner">
      <p class="code">404</p>
      <h1 class="headline">This Page Doesn't Exist</h1>
      <p class="sub">The page you're looking for was moved, renamed, or never existed. Let's get you back on track.</p>
      <a href="/" class="cta">
        Back to Homepage
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>

  <Footer
    slot="footer"
    logoText="ScaleKit"
    tagline="Not a bundle of connected tools. One team that builds, ranks, and grows your business, start to finish."
    contactEmail="hello@scalekit.io"
    groups={footerGroups}
  />
</BaseLayout>

<style>
  .not-found {
    background-color: var(--color-bg);
    background-image: var(--bg-lime-grid);
    background-size: var(--bg-lime-grid-size);
    padding: 200px 24px 140px;
    text-align: center;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .inner { max-width: 560px; margin: 0 auto; }
  .code {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--color-text-light);
    margin: 0 0 var(--space-4);
  }
  .headline {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: var(--font-weight-max);
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-mid);
    margin: 0 0 var(--space-6);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 16px 32px;
    font-size: 15.5px;
    font-weight: 700;
    color: var(--color-primary-fg);
    background: var(--color-primary);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background 0.15s;
  }
  .cta:hover { background: var(--color-primary-hover); }
  .cta svg { width: 15px; height: 15px; }

  @media (max-width: 560px) {
    .not-found { padding: 160px 20px 100px; }
  }
</style>
