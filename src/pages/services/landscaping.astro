---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import IndustryHero from '../../components/IndustryHero.astro';
import TemplateShowcase from '../../components/TemplateShowcase.astro';
import ProcessCircles from '../../components/ProcessCircles.astro';
import FinalCta from '../../components/FinalCta.astro';
import BookCall from '../../components/BookCall.astro';
import Footer from '../../components/Footer.astro';
import LandscapingSample from '../../components/samples/LandscapingSample.astro';
import AnchorSample from '../../components/samples/AnchorSample.astro';
import PaintingSample from '../../components/samples/PaintingSample.astro';
import RoofingSample from '../../components/samples/RoofingSample.astro';
import RestorationSample from '../../components/samples/RestorationSample.astro';

const siteUrl = Astro.site.origin;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Landscaping & Tree Care Websites & Funnels',
    name: 'Website Design for Landscaping & Tree Care Companies',
    description: 'ScaleKit builds landscaping and tree care companies a portfolio-first website that turns browsers into booked estimates.',
    url: `${siteUrl}/services/landscaping`,
    provider: { '@type': 'ProfessionalService', name: 'ScaleKit', url: siteUrl },
  },
];

const headerNav = {
  services: [
    { label: 'Websites & Funnels', href: '/#websites-funnels' },
    { label: 'Local SEO', href: '/#local-seo' },
    { label: 'Google & Meta Ads', href: '/#ads' },
    { label: 'CRM & Automation', href: '/#automation' },
    { label: 'Reactivation', href: '/#reactivation' },
    { label: 'AI Agents & Solutions', href: '/#ai-agents' },
  ],
  links: [
    { label: 'Features', href: '/features' },
    { label: 'How We Work', href: '/#process' },
    { label: 'Who We Work With', href: '/#built-for' },
    { label: 'Pricing', href: '/pricing' },
  ],
};

const footerGroups = [
  {
    heading: 'Services',
    links: [
      { label: 'Websites & Funnels', href: '/#websites-funnels' },
      { label: 'Local SEO', href: '/#local-seo' },
      { label: 'Google & Meta Ads', href: '/#ads' },
      { label: 'CRM & Automation', href: '/#automation' },
      { label: 'Reactivation', href: '/#reactivation' },
      { label: 'AI Agents & Solutions', href: '/#ai-agents' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'Home', href: '/' },
      { label: 'How We Work', href: '/#process' },
      { label: 'Who We Work With', href: '/#built-for' },
    ],
  },
  {
    heading: 'Get Started',
    links: [{ label: 'Book Your Free Strategy Call', href: '#book-call' }],
  },
];
---

<BaseLayout
  title="Website Design for Landscaping & Tree Care Companies | ScaleKit"
  description="ScaleKit builds landscaping and tree care companies a portfolio-first website that turns browsers into booked estimates."
  structuredData={structuredData}
>
  <Header slot="header" homeHref="/" services={headerNav.services} links={headerNav.links} />

  <IndustryHero
    eyebrow="Website Design for Landscaping & Tree Care Companies"
    headline="Show Off Real Work. Book More Estimates."
    subheadline="Your best marketing is the yards you've already transformed. We build landscaping and tree care companies a portfolio-first website that turns browsers into booked estimates."
    checklist={[
      'Lightning-fast load times',
      'Mobile-first on every device',
      'Technical SEO from day one',
      'Ranks in Google & AI search',
      'Live in days, not months',
      'High-conversion copywriting',
      'Built to convert, not just look good',
      'Unlimited review requests',
      'Connected straight to your CRM',
      'Instant lead form engagement',
    ]}
  />

  <TemplateShowcase
    addressLabel="yourlandscapingco.com"
    sampleLabels={[
      'yourhomeservicesco.com',
      'brushhourpaintingtexas.com',
      'yourroofingcompany.com',
      'yourrestorationco.com',
    ]}
  >
    <LandscapingSample />
    <Fragment slot="sample-1"><AnchorSample /></Fragment>
    <Fragment slot="sample-2"><PaintingSample /></Fragment>
    <Fragment slot="sample-3"><RoofingSample /></Fragment>
    <Fragment slot="sample-4"><RestorationSample /></Fragment>
  </TemplateShowcase>

  <ProcessCircles />

  <FinalCta
    eyebrow="Run Your Own Numbers"
    headline="What's One More Booked Estimate Actually Worth?"
    subheadline="Every project photo that never makes it onto your site is a sale you're leaving on the table. ScaleKit makes sure it gets seen."
  />

  <BookCall />

  <Footer slot="footer" logoText="ScaleKit" groups={footerGroups} />
</BaseLayout>
