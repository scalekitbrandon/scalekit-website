---
// Same pattern as /services/ads.astro and /services/automation.astro:
// IndustryHero for pain-point framing, then the homepage's own real
// RecoverOldLeads section for the deliverables grid, then the shared
// Process/TrustStrip/FinalCta/BookCall/Footer stack.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import IndustryHero from '../../components/IndustryHero.astro';
import RecoverOldLeads from '../../components/RecoverOldLeads.astro';
import Process from '../../components/Process.astro';
import FinalCta from '../../components/FinalCta.astro';
import BookCall from '../../components/BookCall.astro';
import Footer from '../../components/Footer.astro';
import { makeFooterGroups } from '../../data/site-nav';

const siteUrl = Astro.site.origin;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Database Reactivation',
    name: 'Database Reactivation for Service Businesses',
    description: 'ScaleKit re-engages the dormant leads and past customers already sitting in your CRM, turning them back into booked jobs without spending more on ads.',
    url: `${siteUrl}/services/reactivation/`,
    provider: { '@type': 'ProfessionalService', name: 'ScaleKit', url: siteUrl },
  },
];

const headerNav = {
  services: [
    { label: 'Websites & Funnels', href: '/#websites-funnels' },
    { label: 'Local SEO', href: '/scout/' },
    { label: 'Google & Meta Ads', href: '/services/ads/' },
    { label: 'CRM & Automation', href: '/services/automation/' },
    { label: 'Reactivation', href: '/services/reactivation/' },
    { label: 'AI Agents & Solutions', href: '/services/ai-agents/' },
    { label: 'AI Receptionist', href: '/services/ai-receptionist/' },
  ],
  links: [
    { label: 'Features', href: '/features/' },
    { label: 'How We Work', href: '/#process' },
    { label: 'Who We Work With', href: '/#built-for' },
    { label: 'Pricing', href: '/pricing/' },
  ],
};

const footerGroups = makeFooterGroups();
---

<BaseLayout
  title="Database Reactivation for Service Businesses | ScaleKit"
  description="ScaleKit re-engages the dormant leads and past customers already sitting in your CRM, turning them back into booked jobs without spending more on ads."
  structuredData={structuredData}
>
  <Header slot="header" homeHref="/" services={headerNav.services} links={headerNav.links} />

  <IndustryHero
    eyebrow="Reactivation"
    headline="Database Reactivation: Turn Old Leads Into Booked Jobs"
    subheadline="You already paid to get those leads. Most of them never booked — not because they weren't interested, but because nobody followed back up. We bring them back without spending another dollar on ads."
    checklist={[
      "New jobs from leads you already paid for",
      "Revenue without spending more on ads",
      "Past customers back on your schedule",
      "Campaigns written and run for you",
    ]}
    ctaLabel="Get Started"
  />

  <RecoverOldLeads
    eyebrow="What's Included"
    headlineLine1="Everything Your"
    headlineLine2="Reactivation Campaign Includes"
    subheadline="Every dormant lead and past customer in your CRM, worked automatically across every channel."
    ctaLabel="Get Started"
    ctaHref="#book-call"
  />

  <Process />

  <FinalCta
    eyebrow="Run Your Own Numbers"
    headline="What's One More Job From an Old Lead Actually Worth?"
    subheadline="You already paid to acquire that lead once. Reactivating them costs nothing close to what a new lead does. ScaleKit makes sure that list doesn't just sit there."
  />

  <BookCall />

  <Footer
    slot="footer"
    logoText="ScaleKit"
    tagline="Not a bundle of connected tools. One team that builds, ranks, and grows your business, start to finish."
    contactEmail="hello@scalekit.io"
    groups={footerGroups}
  />
</BaseLayout>
