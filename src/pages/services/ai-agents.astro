---
// Same pattern as the other three /services/<core-service> pages:
// IndustryHero for pain-point framing, then the homepage's own real
// SaveTimeScale section for the deliverables grid, then the shared
// Process/TrustStrip/FinalCta/BookCall/Footer stack. Last of the 6 core
// service pages — all six homepage service CTAs now resolve to a real
// page.
import ContentBlocks from '../../components/ContentBlocks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import IndustryHero from '../../components/IndustryHero.astro';
import SaveTimeScale from '../../components/SaveTimeScale.astro';
import Process from '../../components/Process.astro';
import FinalCta from '../../components/FinalCta.astro';
import BookCall from '../../components/BookCall.astro';
import Footer from '../../components/Footer.astro';

const siteUrl = Astro.site.origin;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'AI Agents & Automation',
    name: 'AI Agents & Solutions for Service Businesses',
    description: 'ScaleKit builds AI voice agents, chat agents, and custom agentic workflows that handle repetitive work so service businesses can scale without hiring more staff.',
    url: `${siteUrl}/services/ai-agents/`,
    provider: { '@type': 'ProfessionalService', name: 'ScaleKit', url: siteUrl },
  },
];

const headerNav = {
  services: [
    { label: 'Websites & Funnels', href: '/#websites-funnels' },
    { label: 'Local SEO', href: '/scout/' },
    { label: 'Google & Meta Ads', href: '/services/ads/' },
    { label: 'CRM & Automation', href: '/services/automation/' },
    { label: 'Reactivation', href: '/services/reactivation/' },
    { label: 'AI Agents & Solutions', href: '/services/ai-agents/' },
  ],
  links: [
    { label: 'Features', href: '/features/' },
    { label: 'How We Work', href: '/#process' },
    { label: 'Who We Work With', href: '/#built-for' },
    { label: 'Pricing', href: '/pricing/' },
  ],
};

const footerGroups = [
  {
    heading: 'Company',
    links: [
      { label: 'Home', href: '/' },
      { label: 'How We Work', href: '/#process' },
      { label: 'Who We Work With', href: '/#built-for' },
    ],
  },
  {
    heading: 'Services',
    links: [
      { label: 'Websites & Funnels', href: '/#websites-funnels' },
      { label: 'Local SEO', href: '/scout/' },
      { label: 'Google & Meta Ads', href: '/services/ads/' },
      { label: 'CRM & Automation', href: '/services/automation/' },
      { label: 'Reactivation', href: '/services/reactivation/' },
      { label: 'AI Agents & Solutions', href: '/services/ai-agents/' },
    ],
  },
  {
    heading: 'Get Started',
    links: [{ label: 'Get Started', href: '#book-call' }],
  },
];
---

<BaseLayout
  title="AI Receptionist & Voice Agents for Service Businesses | ScaleKit"
  description="ScaleKit builds AI voice agents, chat agents, and custom agentic workflows that handle repetitive work so service businesses can scale without hiring more staff."
  structuredData={structuredData}
>
  <Header slot="header" homeHref="/" services={headerNav.services} links={headerNav.links} />

  <IndustryHero
    eyebrow="AI Agents & Solutions"
    headline="AI Receptionist & AI Agents for Service Businesses"
    subheadline="Every hour your team spends on repetitive work is an hour they're not spending on customers. We build AI that handles the busywork — so you can grow without growing your headcount."
    checklist={[
      "Every call answered, 24/7",
      "Appointments booked while you are on the job",
      "Hours of admin back every week",
      "Grow without hiring more front-desk staff",
    ]}
    ctaLabel="Get Started"
  />

  <SaveTimeScale
    eyebrow="What's Included"
    headlineLine1="Everything Your"
    headlineLine2="AI Agent Setup Includes"
    subheadline="Built around what your business actually needs — not a generic bot bolted onto your website."
    ctaLabel="Get Started"
    ctaHref="#book-call"
  />
  <ContentBlocks blocks={[
      {
        eyebrow: 'AI Receptionist',
        heading: 'An AI Receptionist That Answers Every Call',
        paragraphs: [
          "An AI receptionist answers your business phone when you can't: after hours, on weekends, or when every line is busy. It greets callers by your business name, answers common questions, collects their details and books the appointment or alerts your team.",
          "Unlike a traditional answering service, it doesn't put callers on hold, and it is trained on your services, your service area and your prices.",
        ],
        list: [
          'Answers calls 24/7 in a natural voice',
          'Books appointments straight into your calendar',
          'Captures caller details and sends them to your CRM',
          'Hands urgent calls to a person on your team',
          'Answers the same questions your front desk hears every day',
        ],
      },
      {
        eyebrow: 'Beyond the Phone',
        heading: 'AI Agents for Chat, Follow-Up and Admin',
        paragraphs: [
          'The same approach works beyond phone calls. Chat agents answer website visitors, and custom AI workflows handle repetitive admin like intake, scheduling and data entry, so your team spends its time on customers.',
        ],
      },
    ]} />


  <Process />

  <FinalCta
    eyebrow="Run Your Own Numbers"
    headline="What's One More Answered Call After Hours Actually Worth?"
    subheadline="Every call that goes to voicemail is a job that goes to whoever picked up. ScaleKit makes sure that's you, every time."
  />

  <BookCall />

  <Footer
    slot="footer"
    logoText="ScaleKit"
    tagline="Not a bundle of connected tools. One team that builds, ranks, and grows your business, start to finish."
    contactEmail="hello@scalekit.io"
    groups={footerGroups}
  />
</BaseLayout>
