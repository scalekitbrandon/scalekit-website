---
// First-pass build, same pattern the original 6 /services/<industry>
// pages used before /scout grew into a bespoke build: IndustryHero for
// the pain-point framing, then the homepage's own real GetMoreLeads
// section (already-approved copy, not rebuilt from scratch) for the
// deliverables grid, then the shared Process/TrustStrip/FinalCta/
// BookCall/Footer stack. No industry-template showcase here since this
// isn't a trade vertical — it's one of ScaleKit's own core services.
import ContentBlocks from '../../components/ContentBlocks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import IndustryHero from '../../components/IndustryHero.astro';
import GetMoreLeads from '../../components/GetMoreLeads.astro';
import Process from '../../components/Process.astro';
import FinalCta from '../../components/FinalCta.astro';
import BookCall from '../../components/BookCall.astro';
import Footer from '../../components/Footer.astro';
import { makeFooterGroups } from '../../data/site-nav';

const siteUrl = Astro.site.origin;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Google & Meta Ads Management',
    name: 'Google & Meta Ads for Service Businesses',
    description: 'ScaleKit builds and manages Google Search, Local Services, and Meta ad campaigns for service businesses, with landing pages and conversion tracking built in.',
    url: `${siteUrl}/services/ads/`,
    provider: { '@type': 'ProfessionalService', name: 'ScaleKit', url: siteUrl },
  },
];

const headerNav = {
  services: [
    { label: 'Websites & Funnels', href: '/#websites-funnels' },
    { label: 'Local SEO', href: '/scout/' },
    { label: 'Google & Meta Ads', href: '/services/ads/' },
    { label: 'CRM & Automation', href: '/services/automation/' },
    { label: 'Reactivation', href: '/services/reactivation/' },
    { label: 'AI Agents & Solutions', href: '/services/ai-agents/' },
    { label: 'AI Receptionist', href: '/services/ai-receptionist/' },
  ],
  links: [
    { label: 'Features', href: '/features/' },
    { label: 'How We Work', href: '/#process' },
    { label: 'Who We Work With', href: '/#built-for' },
    { label: 'Pricing', href: '/pricing/' },
  ],
};

const footerGroups = makeFooterGroups();
---

<BaseLayout
  title="Google Ads Management for Service Businesses | ScaleKit"
  description="ScaleKit builds and manages Google Search, Local Services, and Meta ad campaigns for service businesses, with landing pages and conversion tracking built in."
  structuredData={structuredData}
>
  <Header slot="header" homeHref="/" services={headerNav.services} links={headerNav.links} />

  <IndustryHero
    eyebrow="Google & Meta Ads"
    headline="Google & Meta Ads Management for Service Businesses"
    subheadline="Clicks don't pay the bills. We build campaigns around the people who are actually ready to hire you — and we track every dollar back to a real lead."
    checklist={[
      "More booked jobs from every ad dollar",
      "Ads shown only in the areas you serve",
      "Know exactly what each lead costs you",
      "Landing pages built to turn clicks into calls",
    ]}
    ctaLabel="Get Started"
  />

  <GetMoreLeads
    eyebrow="What's Included"
    headlineLine1="Everything Your"
    headlineLine2="Ad Campaigns Include"
    subheadline="No à la carte guessing. Every ads engagement includes the full stack — the ads, the landing page, and the tracking that tells you what's working."
    ctaLabel="Get Started"
    ctaHref="#book-call"
  />
  <ContentBlocks blocks={[
      {
        eyebrow: 'Google Ads',
        heading: 'Google Ads Management for Service Businesses',
        paragraphs: [
          'Google Ads put your business in front of people who are searching for your service right now. That makes them the fastest way to fill a schedule, and the easiest way to waste money if they are set up wrong.',
          'We build and manage Google Search campaigns around the services you actually want more of, in the areas you actually serve, and track every call and form so you know what each lead costs.',
        ],
        list: [
          'Search campaigns built around your highest-value services',
          'Local Services Ads setup and management where available',
          'Call and form tracking on every campaign',
          'Negative keywords to cut wasted clicks',
          'Landing pages built to turn clicks into calls',
          'Monthly reporting in plain language',
        ],
      },
      {
        eyebrow: 'Meta Ads',
        heading: 'Meta Ads to Reach Homeowners Before They Search',
        paragraphs: [
          'Facebook and Instagram ads reach people in your area before they start searching, with offers, seasonal promotions and reactivation campaigns. We run Meta ads alongside Google so both channels feed the same follow-up system.',
        ],
      },
    ]} />


  <Process />

  <FinalCta
    eyebrow="Run Your Own Numbers"
    headline="What's One More Booked Job From Ads Actually Worth?"
    subheadline="Every click you're already paying for is wasted if the page it lands on doesn't convert, or the lead never gets a follow-up. ScaleKit closes both gaps."
  />

  <BookCall />

  <Footer
    slot="footer"
    logoText="ScaleKit"
    tagline="Not a bundle of connected tools. One team that builds, ranks, and grows your business, start to finish."
    contactEmail="hello@scalekit.io"
    groups={footerGroups}
  />
</BaseLayout>
