---
import RelatedLinks from '../components/RelatedLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScoutHero from '../components/ScoutHero.astro';
import HowScoutWorks from '../components/HowScoutWorks.astro';
import ScoutDemoVideoSection from '../components/ScoutDemoVideoSection.astro';
import ScoutFaq from '../components/ScoutFaq.astro';
import ScoutGetStarted from '../components/ScoutGetStarted.astro';
import BookCall from '../components/BookCall.astro';
import Footer from '../components/Footer.astro';
import { makeFooterGroups } from '../data/site-nav';

const siteUrl = Astro.site.origin;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'AI-Powered Local SEO',
    name: 'ScaleKit Local SEO — Powered by Scout™',
    description: "Scout continuously optimizes your Google Business Profile, strengthens your local search presence, monitors ranking opportunities, and helps your business get discovered by more customers in your service area.",
    url: `${siteUrl}/scout/`,
    provider: { '@type': 'ProfessionalService', name: 'ScaleKit', url: siteUrl },
  },
];

const headerNav = {
  services: [
    { label: 'Websites & Funnels', href: '/#websites-funnels' },
    { label: 'Local SEO', href: '/scout/' },
    { label: 'Google & Meta Ads', href: '/services/ads/' },
    { label: 'CRM & Automation', href: '/services/automation/' },
    { label: 'Reactivation', href: '/services/reactivation/' },
    { label: 'AI Agents & Solutions', href: '/services/ai-agents/' },
    { label: 'AI Receptionist', href: '/services/ai-receptionist/' },
  ],
  links: [
    { label: 'Features', href: '/features/' },
    { label: 'How We Work', href: '/#process' },
    { label: 'Who We Work With', href: '/#built-for' },
    { label: 'Pricing', href: '/pricing/' },
  ],
};

const footerGroups = makeFooterGroups();
---

<BaseLayout
  title="AI Local SEO Agent for Service Businesses | Scout by ScaleKit"
  description="Meet Scout, your AI Local SEO agent. Scout continuously optimizes your Google Business Profile, strengthens your local search presence, monitors ranking opportunities, and helps your business get discovered by more customers in your service area."
  structuredData={structuredData}
>
  <Header slot="header" homeHref="/" services={headerNav.services} links={headerNav.links} />

  <ScoutHero headlineLine1="Scout: The AI Local SEO Agent" headlineLine2="for Service Businesses" />

  <HowScoutWorks />

  <ScoutDemoVideoSection />

  <ScoutFaq />
  <RelatedLinks heading="What Scout Does for You" links={[
      { label: 'Google Business Profile Management', href: '/services/google-business-profile-management/', description: 'Keep your profile complete, active and ranking.' },
      { label: 'Google Review Automation', href: '/services/google-review-automation/', description: 'Ask every customer for a Google review automatically.' },
      { label: 'Local SEO for Roofers', href: '/industries/roofing/local-seo/', description: 'How Scout works for roofing companies.' },
    ]} />


  <ScoutGetStarted />

  <BookCall
    eyebrow="Get Started"
    headline="Let's Get Scout Working For You"
    subheadline="Tell us a bit about your business, then pick a time — or if you're ready to buy, we'll reach out right away to get you set up."
  />

  <Footer
    slot="footer"
    logoText="ScaleKit"
    tagline="Not a bundle of connected tools. One team that builds, ranks, and grows your business, start to finish."
    contactEmail="hello@scalekit.io"
    groups={footerGroups}
  />
</BaseLayout>
