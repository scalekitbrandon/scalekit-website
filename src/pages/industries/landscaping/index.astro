---
// Industry hub. Primary keyword: landscaping marketing automation. Each section links to the child page
// that owns the narrower term (website design, CRM, local SEO); see the
// keyword map in memory/decisions.md.
import KeywordPage from '../../../components/KeywordPage.astro';
---

<KeywordPage
  kind="service"
  title={"Marketing Automation for Landscaping Companies | ScaleKit"}
  description={"Marketing automation for landscaping and lawn care companies: website, local SEO, ads, CRM for estimates and renewals, and seasonal campaigns, built and run for you."}
  serviceType={"Landscaping marketing automation"}
  audience={"Landscaping and lawn care companies"}
  breadcrumbs={[
    {
      "name": "Who We Work With",
      "path": "/#built-for"
    },
    {
      "name": "Landscaping"
    }
  ]}
  hero={{
    "eyebrow": "For Landscaping Companies",
    "headline": "Marketing Automation for Landscaping Companies",
    "subheadline": "Handle the spring rush, follow up on every estimate, and fill next season before it starts. One system, built and run for you.",
    "checklist": [
      "Portfolio website that books estimates",
      "Google Maps rankings in your service area",
      "Seasonal ads for design and maintenance",
      "CRM for estimates and renewals",
      "Instant replies to every estimate request",
      "Seasonal campaigns to past clients"
    ]
  }}
  blocks={[
    {
      "eyebrow": "Website",
      "heading": "A Landscaping Website That Shows Off Your Work",
      "paragraphs": [
        "People hire landscapers with their eyes. We build portfolio-first sites with your real project photos and an estimate form that collects photos and property details up front."
      ],
      "link": {
        "label": "Landscaping website design",
        "href": "/industries/landscaping/website-design/"
      }
    },
    {
      "eyebrow": "Local SEO",
      "heading": "Get Found by Homeowners in Your Service Area",
      "paragraphs": [
        "Scout keeps your Google Business Profile active with fresh project photos, builds citations and asks every client for a review, so you show up when neighbors search for a landscaper."
      ],
      "link": {
        "label": "AI local SEO agent",
        "href": "/scout/"
      }
    },
    {
      "eyebrow": "Ads",
      "heading": "Seasonal Ads That Fill Your Schedule",
      "paragraphs": [
        "Google and Meta ads timed to the season: design and install in spring, maintenance contracts, fall cleanups and holiday lighting. Every lead feeds the same follow-up system."
      ],
      "link": {
        "label": "Google & Meta Ads management",
        "href": "/services/ads/"
      }
    },
    {
      "eyebrow": "CRM & Automation",
      "heading": "A CRM for Estimates, Proposals and Renewals",
      "paragraphs": [
        "Track every estimate from request to signed proposal, and keep maintenance clients on a separate track with renewal reminders before each season."
      ],
      "link": {
        "label": "Landscaping CRM",
        "href": "/industries/landscaping/crm/"
      }
    },
    {
      "eyebrow": "Instant Response",
      "heading": "Reply to Every Estimate Request the Same Day",
      "paragraphs": [
        "In spring, the company that replies first usually gets the job. Every request gets an instant reply, and every missed call gets a text back while your crews are out."
      ],
      "link": {
        "label": "Lead follow-up automation",
        "href": "/services/lead-follow-up-automation/"
      }
    },
    {
      "eyebrow": "Reactivation",
      "heading": "Bring Clients Back Every Season",
      "paragraphs": [
        "Past clients are your cheapest next job. Seasonal campaigns offer cleanups, mulch, aeration and lighting to the people who already know your work."
      ],
      "link": {
        "label": "Database reactivation",
        "href": "/services/reactivation/"
      }
    }
  ]}
  faqHeadline={"Landscaping Marketing Automation Questions"}
  faq={[
    {
      "question": "What is marketing automation for a landscaping company?",
      "answer": "It's the system that brings leads in and follows up with them without anyone doing it by hand: instant replies, missed call text back, follow-up sequences, review requests and reactivation, all connected to your website and ads."
    },
    {
      "question": "Do I have to use every service?",
      "answer": "No. Start with the one that fixes your biggest gap and add more later. Every ScaleKit service is month-to-month."
    },
    {
      "question": "Does this replace my scheduling or routing software?",
      "answer": "No. Keep the tools you use for crews and routes. ScaleKit handles leads, estimates, follow-up and client communication."
    },
    {
      "question": "Who sets it up and runs it?",
      "answer": "We do. We build the system, connect your phone, forms and calendar, write the messages and keep it running."
    }
  ]}
  related={[
    {
      "label": "Landscaping Website Design",
      "href": "/industries/landscaping/website-design/",
      "description": "A portfolio site that books estimates."
    },
    {
      "label": "Landscaping CRM",
      "href": "/industries/landscaping/crm/",
      "description": "Follow up on estimates and renew clients."
    },
    {
      "label": "Google Review Automation",
      "href": "/services/google-review-automation/",
      "description": "A review request after every job."
    }
  ]}
  finalCta={{
    "eyebrow": "Run Your Own Numbers",
    "headline": "How Full Could Next Season Be Before It Starts?",
    "subheadline": "Let's look at your past clients and open estimates together."
  }}
/>
