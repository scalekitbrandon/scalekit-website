---
// Industry hub. Primary keyword: marketing automation for coaches and consultants. Each section links to the child page
// that owns the narrower term (website design, CRM, local SEO); see the
// keyword map in memory/decisions.md.
import KeywordPage from '../../../components/KeywordPage.astro';
---

<KeywordPage
  kind="service"
  title={"Marketing Automation for Coaches & Consultants | ScaleKit"}
  description={"Marketing automation for coaches, consultants and agencies: website, search and AI visibility, ads, discovery call follow-up and AI agents, built and run for you."}
  serviceType={"Marketing automation for coaches and consultants"}
  audience={"Coaches, consultants and agencies"}
  breadcrumbs={[
    {
      "name": "Who We Work With",
      "path": "/#built-for"
    },
    {
      "name": "Coaches & Consultants"
    }
  ]}
  hero={{
    "eyebrow": "For Coaches, Consultants & Agencies",
    "headline": "Marketing Automation for Coaches and Consultants",
    "subheadline": "Look like the authority you are, follow up with every lead, and book more discovery calls without chasing anyone by hand.",
    "checklist": [
      "Website that sells the outcome",
      "Visibility in Google and AI search",
      "Ads that fill your calendar",
      "Pipeline from lead to signed client",
      "AI agents for intake and scheduling",
      "Campaigns to past clients and cold leads"
    ]
  }}
  blocks={[
    {
      "eyebrow": "Website",
      "heading": "A Website That Sells the Outcome, Not the Service List",
      "paragraphs": [
        "Clients hire consultants for results. We build sites that lead with the outcome you deliver, proof that you deliver it, and a clear path to a discovery call."
      ],
      "link": {
        "label": "Coach & consultant website design",
        "href": "/industries/agency-consultant/website-design/"
      }
    },
    {
      "eyebrow": "Search & AI Visibility",
      "heading": "Show Up Where Clients Look for Help",
      "paragraphs": [
        "More buyers now ask Google and AI tools to recommend a consultant. Scout keeps your profiles, reviews and content working so you are part of those answers."
      ],
      "link": {
        "label": "AI local SEO agent",
        "href": "/scout/"
      }
    },
    {
      "eyebrow": "Ads",
      "heading": "Ads That Fill Your Discovery Call Calendar",
      "paragraphs": [
        "Meta and Google campaigns pointed at a booking page, with every lead going straight into follow-up so ad spend turns into calls on your calendar."
      ],
      "link": {
        "label": "Google & Meta Ads management",
        "href": "/services/ads/"
      }
    },
    {
      "eyebrow": "CRM & Automation",
      "heading": "A Pipeline From First Lead to Signed Client",
      "paragraphs": [
        "Track every lead through discovery call, proposal and signed agreement, with reminders and follow-up so no proposal is left hanging."
      ],
      "link": {
        "label": "CRM for service businesses",
        "href": "/services/automation/"
      }
    },
    {
      "eyebrow": "AI Agents",
      "heading": "Hand Intake and Scheduling to AI",
      "paragraphs": [
        "AI agents can qualify leads, answer common questions and book calls, so your time goes to clients instead of admin."
      ],
      "link": {
        "label": "AI agents",
        "href": "/services/ai-agents/"
      }
    },
    {
      "eyebrow": "Reactivation",
      "heading": "Reconnect With Past Clients and Cold Leads",
      "paragraphs": [
        "Your list of past clients and old leads is the fastest place to find your next engagement. We run campaigns that start those conversations again."
      ],
      "link": {
        "label": "Database reactivation",
        "href": "/services/reactivation/"
      }
    }
  ]}
  faqHeadline={"Coach & Consultant Marketing Automation Questions"}
  faq={[
    {
      "question": "What is marketing automation for a coach or consultant?",
      "answer": "It's the system that brings leads in and follows up with them without anyone doing it by hand: instant replies, missed call text back, follow-up sequences, review requests and reactivation, all connected to your website and ads."
    },
    {
      "question": "Do I have to use every service?",
      "answer": "No. Start with the one that fixes your biggest gap and add more later. Every ScaleKit service is month-to-month."
    },
    {
      "question": "Does this replace my course or community platform?",
      "answer": "No. Keep the platform you deliver on. ScaleKit handles getting leads, following up and booking calls."
    },
    {
      "question": "Who sets it up and runs it?",
      "answer": "We do. We build the system, connect your phone, forms and calendar, write the messages and keep it running."
    }
  ]}
  related={[
    {
      "label": "Coach & Consultant Website Design",
      "href": "/industries/agency-consultant/website-design/",
      "description": "A site that sells the outcome."
    },
    {
      "label": "Lead Follow-Up Automation",
      "href": "/services/lead-follow-up-automation/",
      "description": "Follow up with every lead automatically."
    },
    {
      "label": "AI Agents",
      "href": "/services/ai-agents/",
      "description": "Automate intake and scheduling."
    }
  ]}
  finalCta={{
    "eyebrow": "Run Your Own Numbers",
    "headline": "What Is One More Signed Client Worth?",
    "subheadline": "Let's map out where your next one is coming from."
  }}
/>
