---
// Industry hub. Primary keyword: marketing automation for travel advisors. Each section links to the child page
// that owns the narrower term (website design, CRM, local SEO); see the
// keyword map in memory/decisions.md.
import KeywordPage from '../../../components/KeywordPage.astro';
---

<KeywordPage
  kind="service"
  title={"Marketing Automation for Travel Advisors | ScaleKit"}
  description={"Marketing automation for travel advisors and travel agents: website, search visibility, ads, quote follow-up, AI inquiry answering and past-traveler campaigns, built and run for you."}
  serviceType={"Marketing automation for travel advisors"}
  audience={"Travel advisors and travel agents"}
  breadcrumbs={[
    {
      "name": "Who We Work With",
      "path": "/#built-for"
    },
    {
      "name": "Travel Advisors"
    }
  ]}
  hero={{
    "eyebrow": "For Travel Advisors",
    "headline": "Marketing Automation for Travel Advisors",
    "subheadline": "Turn more trip inquiries into bookings and keep past travelers coming back, with a system that follows up for you while you plan trips.",
    "checklist": [
      "Website built around your specialties",
      "Get found by travelers searching for an advisor",
      "Ads for promotions and group trips",
      "Follow-up on every trip quote",
      "After-hours answers to new inquiries",
      "Campaigns to past travelers"
    ]
  }}
  blocks={[
    {
      "eyebrow": "Website",
      "heading": "A Website That Shows Why Travelers Should Book With You",
      "paragraphs": [
        "Your site has to show what a booking engine cannot: your expertise, your supplier relationships and your personal service. We build it around the trips you specialize in."
      ],
      "link": {
        "label": "Travel advisor website design",
        "href": "/industries/travel-advisors/website-design/"
      }
    },
    {
      "eyebrow": "Search Visibility",
      "heading": "Get Found by Travelers Looking for an Advisor",
      "paragraphs": [
        "Travelers search for things like \"cruise travel advisor\" or \"honeymoon travel agent near me.\" Scout keeps your Google Business Profile, reviews and listings working so they find you."
      ],
      "link": {
        "label": "AI local SEO agent",
        "href": "/scout/"
      }
    },
    {
      "eyebrow": "Ads",
      "heading": "Ads for Promotions, Group Trips and Peak Booking Seasons",
      "paragraphs": [
        "Meta and Google ads for the trips you want to fill, timed to booking seasons and supplier promotions, with every lead going straight into follow-up."
      ],
      "link": {
        "label": "Google & Meta Ads management",
        "href": "/services/ads/"
      }
    },
    {
      "eyebrow": "Follow-Up",
      "heading": "Follow Up on Every Trip Quote",
      "paragraphs": [
        "Travelers compare options and take time to decide. Every inquiry gets an instant reply and every quote gets a follow-up sequence until the traveler books or decides not to."
      ],
      "link": {
        "label": "Lead follow-up automation",
        "href": "/services/lead-follow-up-automation/"
      }
    },
    {
      "eyebrow": "AI Agents",
      "heading": "Answer New Inquiries While You Are Busy",
      "paragraphs": [
        "An AI assistant can answer common questions and collect trip details at any hour, so inquiries are ready for you when you sit down to plan."
      ],
      "link": {
        "label": "AI agents",
        "href": "/services/ai-agents/"
      }
    },
    {
      "eyebrow": "Past Travelers",
      "heading": "Bring Past Travelers Back for Their Next Trip",
      "paragraphs": [
        "Check-ins before anniversaries, birthdays and booking seasons keep you top of mind with the people most likely to book again and refer their friends."
      ],
      "link": {
        "label": "Database reactivation",
        "href": "/services/reactivation/"
      }
    }
  ]}
  faqHeadline={"Travel Advisor Marketing Automation Questions"}
  faq={[
    {
      "question": "What is marketing automation for a travel advisor?",
      "answer": "It's the system that brings leads in and follows up with them without anyone doing it by hand: instant replies, missed call text back, follow-up sequences, review requests and reactivation, all connected to your website and ads."
    },
    {
      "question": "Do I have to use every service?",
      "answer": "No. Start with the one that fixes your biggest gap and add more later. Every ScaleKit service is month-to-month."
    },
    {
      "question": "Does this replace my host agency tools or booking systems?",
      "answer": "No. Keep the tools your host agency provides for bookings. ScaleKit handles inquiries, follow-up and staying in touch with travelers."
    },
    {
      "question": "Who sets it up and runs it?",
      "answer": "We do. We build the system, connect your phone, forms and calendar, write the messages and keep it running."
    }
  ]}
  related={[
    {
      "label": "Travel Advisor Website Design",
      "href": "/industries/travel-advisors/website-design/",
      "description": "A site built around your specialties."
    },
    {
      "label": "Lead Follow-Up Automation",
      "href": "/services/lead-follow-up-automation/",
      "description": "Follow up on every trip quote."
    },
    {
      "label": "Database Reactivation",
      "href": "/services/reactivation/",
      "description": "Reconnect with past travelers."
    }
  ]}
  finalCta={{
    "eyebrow": "Run Your Own Numbers",
    "headline": "What Is One More Booked Trip Worth?",
    "subheadline": "Let's look at where inquiries slip away today."
  }}
/>
