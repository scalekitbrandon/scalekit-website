    },
    {
      "question": "Does this replace my roofing software?",
      "answer": "No. Keep your estimating and measurement tools. ScaleKit handles getting leads and following up with them."
    },
    {
      "question": "Who sets it up and runs it?",
      "answer": "We do. We build the system, connect your phone, forms and calendar, write the messages and keep it running."
    }
  ]}
