  description={"Marketing automation for roofing companies: website, local SEO, Google Ads, CRM, AI call answering and reactivation, built and run for you as one system."}
  serviceType={"Roofing marketing automation"}
  audience={"Roofing contractors"}
  breadcrumbs={[
    {
      "name": "Who We Work With",
      "path": "/#built-for"
    },
    {
      "name": "Roofing"
    }
  ]}
  hero={{
    "eyebrow": "For Roofing Companies",
    "headline": "Marketing Automation for Roofing Companies",
    "subheadline": "One system that gets your roofing company found, answers every lead, and follows up on every inspection and estimate. Built and run for you.",
    "checklist": [
      "Roofing website built to book inspections",
      "Google Maps rankings in the towns you serve",
      "Google Ads for repair and replacement",
      "CRM for inspections, estimates and claims",
      "AI answering for storm-season call spikes",
      "Campaigns that bring past customers back"
    ]
  }}
  blocks={[
    {
      "eyebrow": "Website",
      "heading": "A Roofing Website That Books Inspections",
      "paragraphs": [
        "Your website is where homeowners decide whether to call. We build roofing sites around repair, replacement and storm damage, with an inspection request on every page."
      ],
      "link": {
        "label": "Roofing website design",
        "href": "/industries/roofing/website-design/"
      }
    },
    {
      "eyebrow": "Local SEO",
      "heading": "Show Up in Google Maps When Homeowners Need a Roofer",
      "paragraphs": [
        "Most roofing calls start with a Maps search. Scout, our AI local SEO agent, keeps your Google Business Profile active, builds citations and requests a review after every install."
      ],
      "link": {
        "label": "Local SEO for roofers",
        "href": "/industries/roofing/local-seo/"
      }
    },
    {
      "eyebrow": "Ads",
      "heading": "Google Ads for Roof Repair and Replacement",
      "paragraphs": [
        "When a storm hits, search ads put you in front of homeowners that day. We run Google Search and Local Services Ads for the roofing jobs you want and track every call they bring in."
      ],
      "link": {
        "label": "Google & Meta Ads management",
        "href": "/services/ads/"
      }
    },
    {
      "eyebrow": "CRM & Automation",
      "heading": "A CRM Built Around Inspections, Estimates and Claims",
      "paragraphs": [
        "Track every lead from the first call through inspection, insurance claim and install. Follow-up on open estimates runs on its own while your crews are on roofs."
      ],
      "link": {
        "label": "Roofing CRM",
        "href": "/industries/roofing/crm/"
      }
    },
    {
      "eyebrow": "AI Receptionist",
      "heading": "Answer Every Call During Storm Season",
      "paragraphs": [
        "After hail or high winds, calls come in faster than any office can return them. Missed calls get a text back in seconds, and an AI receptionist can answer, take details and book the inspection."
      ],
      "link": {
        "label": "AI receptionist",
        "href": "/services/ai-agents/"
      }
    },
    {
      "eyebrow": "Reactivation",
      "heading": "Turn Past Customers and Old Estimates Into Jobs",
      "paragraphs": [
        "Past customers and estimates that never closed are worth reaching again for inspections, repairs and referrals. We run text and email campaigns that bring them back."
      ],
      "link": {
        "label": "Database reactivation",
        "href": "/services/reactivation/"
      }
    }
  ]}
  faqHeadline={"Roofing Marketing Automation Questions"}
  faq={[
    {
      "question": "What is marketing automation for a roofing company?",
      "answer": "It's the system that brings leads in and follows up with them without anyone doing it by hand: instant replies, missed call text back, follow-up sequences, review requests and reactivation, all connected to your website and ads."
    },
    {
      "question": "Do I have to use every service?",
