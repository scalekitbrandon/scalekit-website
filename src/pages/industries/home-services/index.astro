---
// Industry hub. Primary keyword: home service marketing automation. Each section links to the child page
// that owns the narrower term (website design, CRM, local SEO); see the
// keyword map in memory/decisions.md.
import KeywordPage from '../../../components/KeywordPage.astro';
---

<KeywordPage
  kind="service"
  title={"Marketing Automation for Home Service Companies | ScaleKit"}
  description={"Marketing automation for HVAC, plumbing and electrical companies: website, local SEO, ads, CRM, AI call answering and maintenance reminders, built and run for you."}
  serviceType={"Home service marketing automation"}
  audience={"HVAC, plumbing and electrical contractors"}
  breadcrumbs={[
    {
      "name": "Who We Work With",
      "path": "/#built-for"
    },
    {
      "name": "Home Services"
    }
  ]}
  hero={{
    "eyebrow": "For HVAC, Plumbing & Electrical",
    "headline": "Marketing Automation for Home Service Companies",
    "subheadline": "Answer every service call, follow up on every replacement quote, and keep maintenance customers coming back. Built and run for you.",
    "checklist": [
      "Website with a page for every service",
      "Google Maps rankings for your trade",
      "Google Ads and Local Services Ads",
      "CRM for quotes and maintenance plans",
      "AI answering for after-hours calls",
      "Seasonal tune-up and renewal reminders"
    ]
  }}
  blocks={[
    {
      "eyebrow": "Website",
      "heading": "A Home Services Website With a Page for Every Service",
      "paragraphs": [
        "Homeowners search for \"AC repair\" or \"water heater replacement,\" not \"home services.\" We build a page for each service and area, with click-to-call and booking on every screen."
      ],
      "link": {
        "label": "Home services website design",
        "href": "/industries/home-services/website-design/"
      }
    },
    {
      "eyebrow": "Local SEO",
      "heading": "Rank in Google Maps for Your Trade",
      "paragraphs": [
        "Scout keeps your Google Business Profile, citations and reviews working every day, so you show up when someone nearby searches for a plumber, electrician or HVAC company."
      ],
      "link": {
        "label": "AI local SEO agent",
        "href": "/scout/"
      }
    },
    {
      "eyebrow": "Ads",
      "heading": "Google Ads and Local Services Ads for Service Calls",
      "paragraphs": [
        "Search ads and Local Services Ads put you at the top for urgent repairs. We focus spend on the jobs you want and track every call back to the ad that brought it."
      ],
      "link": {
        "label": "Google & Meta Ads management",
        "href": "/services/ads/"
      }
    },
    {
      "eyebrow": "CRM & Automation",
      "heading": "A CRM That Wins the Job Before Dispatch",
      "paragraphs": [
        "Your field service software runs the job. Our CRM wins it: instant lead response, follow-up on every replacement quote, and maintenance plan renewals."
      ],
      "link": {
        "label": "Home service CRM",
        "href": "/industries/home-services/crm/"
      }
    },
    {
      "eyebrow": "AI Receptionist",
      "heading": "Answer Every Service Call, Even After Hours",
      "paragraphs": [
        "When every tech is on a job, calls still get answered. An AI receptionist books the visit or flags emergencies, and missed calls get a text back in seconds."
      ],
      "link": {
        "label": "AI receptionist",
        "href": "/services/ai-agents/"
      }
    },
    {
      "eyebrow": "Reactivation",
      "heading": "Fill Slow Seasons With Past Customers",
      "paragraphs": [
        "Tune-up reminders before heating and cooling season, and campaigns for upgrades like new systems or panels, go to the customers who already trust you."
      ],
      "link": {
        "label": "Database reactivation",
        "href": "/services/reactivation/"
      }
    }
  ]}
  faqHeadline={"Home Service Marketing Automation Questions"}
  faq={[
    {
      "question": "What is marketing automation for a home service company?",
      "answer": "It's the system that brings leads in and follows up with them without anyone doing it by hand: instant replies, missed call text back, follow-up sequences, review requests and reactivation, all connected to your website and ads."
    },
    {
      "question": "Do I have to use every service?",
      "answer": "No. Start with the one that fixes your biggest gap and add more later. Every ScaleKit service is month-to-month."
    },
    {
      "question": "Does this replace ServiceTitan, Jobber or Housecall Pro?",
      "answer": "No. Keep your field service software for dispatch and invoicing. ScaleKit handles getting leads and following up until the job is booked."
    },
    {
      "question": "Who sets it up and runs it?",
      "answer": "We do. We build the system, connect your phone, forms and calendar, write the messages and keep it running."
    }
  ]}
  related={[
    {
      "label": "Home Services Website Design",
      "href": "/industries/home-services/website-design/",
      "description": "A site with a page for every service."
    },
    {
      "label": "Home Service CRM",
      "href": "/industries/home-services/crm/",
      "description": "Win more jobs before dispatch."
    },
    {
      "label": "Missed Call Text Back",
      "href": "/services/missed-call-text-back/",
      "description": "Text every caller you missed."
    }
  ]}
  finalCta={{
    "eyebrow": "Run Your Own Numbers",
    "headline": "How Many Service Calls Went to Voicemail Last Month?",
    "subheadline": "Let's find the leaks and close them."
  }}
/>
