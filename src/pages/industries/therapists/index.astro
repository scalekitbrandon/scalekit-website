---
// Industry hub. Primary keyword: marketing automation for therapists. Each section links to the child page
// that owns the narrower term (website design, CRM, local SEO); see the
// keyword map in memory/decisions.md.
import KeywordPage from '../../../components/KeywordPage.astro';
---

<KeywordPage
  kind="service"
  title={"Marketing Automation for Therapists | ScaleKit"}
  description={"Marketing automation for therapists and private practices: website, local search, ads, inquiry follow-up and consultation booking, built and run for you."}
  serviceType={"Marketing automation for therapists"}
  audience={"Therapists and private practices"}
  breadcrumbs={[
    {
      "name": "Who We Work With",
      "path": "/#built-for"
    },
    {
      "name": "Therapists"
    }
  ]}
  hero={{
    "eyebrow": "For Therapists & Private Practices",
    "headline": "Marketing Automation for Therapists and Private Practices",
    "subheadline": "Help the right clients find you, answer every inquiry quickly and gently, and keep your calendar full without spending your evenings on admin.",
    "checklist": [
      "Website that builds trust before the first call",
      "Show up in local search for your specialties",
      "Ads for the clients you want to see",
      "Inquiry follow-up and consultation booking",
      "After-hours answers to common questions",
      "Gentle check-ins with people who never booked"
    ]
  }}
  blocks={[
    {
      "eyebrow": "Website",
      "heading": "A Website That Builds Trust Before the First Session",
      "paragraphs": [
        "People choose a therapist by how they feel reading your site. We build calm, clear sites around your specialties and approach, with an easy way to request a consultation."
      ],
      "link": {
        "label": "Therapist website design",
        "href": "/industries/therapists/website-design/"
      }
    },
    {
      "eyebrow": "Local Search",
      "heading": "Get Found by People Searching for Help Near You",
      "paragraphs": [
        "Many clients search for a therapist near them or for a specialty like anxiety or couples counseling. Scout keeps your Google Business Profile and local listings complete and active."
      ],
      "link": {
        "label": "AI local SEO agent",
        "href": "/scout/"
      }
    },
    {
      "eyebrow": "Ads",
      "heading": "Ads for the Clients You Want to Work With",
      "paragraphs": [
        "Focused search ads for your specialties and area, so your budget goes toward the people you are best placed to help."
      ],
      "link": {
        "label": "Google & Meta Ads management",
        "href": "/services/ads/"
      }
    },
    {
      "eyebrow": "Inquiry Follow-Up",
      "heading": "Respond to Every Inquiry Quickly and Kindly",
      "paragraphs": [
        "Someone reaching out for therapy has often waited a long time to do it. Every inquiry gets a prompt, warm reply with a link to book a consultation, even when you are in session."
      ],
      "link": {
        "label": "Lead follow-up automation",
        "href": "/services/lead-follow-up-automation/"
      }
    },
    {
      "eyebrow": "AI Agents",
      "heading": "Answer Scheduling Questions After Hours",
      "paragraphs": [
        "An AI assistant can answer common questions about availability, fees and insurance, and help people book a consultation, so routine questions do not wait until your next break."
      ],
      "link": {
        "label": "AI agents",
        "href": "/services/ai-agents/"
      }
    },
    {
      "eyebrow": "Reconnect",
      "heading": "Check In With People Who Inquired but Never Booked",
      "paragraphs": [
        "Many people reach out and then pause. A gentle, well-timed check-in lets them know the door is still open, without pressure."
      ],
      "link": {
        "label": "Database reactivation",
        "href": "/services/reactivation/"
      }
    }
  ]}
  faqHeadline={"Therapist Marketing Automation Questions"}
  faq={[
    {
      "question": "What is marketing automation for a therapy practice?",
      "answer": "It's the system that brings leads in and follows up with them without anyone doing it by hand: instant replies, missed call text back, follow-up sequences, review requests and reactivation, all connected to your website and ads."
    },
    {
      "question": "Do I have to use every service?",
      "answer": "No. Start with the one that fixes your biggest gap and add more later. Every ScaleKit service is month-to-month."
    },
    {
      "question": "What about client privacy?",
      "answer": "These automations are built for inquiries and scheduling, not clinical records. On the strategy call we go over what information should and should not flow through them, so clinical details stay in your practice management system."
    },
    {
      "question": "Who sets it up and runs it?",
      "answer": "We do. We build the system, connect your phone, forms and calendar, write the messages and keep it running."
    }
  ]}
  related={[
    {
      "label": "Therapist Website Design",
      "href": "/industries/therapists/website-design/",
      "description": "A site that builds trust before the first session."
    },
    {
      "label": "Lead Follow-Up Automation",
      "href": "/services/lead-follow-up-automation/",
      "description": "Reply to every inquiry, even mid-session."
    },
    {
      "label": "Google Business Profile Management",
      "href": "/services/google-business-profile-management/",
      "description": "Keep your local listing complete."
    }
  ]}
  finalCta={{
    "eyebrow": "Find Out Where You Stand",
    "headline": "How Many Inquiries Waited Too Long for a Reply?",
    "subheadline": "Let's set up a system that answers for you while you're with clients."
  }}
  websiteSamples={[
    {
      "label": "Brooklyn Therapy Services",
      "addressLabel": "brooklyntherapyservices.com",
      "src": "https://brooklyntherapyservices.com",
      "href": "https://brooklyntherapyservices.com"
    },
    {
      "label": "Margot Hale Therapy",
      "addressLabel": "margothaletherapy.com",
      "src": "/preview/margot-hale/",
      "href": "/preview/margot-hale/"
    },
    {
      "label": "Ashford Therapy",
      "addressLabel": "ashfordtherapy.com",
      "src": "/preview/ashford-therapy/",
      "href": "/preview/ashford-therapy/"
    }
  ]}
/>
