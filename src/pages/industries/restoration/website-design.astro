---
import RelatedLinks from '../../../components/RelatedLinks.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import IndustryHero from '../../../components/IndustryHero.astro';
import TemplateShowcase from '../../../components/TemplateShowcase.astro';
import ProcessCircles from '../../../components/ProcessCircles.astro';
import FinalCta from '../../../components/FinalCta.astro';
import BookCall from '../../../components/BookCall.astro';
import Footer from '../../../components/Footer.astro';
import RestorationSample from '../../../components/samples/RestorationSample.astro';
import AnchorSample from '../../../components/samples/AnchorSample.astro';
import PaintingSample from '../../../components/samples/PaintingSample.astro';
import RoofingSample from '../../../components/samples/RoofingSample.astro';
import LandscapingSample from '../../../components/samples/LandscapingSample.astro';
import { makeFooterGroups } from '../../../data/site-nav';

const siteUrl = Astro.site.origin;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Restoration & Remodeling Websites & Funnels',
    name: 'Website Design for Restoration & Remodeling Companies',
    description: 'ScaleKit builds restoration and remodeling companies a site and lead system built for the moment it matters most.',
    url: `${siteUrl}/industries/restoration/website-design/`,
    provider: { '@type': 'ProfessionalService', name: 'ScaleKit', url: siteUrl },
  },
];

const headerNav = {
  services: [
    { label: 'Websites & Funnels', href: '/#websites-funnels' },
    { label: 'Local SEO', href: '/scout/' },
    { label: 'Google & Meta Ads', href: '/services/ads/' },
    { label: 'CRM & Automation', href: '/services/automation/' },
    { label: 'Reactivation', href: '/services/reactivation/' },
    { label: 'AI Agents & Solutions', href: '/services/ai-agents/' },
    { label: 'AI Receptionist', href: '/services/ai-receptionist/' },
  ],
  links: [
    { label: 'Features', href: '/features/' },
    { label: 'How We Work', href: '/#process' },
    { label: 'Who We Work With', href: '/#built-for' },
    { label: 'Pricing', href: '/pricing/' },
  ],
};

const footerGroups = makeFooterGroups();
---

<BaseLayout
  title="Restoration Website Design & Lead Response | ScaleKit"
  description="ScaleKit builds restoration and remodeling companies a site and lead-response system built for the moment it matters most."
  structuredData={structuredData}
>
  <Header slot="header" homeHref="/" services={headerNav.services} links={headerNav.links} />

  <IndustryHero
    eyebrow="For Restoration & Remodeling Companies"
    headline="Restoration Website Design That Makes You the First Call"
    subheadline="When a pipe bursts, homeowners call whoever answers first and looks the most trustworthy online. We build restoration companies a site and lead system built for the moment it matters most."
    checklist={[
      'Lightning-fast load times',
      'Mobile-first on every device',
      'Technical SEO from day one',
      'Ranks in Google & AI search',
      'Live in days, not months',
      'High-conversion copywriting',
      'Built to convert, not just look good',
      'Unlimited review requests',
      'Connected straight to your CRM',
      'Instant lead form engagement',
    ]}
  />

  <TemplateShowcase
    addressLabel="yourrestorationco.com"
    sampleLabels={[
      'yourhomeservicesco.com',
      'brushhourpaintingtexas.com',
      'yourroofingcompany.com',
      'yourlandscapingco.com',
    ]}
  >
    <RestorationSample />
    <Fragment slot="sample-1"><AnchorSample /></Fragment>
    <Fragment slot="sample-2"><PaintingSample /></Fragment>
    <Fragment slot="sample-3"><RoofingSample /></Fragment>
    <Fragment slot="sample-4"><LandscapingSample /></Fragment>
  </TemplateShowcase>

  <ProcessCircles />
  <RelatedLinks heading="More for Restoration Companies" links={[
      { label: 'Marketing Automation for Restoration Companies', href: '/industries/restoration/', description: 'Everything we do for restoration companies, in one system.' },
      { label: 'Restoration CRM', href: '/industries/restoration/crm/', description: 'Track every job from emergency call to rebuild.' },
      { label: 'AI Receptionist', href: '/services/ai-agents/', description: 'Answer every emergency call, 24/7.' },
      { label: 'Missed Call Text Back', href: '/services/missed-call-text-back/', description: 'Text every caller you missed within seconds.' },
    ]} />


  <FinalCta
    eyebrow="Run Your Own Numbers"
    headline="What's One More Emergency Call Actually Worth?"
    subheadline="Every minute a panicked homeowner waits for a callback is a minute your competitor has to answer first. ScaleKit makes sure that's you."
  />

  <BookCall />

  <Footer
    slot="footer"
    logoText="ScaleKit"
    tagline="Not a bundle of connected tools. One team that builds, ranks, and grows your business, start to finish."
    contactEmail="hello@scalekit.io"
    groups={footerGroups}
  />
</BaseLayout>
