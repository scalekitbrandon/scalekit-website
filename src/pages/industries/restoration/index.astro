---
// Industry hub. Primary keyword: restoration marketing automation. Each section links to the child page
// that owns the narrower term (website design, CRM, local SEO); see the
// keyword map in memory/decisions.md.
import KeywordPage from '../../../components/KeywordPage.astro';
---

<KeywordPage
  kind="service"
  title={"Marketing Automation for Restoration Companies | ScaleKit"}
  description={"Marketing automation for water, fire and mold restoration companies: website, local SEO, ads, CRM, 24/7 AI call answering and referral partner follow-up."}
  serviceType={"Restoration marketing automation"}
  audience={"Restoration contractors"}
  breadcrumbs={[
    {
      "name": "Who We Work With",
      "path": "/#built-for"
    },
    {
      "name": "Restoration"
    }
  ]}
  hero={{
    "eyebrow": "For Restoration Companies",
    "headline": "Marketing Automation for Restoration Companies",
    "subheadline": "Be the first company that answers when a pipe bursts at 2am, and keep every job and referral partner moving after that. Built and run for you.",
    "checklist": [
      "Website built for emergency calls",
      "Google Maps rankings for water and fire damage",
      "Ads that run when emergencies happen",
      "CRM from emergency call to rebuild",
      "24/7 AI call answering",
      "Follow-up with plumbers, agents and past customers"
    ]
  }}
  blocks={[
    {
      "eyebrow": "Website",
      "heading": "A Restoration Website Built for Emergencies",
      "paragraphs": [
        "Homeowners in an emergency need one thing: a number to call right now. We build restoration sites with click-to-call everywhere, clear emergency services and proof that you show up fast."
      ],
      "link": {
        "label": "Restoration website design",
        "href": "/industries/restoration/website-design/"
      }
    },
    {
      "eyebrow": "Local SEO",
      "heading": "Rank in Google Maps for Water and Fire Damage",
      "paragraphs": [
        "When water is on the floor, people search \"water damage restoration near me\" and call one of the first results. Scout keeps your Google Business Profile, reviews and citations working so you are one of them."
      ],
      "link": {
        "label": "AI local SEO agent",
        "href": "/scout/"
      }
    },
    {
      "eyebrow": "Ads",
      "heading": "Ads That Catch Emergency Searches",
      "paragraphs": [
        "Google Search and Local Services Ads put you at the top for urgent searches. We set them up for the jobs you want and track every call so you know what each job cost."
      ],
      "link": {
        "label": "Google & Meta Ads management",
        "href": "/services/ads/"
      }
    },
    {
      "eyebrow": "CRM & Automation",
      "heading": "Track Every Job From Emergency Call to Rebuild",
      "paragraphs": [
        "One pipeline for mitigation, claims and rebuild, with automatic updates to homeowners and the referral source recorded on every job."
      ],
      "link": {
        "label": "Restoration CRM",
        "href": "/industries/restoration/crm/"
      }
    },
    {
      "eyebrow": "AI Receptionist",
      "heading": "Answer Every Emergency Call, Day or Night",
      "paragraphs": [
        "An AI receptionist answers after hours, collects the address and type of damage, and alerts your on-call tech. Missed calls get a text back in seconds."
      ],
      "link": {
        "label": "AI receptionist",
        "href": "/services/ai-agents/"
      }
    },
    {
      "eyebrow": "Reactivation",
      "heading": "Stay in Touch With Referral Partners and Past Customers",
      "paragraphs": [
        "Plumbers, insurance agents and property managers send much of your work. Automated check-ins and thank-yous keep you top of mind, and past customers hear from you before the next storm season."
      ],
      "link": {
        "label": "Database reactivation",
        "href": "/services/reactivation/"
      }
    }
  ]}
  faqHeadline={"Restoration Marketing Automation Questions"}
  faq={[
    {
      "question": "What is marketing automation for a restoration company?",
      "answer": "It's the system that brings leads in and follows up with them without anyone doing it by hand: instant replies, missed call text back, follow-up sequences, review requests and reactivation, all connected to your website and ads."
    },
    {
      "question": "Do I have to use every service?",
      "answer": "No. Start with the one that fixes your biggest gap and add more later. Every ScaleKit service is month-to-month."
    },
    {
      "question": "Does this replace my job management software?",
      "answer": "No. Keep the software you use for estimates and documentation. ScaleKit handles calls, leads, follow-up and referral partners."
    },
    {
      "question": "Who sets it up and runs it?",
      "answer": "We do. We build the system, connect your phone, forms and calendar, write the messages and keep it running."
    }
  ]}
  related={[
    {
      "label": "Restoration Website Design",
      "href": "/industries/restoration/website-design/",
      "description": "A site built to be the first call."
    },
    {
      "label": "Restoration CRM",
      "href": "/industries/restoration/crm/",
      "description": "Track jobs from emergency call to rebuild."
    },
    {
      "label": "AI Receptionist",
      "href": "/services/ai-agents/",
      "description": "Answer every emergency call, 24/7."
    }
  ]}
  finalCta={{
    "eyebrow": "Run Your Own Numbers",
    "headline": "What Is One Missed Emergency Call Worth?",
    "subheadline": "Let's make sure the next one gets answered."
  }}
/>
