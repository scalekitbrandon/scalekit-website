---
// Trust badges live UNDER the image, scoped to the image column width — not
// a separate full-width section. Confirmed via reference screenshot; the
// first pass wrongly split this into two disconnected pieces.
const ICONS: Record<string, string> = {
  shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  award: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>',
};

interface ButtonItem {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary';
}

interface TrustItem {
  icon: keyof typeof ICONS;
  label: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading: string;
  body: string;
  body2?: string;
  bullets?: string[];
  buttons?: ButtonItem[];
  imageAlt?: string;
  imageSrc?: string;
  trustHeading?: string;
  trustItems?: TrustItem[];
}

const {
  id, eyebrow, heading, body, body2, bullets = [], buttons = [], imageAlt = '', imageSrc,
  trustHeading, trustItems = [],
} = Astro.props;
---

<section class="split-content" id={id}>
  <div class="container split-inner">
    <div class="split-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{heading}</h2>
      <p>{body}</p>
      {body2 && <p>{body2}</p>}
      {bullets.length > 0 && (
        <ul class="checklist">
          {bullets.map((b) => <li>✓ {b}</li>)}
        </ul>
      )}
      {buttons.length > 0 && (
        <div class="split-buttons">
          {buttons.map((b) => (
            <a class:list={['btn', b.variant ?? 'primary']} href={b.href}>{b.label}</a>
          ))}
        </div>
      )}
    </div>
    <div class="split-media">
      {imageSrc ? <img src={imageSrc} alt={imageAlt} /> : <div class="media-placeholder" aria-hidden="true" />}
      {trustItems.length > 0 && (
        <div class="trust">
          {trustHeading && <p class="trust-heading">{trustHeading}</p>}
          <div class="trust-row">
            {trustItems.map((item) => (
              <div class="trust-card">
                <span class="trust-icon" set:html={ICONS[item.icon]} />
                <span class="trust-label">{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .split-content { padding-block: var(--space-7); }
  .split-inner {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: var(--space-7);
    align-items: start;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-button);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }
  h2 {
    font-size: 3rem;
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }
  p {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
    opacity: 0.85;
  }
  .checklist {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-4);
  }
  .checklist li {
    font-size: var(--text-base);
    margin-bottom: 8px;
    opacity: 1;
  }
  .split-buttons {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .btn {
    display: inline-block;
    padding: 16px 28px;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--font-weight-button);
    text-decoration: none;
  }
  .btn.primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }
  .btn.secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
  }
  .split-media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }
  .media-placeholder {
    width: 100%;
    aspect-ratio: 3 / 2;
    background: var(--color-muted);
    border-radius: var(--radius-lg);
  }
  .trust { margin-top: var(--space-5); text-align: center; }
  .trust-heading {
    font-weight: var(--font-weight-max);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }
  .trust-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .trust-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }
  .trust-icon {
    display: flex;
    width: 32px;
    height: 32px;
    color: var(--color-primary);
  }
  .trust-icon :global(svg) { width: 100%; height: 100%; }
  .trust-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-button);
    text-align: center;
  }
  @media (max-width: 768px) {
    .split-inner { grid-template-columns: 1fr; }
    .trust-row { grid-template-columns: 1fr; }
  }
</style>
