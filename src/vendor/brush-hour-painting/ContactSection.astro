---
// Sizing/spacing matched to reference: bigger heading, info-card icons
// centered against the text block (not top-aligned), bigger phone/email
// "value" line, larger "Ready to Get Started?" card.
// Deliberate deviation from the reference, per explicit request: the right
// card is now a real lead-capture form (name/email/phone/address/service),
// not just a checklist + links. "Get Your Free Quote" submits the form;
// "Call" stays a plain tel: link outside it.
// TODO before launch: wire `action` to a real endpoint.
interface InfoCard {
  icon?: string;
  title: string;
  value: string;
  detail?: string;
}

interface Props {
  id?: string;
  heading: string;
  headingAccent: string;
  subheading?: string;
  infoCards: InfoCard[];
  ctaHeading: string;
  ctaBody: string;
  ctaBullets: string[];
  services?: string[];
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref?: string;
  variant?: 'form' | 'checklist';
}

const {
  id, heading, headingAccent, subheading, infoCards,
  ctaHeading, ctaBody, ctaBullets, services = [],
  primaryLabel, primaryHref, secondaryLabel, secondaryHref,
  variant = 'form',
} = Astro.props;
---

<section class="contact" id={id}>
  <div class="container">
    <h2>{heading} <span class="accent">{headingAccent}</span></h2>
    {subheading && <p class="subheading">{subheading}</p>}
    <div class="contact-grid">
      <div class="info-cards">
        {infoCards.map((card) => (
          <div class="info-card">
            {card.icon && <span class="icon" aria-hidden="true">{card.icon}</span>}
            <div>
              <p class="title">{card.title}</p>
              <p class="value">{card.value}</p>
              {card.detail && <p class="detail">{card.detail}</p>}
            </div>
          </div>
        ))}
      </div>
      <div class="cta-card">
        <h3>{ctaHeading}</h3>
        <p>{ctaBody}</p>
        <ul>
          {ctaBullets.map((b) => <li>✓ {b}</li>)}
        </ul>
        {variant === 'form' ? (
          <form action="#" method="POST">
            <input type="text" name="name" placeholder="Full Name" required />
            <input type="email" name="email" placeholder="Email Address" required />
            <input type="tel" name="phone" placeholder="Phone Number" required />
            <input type="text" name="address" placeholder="Property Address" />
            <select name="service" required>
              <option value="" disabled selected>Service Needed</option>
              {services.map((s) => <option value={s}>{s}</option>)}
            </select>
            <div class="cta-buttons">
              <a class="btn white" href={primaryHref}>{primaryLabel}</a>
              <button type="submit" class="btn outline">{secondaryLabel}</button>
            </div>
          </form>
        ) : (
          <div class="cta-buttons">
            <a class="btn white" href={primaryHref}>{primaryLabel}</a>
            <a class="btn outline" href={secondaryHref}>{secondaryLabel}</a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: var(--space-7); }
  /* Measured directly from the live reference site via DevTools (not
     estimated): heading computes to 48px/3rem, subheading to 20px/1.25rem,
     at a matching 16px root font-size — used here as exact values. */
  h2 { font-size: 3rem; text-align: center; margin-bottom: var(--space-3); }
  .accent { color: var(--color-primary); }
  .subheading { font-size: var(--text-lg); text-align: center; opacity: 0.75; max-width: 560px; margin: 0 auto var(--space-6); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: stretch;
  }
  .info-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .info-card {
    display: flex;
    gap: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    align-items: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .info-card .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    font-size: var(--text-base);
    border-radius: 50%;
    background: var(--color-muted);
    flex-shrink: 0;
  }
  .title { font-weight: var(--font-weight-button); margin-bottom: 2px; }
  .value {
    font-size: var(--text-base);
    font-weight: var(--font-weight-button);
    color: var(--color-primary);
  }
  .detail { font-size: var(--text-sm); opacity: 0.7; margin-top: 2px; }
  .cta-card {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }
  .cta-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .cta-card p { opacity: 0.9; margin-bottom: var(--space-3); }
  .cta-card ul { list-style: none; padding: 0; margin-bottom: var(--space-4); }
  .cta-card li { margin-bottom: var(--space-1); font-size: var(--text-base); }
  .cta-card form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cta-card input,
  .cta-card select {
    width: 100%;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-fg);
    font-family: var(--font-body);
    font-size: var(--text-base);
  }
  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 14px;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--font-weight-button);
    text-decoration: none;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .btn.white { background: var(--color-bg); color: var(--color-primary); border: none; }
  .btn.outline { background: transparent; color: var(--color-primary-fg); border: 1px solid rgba(255,255,255,0.6); }
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
