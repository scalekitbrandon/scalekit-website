---
// Sizing/spacing matched to reference. One deliberate deviation from it,
// per explicit request: locations render as a 3-column list of text links
// to each area's future page, not pill badges. Those /service-areas/<slug>
// routes aren't built yet (phased build, Home only) — links are wired to
// the intended real URL pattern now so nothing needs re-wiring later, but
// they 404 until that page pass happens.
interface Props {
  id?: string;
  heading: string;
  intro?: string;
  locations: string[];
  footnote?: string;
  mapQuery?: string;
}

const { id, heading, intro, locations, footnote, mapQuery } = Astro.props;

const slugify = (s: string) => s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<section class="locations" id={id}>
  <div class="container locations-inner">
    <div class="locations-text">
      <h2>{heading}</h2>
      {intro && <p class="intro">{intro}</p>}
      <p class="areas-label">Areas We Serve:</p>
      <div class="location-links">
        {locations.map((loc) => (
          <a class="location-link" href={`/service-areas/${slugify(loc)}`}>{loc}</a>
        ))}
      </div>
      {footnote && <p class="footnote">{footnote}</p>}
    </div>
    <div class="map">
      {mapQuery ? (
        <iframe
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`}
          title="Service area map"
        ></iframe>
      ) : (
        <div class="map-placeholder">Map pending</div>
      )}
    </div>
  </div>
</section>

<style>
  .locations { padding-block: var(--space-8); background: var(--color-muted); }
  .locations-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: stretch;
  }
  .locations-text {
    display: flex;
    flex-direction: column;
  }
  h2 {
    font-size: 3rem;
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }
  .intro {
    font-size: var(--text-lg);
    opacity: 0.75;
    margin-bottom: var(--space-5);
    max-width: 46ch;
  }
  .areas-label {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-button);
    margin-bottom: var(--space-3);
  }
  .location-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }
  .location-link {
    color: var(--color-primary);
    font-weight: var(--font-weight-button);
    text-decoration: none;
  }
  .location-link:hover { text-decoration: underline; }
  .footnote {
    font-size: var(--text-base);
    font-style: italic;
    opacity: 0.7;
    margin-top: auto;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
    display: block;
  }
  .map-placeholder {
    width: 100%;
    height: 100%;
    min-height: 420px;
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
  }
  @media (max-width: 768px) {
    .locations-inner { grid-template-columns: 1fr; }
    .location-links { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .location-links { grid-template-columns: 1fr; }
  }
</style>
