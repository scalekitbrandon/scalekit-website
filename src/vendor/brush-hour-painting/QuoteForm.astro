---
// Simplified from the reference's 3-step wizard into a single-step form —
// per explicit request, faster to fill out: every field visible at once
// (name, phone, email, address, service), one submit action, no clicking
// through steps.
// TODO before launch: wire `action` to a real endpoint.
interface Props {
  heading?: string;
  subheading?: string;
  services?: string[];
  mode?: 'services' | 'describe';
}

const {
  heading = 'Request Your Free Quote!',
  subheading = 'Someone From Our Team Will Be In Contact With You Today',
  services = [],
  mode = 'services',
} = Astro.props;
---

<div class="quote-card" id="quote">
  <div class="quote-card-header">
    <h2>{heading}</h2>
    <p>{subheading}</p>
  </div>
  <form class="quote-card-body" action="#" method="POST">
    <div class="field-row">
      <input type="text" name="name" placeholder="Full Name" required />
      <input type="tel" name="phone" placeholder="Phone Number" required />
    </div>
    <input type="email" name="email" placeholder="Email Address" required />
    <input type="text" name="address" placeholder="Property Address" />
    {mode === 'services' ? (
      <select name="service" required>
        <option value="" disabled selected>What do you need painted?</option>
        {services.map((s) => <option value={s}>{s}</option>)}
      </select>
    ) : (
      <textarea name="details" placeholder="Describe Your Project" rows="4" required />
    )}

    <button type="submit" class="btn primary">Get My Free Quote</button>
  </form>
</div>

<style>
  .quote-card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }
  .quote-card-header {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    text-align: center;
    padding: var(--space-4);
  }
  .quote-card-header h2 {
    font-size: var(--text-lg);
    margin-bottom: 4px;
  }
  .quote-card-header p {
    font-size: var(--text-sm);
    opacity: 0.9;
  }
  .quote-card-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .quote-card-body input,
  .quote-card-body select,
  .quote-card-body textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-body);
    font-size: var(--text-base);
  }
  @media (max-width: 480px) {
    .field-row { grid-template-columns: 1fr; }
  }
  .quote-card-body textarea {
    resize: vertical;
    min-height: 90px;
  }
  .btn.primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    border: none;
    padding: 14px;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--font-weight-button);
    cursor: pointer;
  }
</style>
