---
// No real project photos provided yet — renders labeled placeholders.
// Swap `images` for real src/alt/title/caption before launch.
// Matches reference: 3-column grid (not a cramped scroll strip), arrows
// positioned at the outer section edges, card body (title+caption) sits
// below the image on a white background — not overlaid on the photo.
interface GalleryImage {
  src?: string;
  alt: string;
  title: string;
  caption: string;
}

interface Props {
  heading?: string;
  subheading?: string;
  images: GalleryImage[];
  ctaText?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { heading, subheading, images, ctaText, ctaLabel, ctaHref } = Astro.props;
---

<section class="gallery">
  <div class="container">
    {heading && <h2>{heading}</h2>}
    {subheading && <p class="subheading">{subheading}</p>}
    <div class="carousel-wrap">
      <button class="arrow prev" type="button" aria-label="Previous project">‹</button>
      <div class="track">
        {images.map((img) => (
          <figure>
            {img.src ? (
              <img src={img.src} alt={img.alt} loading="lazy" />
            ) : (
              <div class="placeholder" role="img" aria-label={img.alt}>{img.alt}</div>
            )}
            <figcaption>
              <p class="title">{img.title}</p>
              <p class="caption">{img.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <button class="arrow next" type="button" aria-label="Next project">›</button>
    </div>
    {ctaText && (
      <div class="gallery-cta">
        <p>{ctaText}</p>
        {ctaLabel && ctaHref && <a class="btn primary" href={ctaHref}>{ctaLabel}</a>}
      </div>
    )}
  </div>
</section>

<style>
  .gallery { padding-block: var(--space-7); }
  h2 {
    font-size: 3rem;
    text-align: center;
    margin-bottom: var(--space-2);
  }
  .subheading {
    text-align: center;
    font-size: var(--text-lg);
    opacity: 0.7;
    margin-bottom: var(--space-6);
  }
  .carousel-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    min-width: 0;
    gap: var(--space-4);
    flex: 1;
  }
  figure {
    margin: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--color-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-2);
    font-size: var(--text-sm);
    opacity: 0.6;
  }
  figcaption { padding: var(--space-4); }
  .title { font-size: var(--text-lg); font-weight: var(--font-weight-button); margin-bottom: var(--space-1); }
  .caption { font-size: var(--text-sm); opacity: 0.7; }
  .arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-primary);
    background: var(--color-bg);
    color: var(--color-primary);
    font-size: var(--text-xl);
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }
  .arrow:hover { background: var(--color-primary); color: var(--color-primary-fg); }
  .gallery-cta {
    text-align: center;
    margin-top: var(--space-7);
  }
  .gallery-cta p {
    opacity: 0.75;
    margin-bottom: var(--space-4);
  }
  .btn.primary {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    padding: 14px 28px;
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-button);
    text-decoration: none;
  }
  @media (max-width: 900px) {
    .track { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .track { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.carousel-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('.track');
    const prev = wrap.querySelector<HTMLButtonElement>('.prev');
    const next = wrap.querySelector<HTMLButtonElement>('.next');
    if (!track || !prev || !next) return;
    const scrollByCard = (dir: number) => {
      const card = track.querySelector('figure');
      const distance = card ? card.clientWidth + 16 : 280;
      track.scrollBy({ left: dir * distance, behavior: 'smooth' });
    };
    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
  });
</script>
