---
// CSS-only accordion via native <details>/<summary> — zero JS, matches
// Astro's zero-JS-by-default default rather than a hydrated component.
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  items: FAQItem[];
}

const { heading = 'Frequently Asked Questions', items } = Astro.props;
---

<section class="faq">
  <div class="container faq-inner">
    <h2>{heading}</h2>
    {items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq { padding-block: var(--space-7); }
  .faq-inner { max-width: 900px; }
  /* Heading matches the site-wide 3rem standard used on every other section
     (overrides the reference's smaller 28px — consistency across sections
     takes priority here). Question text stays at the measured 18px. */
  h2 { font-size: 3rem; text-align: center; margin-bottom: var(--space-6); }
  details {
    background: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-3);
  }
  summary {
    cursor: pointer;
    font-size: 1.125rem;
    font-weight: var(--font-weight-button);
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+';
    float: right;
    color: var(--color-fg);
    opacity: 0.5;
    font-size: var(--text-xl);
    font-weight: 400;
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    font-size: var(--text-base);
    margin-top: var(--space-3);
    opacity: 0.85;
  }
</style>
