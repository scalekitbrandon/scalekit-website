---
// Harborline Home Co. — Hero. This is the template's real functional
// differentiator from Anchor's video hero: a split-screen layout (photo
// + trust bullets on the left, a genuinely interactive instant-estimate
// calculator card on the right) instead of a single full-bleed media
// background with a decorative quote badge.
// The calculator is REAL client-side functionality (computes a range
// from the visitor's own inputs using a plain per-sqft rate table
// defined below) — not a fabricated claim about a real business, and
// not wired to any backend or real pricing data. Same honesty
// discipline as every other template's placeholder forms: clearly a
// demo, nothing invented about Harborline itself.
// PLACEHOLDER: heroImageUrl — bracket-placeholder convention, falls
// back to a brand-toned gradient until a real photo is supplied.
interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  trustPoints?: string[];
  heroImageUrl?: string;
  calcHeadline?: string;
  calcSubheadline?: string;
}

const {
  eyebrow = 'Home Services, Clearly Priced',
  headline = 'Know Your Price Before We Ever Knock',
  subheadline = "Most companies make you wait days for a callback just to hear a number. Get a real estimate range right now — no phone tag required.",
  trustPoints = ['Licensed & insured', 'Free in-home confirmation visit', 'No obligation to book'],
  heroImageUrl = '[HERO_IMAGE_URL]',
  calcHeadline = 'Get Your Instant Estimate',
  calcSubheadline = 'Answer three questions for a real price range.',
} = Astro.props;

const hasImage = !heroImageUrl.startsWith('[');

const serviceOptions = [
  { value: 'painting', label: 'Exterior Painting', low: 2.75, high: 3.75 },
  { value: 'roofing', label: 'Roof Repair', low: 6.5, high: 9 },
  { value: 'decks', label: 'Decks & Patios', low: 28, high: 38 },
  { value: 'remodel', label: 'Full Exterior Remodel', low: 45, high: 65 },
];
---

<section class="hl-hero" id="home">
  <div class="hero-inner">
    <div
      class="hero-photo"
      style={hasImage ? `background-image: url('${heroImageUrl}');` : ''}
    >
      <div class="photo-scrim"></div>
      <div class="photo-content">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="headline">{headline}</h1>
        <p class="sub">{subheadline}</p>
        <ul class="trust-list">
          {trustPoints.map((t) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="#DE9A5C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="calc-card">
      <p class="calc-eyebrow">Instant Estimate</p>
      <h2 class="calc-headline">{calcHeadline}</h2>
      <p class="calc-sub">{calcSubheadline}</p>

      <form class="calc-form" data-estimate-form>
        <label class="field">
          <span>Project type</span>
          <select data-estimate-service required>
            {serviceOptions.map((opt) => (
              <option value={opt.value} data-low={opt.low} data-high={opt.high}>{opt.label}</option>
            ))}
          </select>
        </label>
        <label class="field">
          <span>Approx. square footage</span>
          <input type="number" min="100" step="50" placeholder="e.g. 1800" data-estimate-sqft required />
        </label>
        <label class="field">
          <span>ZIP code</span>
          <input type="text" inputmode="numeric" placeholder="e.g. 60614" data-estimate-zip required />
        </label>
        <button type="submit" class="calc-submit">See My Estimate Range</button>
      </form>

      <div class="calc-result" data-estimate-result hidden>
        <p class="result-label">Your estimated range</p>
        <p class="result-value" data-estimate-value></p>
        <p class="result-note">Estimate only — your final price is confirmed at a free in-home visit, before any work starts.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hl-hero {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #F7F3EC;
  }
  .hero-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: stretch;
    min-height: 620px;
  }

  .hero-photo {
    position: relative;
    background: linear-gradient(150deg, #14807F, #083D3D);
    background-size: cover;
    background-position: center;
    padding: 64px 48px;
    display: flex;
    align-items: flex-end;
    border-radius: 0 0 0 0;
  }
  .photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8,61,61,0.25), rgba(8,61,61,0.7));
  }
  .photo-content { position: relative; z-index: 1; max-width: 480px; }
  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F2C79A;
    margin: 0 0 16px;
  }
  .headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 18px;
  }
  .sub {
    font-size: 16.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 26px;
  }
  .trust-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .trust-list li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
  }
  .trust-list svg { width: 16px; height: 16px; flex-shrink: 0; }

  .calc-card {
    background: #ffffff;
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .calc-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #DE9A5C;
    margin: 0 0 10px;
  }
  .calc-headline {
    font-family: 'Fraunces', serif;
    font-size: 25px;
    font-weight: 600;
    color: #0E5E5E;
    margin: 0 0 8px;
  }
  .calc-sub {
    font-size: 14px;
    color: #6B7D78;
    margin: 0 0 24px;
  }

  .calc-form { display: flex; flex-direction: column; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field span {
    font-size: 12.5px;
    font-weight: 600;
    color: #34443F;
  }
  .field select,
  .field input {
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1.5px solid #E3DCCD;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    color: #0E5E5E;
    background: #ffffff;
  }
  .field select:focus,
  .field input:focus { outline: none; border-color: #0E5E5E; }
  .calc-submit {
    margin-top: 4px;
    padding: 14px 20px;
    background: #0E5E5E;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
  }
  .calc-submit:hover { background: #083D3D; }

  .calc-result {
    margin-top: 22px;
    padding: 20px;
    background: #F7F3EC;
    border-radius: 10px;
    border: 1px solid #E3DCCD;
  }
  .result-label {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6B7D78;
    margin: 0 0 6px;
  }
  .result-value {
    font-family: 'Fraunces', serif;
    font-size: 26px;
    font-weight: 600;
    color: #0E5E5E;
    margin: 0 0 8px;
  }
  .result-note {
    font-size: 12.5px;
    line-height: 1.5;
    color: #6B7D78;
    margin: 0;
  }

  @media (max-width: 980px) {
    .hero-inner { grid-template-columns: 1fr; min-height: 0; }
    .hero-photo { padding: 48px 24px; }
    .calc-card { padding: 40px 24px; }
  }
  @media (max-width: 560px) {
    .hero-photo { padding: 40px 20px; }
    .calc-card { padding: 32px 20px; }
  }
</style>

<script>
  const form = document.querySelector('[data-estimate-form]');
  const result = document.querySelector('[data-estimate-result]');
  const valueEl = document.querySelector('[data-estimate-value]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const select = form.querySelector('[data-estimate-service]');
    const sqftInput = form.querySelector('[data-estimate-sqft]');
    const selectedOption = select?.selectedOptions?.[0];
    const sqft = Number(sqftInput?.value || 0);
    const low = Number(selectedOption?.dataset.low || 0);
    const high = Number(selectedOption?.dataset.high || 0);

    if (!sqft || !low || !high) return;

    const lowTotal = Math.max(500, Math.round((sqft * low) / 50) * 50);
    const highTotal = Math.max(lowTotal + 500, Math.round((sqft * high) / 50) * 50);
    const fmt = (n) => `$${n.toLocaleString('en-US')}`;

    if (valueEl) valueEl.textContent = `${fmt(lowTotal)} – ${fmt(highTotal)}`;
    result?.removeAttribute('hidden');
  });
</script>
