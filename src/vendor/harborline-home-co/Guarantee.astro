---
// Harborline Home Co. — Guarantee. Same photo+copy shape as Anchor's,
// but the promise itself ties back to the pricing-transparency angle
// (no surprise price changes) instead of a generic satisfaction
// guarantee.
interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  photoUrl?: string;
}

const {
  eyebrow = 'Our Promise',
  headline = 'The Price We Confirm Is the Price You Pay',
  body = "If the final number at your in-home visit is going to be different from your online estimate, we tell you why before we ask you to sign anything — never after the work has started.",
  ctaLabel = 'Get Your Estimate Range',
  ctaHref = '#estimate',
  photoUrl = '[GUARANTEE_PHOTO_URL]',
} = Astro.props;

const hasPhoto = !photoUrl.startsWith('[');
---

<section class="guarantee">
  <div class="guarantee-inner">
    <div class="guarantee-photo" style={hasPhoto ? `background-image: url('${photoUrl}');` : ''}>
      {!hasPhoto && <span class="photo-fallback-label">[GUARANTEE_PHOTO_URL]</span>}
    </div>

    <div class="guarantee-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
      <p class="body">{body}</p>
      <a href={ctaHref} class="cta">{ctaLabel}</a>
    </div>
  </div>
</section>

<style>
  .guarantee {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #0E5E5E;
    padding: 84px 40px;
  }
  .guarantee-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .guarantee-photo {
    aspect-ratio: 4 / 3.2;
    border-radius: 14px;
    background: linear-gradient(135deg, #14807F, #083D3D);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .photo-fallback-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.35);
  }

  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F2C79A;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 600;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 18px;
  }
  .body {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 32px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: #DE9A5C;
    color: #083D3D;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 100px;
    transition: background 0.15s;
  }
  .cta:hover { background: #C77F3F; color: #ffffff; }

  @media (max-width: 900px) {
    .guarantee-inner { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 560px) {
    .guarantee { padding: 56px 20px; }
  }
</style>
