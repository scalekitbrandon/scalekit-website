---
// Harborline Home Co. — FAQ. Same zero-JS <details>/<summary> accordion
// pattern used across every template. Questions focus on the estimate
// tool's accuracy since that's this template's whole differentiator.
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  items?: FaqItem[];
}

const {
  eyebrow = 'Good to Know',
  headline = 'Common Questions',
  items = [
    {
      question: 'How accurate is the instant estimate?',
      answer: "It's a real range based on your square footage and project type — most jobs land inside it. The final, firm price is always confirmed in person before you sign anything.",
    },
    {
      question: 'Do I have to book anything to get a price?',
      answer: 'No. The calculator has no obligation attached — it\'s just a real number, right away.',
    },
    {
      question: 'Are your crews licensed and insured?',
      answer: 'Yes — every job is covered, and our crews are our own employees, not subcontractors.',
    },
    {
      question: 'What if the final price is different from my estimate?',
      answer: "If scope changes once we see the job in person, we explain exactly why before asking you to sign — never as a surprise mid-project.",
    },
  ],
} = Astro.props;
---

<section class="faq">
  <div class="faq-inner">
    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
    </div>

    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            {item.question}
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p class="faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #F7F3EC;
    padding: 84px 40px;
  }
  .faq-inner { max-width: 780px; margin: 0 auto; }

  .header { text-align: center; margin: 0 auto 40px; }
  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #DE9A5C;
    margin: 0 0 12px;
  }
  .headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    color: #0E5E5E;
    margin: 0;
  }

  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: #ffffff;
    border: 1px solid #E3DCCD;
    border-radius: 8px;
    padding: 18px 22px;
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 15.5px;
    font-weight: 600;
    color: #0E5E5E;
    cursor: pointer;
    list-style: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .chevron { width: 17px; height: 17px; flex-shrink: 0; color: #8B9994; transition: transform 0.2s; }
  .faq-item[open] .chevron { transform: rotate(180deg); }
  .faq-answer {
    font-size: 14.5px;
    line-height: 1.6;
    color: #34443F;
    margin: 12px 0 0;
    padding-right: 30px;
  }

  @media (max-width: 560px) {
    .faq { padding: 56px 20px; }
    .faq-item { padding: 16px; }
  }
</style>
