---
// Harborline Home Co. — Accreditations. Same CSS-only marquee pattern as
// Anchor's, reskinned to teal/sand. Generic capability badges, not real
// third-party certification logos — same fabrication guardrail as
// Anchor ("Harborline" is an invented business).
interface Props {
  badges?: string[];
}

const {
  badges = [
    'Licensed & Insured',
    'Locally Owned & Operated',
    'Flat-Rate, No-Surprise Pricing',
    'Background-Checked Crews',
    'Free In-Home Visits',
    'Satisfaction Guaranteed',
  ],
} = Astro.props;

const looped = [...badges, ...badges];
---

<section class="accreditations">
  <div class="track">
    {looped.map((b) => (
      <span class="badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="#DE9A5C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        {b}
      </span>
    ))}
  </div>
</section>

<style>
  .accreditations {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #0E5E5E;
    padding: 26px 0;
    overflow: hidden;
  }
  .track {
    display: flex;
    align-items: center;
    gap: 48px;
    width: max-content;
    animation: scroll 26s linear infinite;
  }
  .accreditations:hover .track { animation-play-state: paused; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }
  .badge svg { width: 16px; height: 16px; flex-shrink: 0; }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 560px) {
    .accreditations { padding: 20px 0; }
    .track { gap: 32px; }
  }
</style>
