---
// Home Services variant 2 — "Harborline Home Co." Second of the 8
// home-services homepage variants (Brandon confirmed 8 total: the
// existing Anchor + 7 new). Distinct identity from Anchor: deep teal
// `#0E5E5E` + warm sand `#DE9A5C`, `Fraunces` (serif) headline font +
// `Inter` body — Anchor uses navy/gold + Poppins. Plain nav links (no
// dropdowns) is a deliberate layout difference from Anchor's
// dropdown-capable nav. PLACEHOLDER: business name, phone, and nav
// targets — swap for a real client's info if this ever becomes an
// actual build.
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  businessName?: string;
  tagline?: string;
  links?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  businessName = 'Harborline',
  tagline = 'Home Co.',
  links = [
    { label: 'Home', href: '#home' },
    { label: 'Services', href: '#services' },
    { label: 'Get an Estimate', href: '#estimate' },
    { label: 'About', href: '#about' },
    { label: 'Reviews', href: '#reviews' },
  ],
  ctaLabel = 'Get My Estimate',
  ctaHref = '#estimate',
} = Astro.props;
---

<header class="hl-header">
  <div class="header-inner">
    <a href="#home" class="logo">
      <span class="logo-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0"/><path d="M3 19c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0"/><path d="M12 3v9"/><path d="M8 7l4-4 4 4"/></svg>
      </span>
      <span class="logo-text">
        <span class="logo-name">{businessName}</span>
        <span class="logo-tagline">{tagline}</span>
      </span>
    </a>

    <nav class="nav-links">
      {links.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <a href={ctaHref} class="cta">{ctaLabel}</a>
  </div>
</header>

<style>
  .hl-header {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #ffffff;
    border-bottom: 1px solid #E3DCCD;
  }
  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-badge {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #0E5E5E;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .logo-badge svg { width: 22px; height: 22px; }
  .logo-text { display: flex; align-items: baseline; gap: 6px; }
  .logo-name {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 600;
    color: #0E5E5E;
  }
  .logo-tagline {
    font-size: 13px;
    font-weight: 500;
    color: #6B7D78;
  }
  .nav-links { display: flex; align-items: center; gap: 30px; }
  .nav-link {
    font-size: 14.5px;
    font-weight: 500;
    color: #34443F;
    text-decoration: none;
  }
  .nav-link:hover { color: #0E5E5E; }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 24px;
    background: #DE9A5C;
    color: #083D3D;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 100px;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .cta:hover { background: #C77F3F; color: #ffffff; }

  @media (max-width: 980px) {
    .nav-links { display: none; }
    .header-inner { padding: 0 20px; }
  }
</style>
