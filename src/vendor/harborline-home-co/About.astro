---
// Harborline Home Co. — About. Same photo+copy split shape as Anchor's
// About.astro. Stats reinforce the pricing-transparency positioning
// instead of Anchor's owner-operated framing.
interface Stat {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  stats?: Stat[];
  photoUrl?: string;
}

const {
  eyebrow = 'About Harborline',
  headline = 'The Company That Tells You the Price First',
  body = "Harborline is a local crew, not a national franchise reading from a script. Every estimate starts with a real number you can see for yourself — no waiting for a callback, no lowball number that changes once the crew shows up.",
  stats = [
    { value: 'Transparent Pricing', label: 'A real range before you ever call' },
    { value: 'In-House Crews', label: 'No subcontracted strangers' },
    { value: 'No Hidden Fees', label: 'The price you sign is the price you pay' },
  ],
  photoUrl = '[ABOUT_PHOTO_URL]',
} = Astro.props;

const hasPhoto = !photoUrl.startsWith('[');
---

<section class="about">
  <div class="about-inner">
    <div class="about-photo" style={hasPhoto ? `background-image: url('${photoUrl}');` : ''}>
      {!hasPhoto && <span class="photo-fallback-label">[ABOUT_PHOTO_URL]</span>}
    </div>

    <div class="about-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
      <p class="body">{body}</p>

      <div class="stat-list">
        {stats.map((s) => (
          <div class="stat">
            <p class="stat-value">{s.value}</p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #ffffff;
    padding: 84px 40px;
  }
  .about-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .about-photo {
    aspect-ratio: 4 / 3.4;
    border-radius: 14px;
    background: linear-gradient(135deg, #14807F, #083D3D);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .photo-fallback-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.4);
  }

  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #DE9A5C;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 600;
    line-height: 1.2;
    color: #0E5E5E;
    margin: 0 0 18px;
  }
  .body {
    font-size: 16px;
    line-height: 1.7;
    color: #34443F;
    margin: 0 0 32px;
  }

  .stat-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid #E3DCCD;
  }
  .stat-value {
    font-family: 'Fraunces', serif;
    font-size: 16px;
    font-weight: 600;
    color: #0E5E5E;
    margin: 0 0 4px;
  }
  .stat-label {
    font-size: 12.5px;
    line-height: 1.4;
    color: #6B7D78;
    margin: 0;
  }

  @media (max-width: 900px) {
    .about-inner { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 560px) {
    .about { padding: 56px 20px; }
    .stat-list { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
