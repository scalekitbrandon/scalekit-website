---
// Harborline Home Co. — Mission. Same shape as Anchor's Mission.astro
// (centered eyebrow/headline/body/CTA) but copy leans into the
// transparent-pricing positioning that the Hero calculator sets up.
interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Why We Do This',
  headline = 'We Believe Pricing Shouldn’t Be a Mystery',
  body = "Harborline started because homeowners kept telling us the same thing: nobody would give them a straight number until a crew was already standing in their driveway. So we built our whole process around giving you a real range up front, then confirming it in person before anything is signed.",
  ctaLabel = 'Try the Estimate Tool',
  ctaHref = '#estimate',
} = Astro.props;
---

<section class="mission">
  <div class="mission-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="headline">{headline}</h2>
    <p class="body">{body}</p>
    <a href={ctaHref} class="cta">{ctaLabel}</a>
  </div>
</section>

<style>
  .mission {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #F7F3EC;
    padding: 84px 40px;
    text-align: center;
  }
  .mission-inner { max-width: 760px; margin: 0 auto; }

  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #DE9A5C;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: #0E5E5E;
    margin: 0 0 20px;
  }
  .body {
    font-size: 16.5px;
    line-height: 1.7;
    color: #34443F;
    margin: 0 0 32px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    background: #0E5E5E;
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 100px;
    transition: background 0.15s;
  }
  .cta:hover { background: #083D3D; }

  @media (max-width: 560px) {
    .mission { padding: 56px 20px; }
  }
</style>
