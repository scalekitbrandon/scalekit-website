---
// Harborline Home Co. — ServiceAreaMap. Simplified from Anchor's version
// on purpose: no second ZIP form here since the Hero's instant-estimate
// calculator already captures ZIP — just the map + city list, avoiding a
// redundant form on the same page. Same stylized-placeholder-map and
// bracket-placeholder city-name discipline as Anchor (no real Maps API
// key tied to a real business, never invent real town names for a
// fictional one).
interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  cities?: string[];
}

const {
  eyebrow = 'Where We Work',
  headline = 'Proudly Serving Your Area',
  subheadline = "If you're within about 30 minutes of these towns, we're already in your neighborhood.",
  cities = ['[CITY 1]', '[CITY 2]', '[CITY 3]', '[CITY 4]', '[CITY 5]', '[CITY 6]'],
} = Astro.props;
---

<section class="service-area">
  <div class="service-area-inner">
    <div class="copy-col">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
      <p class="sub">{subheadline}</p>

      <ul class="city-list">
        {cities.map((c) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="#DE9A5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            {c}
          </li>
        ))}
      </ul>
    </div>

    <div class="map-panel">
      <svg class="map-pin" viewBox="0 0 24 24" fill="#DE9A5C"><path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
      <p class="map-label">[SERVICE AREA MAP]</p>
    </div>
  </div>
</section>

<style>
  .service-area {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #ffffff;
    padding: 84px 40px;
  }
  .service-area-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #DE9A5C;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 600;
    color: #0E5E5E;
    margin: 0 0 14px;
  }
  .sub {
    font-size: 15.5px;
    line-height: 1.6;
    color: #34443F;
    margin: 0 0 26px;
  }

  .city-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
  }
  .city-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #34443F;
  }
  .city-list svg { width: 16px; height: 16px; flex-shrink: 0; }

  .map-panel {
    aspect-ratio: 4 / 3.6;
    border-radius: 14px;
    background: linear-gradient(135deg, #F0EAD9, #E3DCCD);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .map-pin { width: 40px; height: 40px; opacity: 0.7; }
  .map-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #8B9994;
    margin: 0;
  }

  @media (max-width: 900px) {
    .service-area-inner { grid-template-columns: 1fr; gap: 36px; }
    .map-panel { order: -1; }
  }
  @media (max-width: 560px) {
    .service-area { padding: 56px 20px; }
    .city-list { grid-template-columns: 1fr; }
  }
</style>
