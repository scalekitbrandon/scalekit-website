---
// Therapist Template 2 (group practice) — Footer.
// Structure cloned from the same reference site (newsletter signup row,
// then contact/social + two link columns, bottom bar with practice
// blurb + 2 CTAs, copyright line) — colors and copy reskinned to
// Willowmere's palette, not carried over from the reference.
// PLACEHOLDER: phone/email are obviously-fake demo defaults (555 prefix,
// invented domain) — swap for real client info when used for an actual
// build. The newsletter form has no submission handler wired up.
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  newsletterEyebrow?: string;
  newsletterHeadline?: string;
  newsletterBody?: string;
  phone?: string;
  phoneHref?: string;
  email?: string;
  exploreLinks?: LinkItem[];
  helpLinks?: LinkItem[];
  practiceBlurb?: string;
  businessName?: string;
}

const {
  newsletterEyebrow = 'NEWSLETTER',
  newsletterHeadline = "The work doesn't stop when the session ends.",
  newsletterBody = 'It shows up in the middle of an ordinary week. We write occasionally, and only when we have something worth saying.',
  phone = '(555) 203-0852',
  phoneHref = 'tel:5552030852',
  email = 'hello@willowmeretherapygroup.com',
  exploreLinks = [
    { label: 'Home', href: '#home' },
    { label: 'About', href: '#about' },
    { label: 'Therapists', href: '#therapists' },
    { label: 'Insurance & Billing', href: '#insurance' },
    { label: 'FAQs', href: '#faqs' },
    { label: 'Contact', href: '#contact' },
  ],
  helpLinks = [
    { label: 'Anxiety & Stress', href: '#specialties' },
    { label: 'Relationship Issues', href: '#specialties' },
    { label: 'Couples Therapy', href: '#specialties' },
    { label: 'Life Transitions', href: '#specialties' },
    { label: 'Family Conflict', href: '#specialties' },
    { label: 'Young Adults 18+', href: '#specialties' },
  ],
  practiceBlurb = 'Willowmere Therapy Group is a group practice of licensed therapists offering individual, couples, and family therapy — in person and virtually.',
  businessName = 'Willowmere Therapy Group',
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="wg-footer">
  <div class="newsletter-row">
    <div class="newsletter-inner">
      <div class="newsletter-copy">
        <p class="eyebrow">{newsletterEyebrow}</p>
        <h2 class="newsletter-headline">{newsletterHeadline}</h2>
        <p class="newsletter-body">{newsletterBody}</p>
      </div>
      <form class="newsletter-form">
        <input type="text" name="firstName" placeholder="First name" required />
        <input type="email" name="email" placeholder="Email address" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </div>

  <div class="footer-main">
    <div class="footer-inner">
      <div class="footer-col footer-brand">
        <p class="footer-logo">{businessName}</p>
        <a href={phoneHref} class="footer-contact">{phone}</a>
        <a href={`mailto:${email}`} class="footer-contact">{email}</a>
        <div class="social-icons">
          <a href="#" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.2 1.48-2.2 3v5.8h-4V9Z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <p class="footer-col-heading">Explore</p>
        {exploreLinks.map((link) => (
          <a href={link.href} class="footer-link">{link.label}</a>
        ))}
      </div>

      <div class="footer-col">
        <p class="footer-col-heading">What We Help With</p>
        {helpLinks.map((link) => (
          <a href={link.href} class="footer-link">{link.label}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="practice-blurb">{practiceBlurb}</p>
      <div class="bottom-ctas">
        <a href="#insurance" class="cta-outline">Insurance & Billing</a>
        <a href="#contact" class="cta-filled">New Clients</a>
      </div>
    </div>
  </div>

  <div class="copyright">
    <p>&copy; {currentYear} {businessName}. All rights reserved. · Privacy · Site Credit</p>
  </div>
</footer>

<style>
  .wg-footer {
    font-family: 'Karla', -apple-system, sans-serif;
    background: #FAF6EF;
  }

  .newsletter-row {
    background: #F1E9DD;
    padding: 72px 40px;
    border-bottom: 1px solid #E3D6DE;
  }
  .newsletter-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C98A3E;
    margin: 0 0 14px;
  }
  .newsletter-headline {
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 28px);
    color: #2B1B29;
    margin: 0 0 12px;
  }
  .newsletter-body {
    font-size: 15px;
    line-height: 1.65;
    color: #5A4A55;
    margin: 0;
    max-width: 460px;
  }

  .newsletter-form {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .newsletter-form input {
    flex: 1;
    min-width: 150px;
    padding: 14px 16px;
    border: 1px solid #D9C7D1;
    border-radius: 4px;
    background: #FAF6EF;
    font-family: inherit;
    font-size: 14px;
    color: #2B1B29;
  }
  .newsletter-form input::placeholder { color: #8A7683; }
  .newsletter-form button {
    padding: 14px 26px;
    background: #4A2545;
    color: #FAF6EF;
    border: none;
    border-radius: 4px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.15s;
  }
  .newsletter-form button:hover { background: #3A1C37; }

  .footer-main { padding: 64px 40px; }
  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 48px;
  }
  .footer-col { display: flex; flex-direction: column; gap: 12px; }
  .footer-logo {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 19px;
    color: #4A2545;
    margin: 0 0 6px;
  }
  .footer-contact {
    font-size: 14.5px;
    color: #3A2E37;
    text-decoration: none;
  }
  .footer-contact:hover { color: #4A2545; }
  .social-icons { display: flex; gap: 14px; margin-top: 8px; }
  .social-icons a { color: #4A2545; }
  .social-icons svg { width: 19px; height: 19px; }

  .footer-col-heading {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C98A3E;
    margin: 0 0 6px;
  }
  .footer-link {
    font-size: 14.5px;
    color: #3A2E37;
    text-decoration: none;
    opacity: 0.85;
  }
  .footer-link:hover { opacity: 1; }

  .footer-bottom {
    background: #FFFFFF;
    border-top: 1px solid #E3D6DE;
    padding: 32px 40px;
  }
  .footer-bottom-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .practice-blurb {
    font-size: 14px;
    line-height: 1.6;
    color: #5A4A55;
    max-width: 560px;
    margin: 0;
  }
  .bottom-ctas { display: flex; gap: 12px; flex-shrink: 0; }
  .cta-outline,
  .cta-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 20px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 4px;
    white-space: nowrap;
  }
  .cta-outline {
    border: 1.5px solid #4A2545;
    color: #4A2545;
  }
  .cta-outline:hover { background: #4A2545; color: #FAF6EF; }
  .cta-filled {
    background: #C98A3E;
    color: #2B1B29;
  }
  .cta-filled:hover { background: #DBA05A; }

  .copyright {
    padding: 18px 40px;
    text-align: center;
  }
  .copyright p {
    margin: 0;
    font-size: 12px;
    color: #8A7683;
  }

  @media (max-width: 900px) {
    .newsletter-inner { grid-template-columns: 1fr; gap: 28px; }
    .footer-inner { grid-template-columns: 1fr; gap: 32px; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
    .newsletter-row, .footer-main, .footer-bottom { padding-left: 24px; padding-right: 24px; }
  }
</style>
