---
// Therapist Template 2 (group practice) — Announcement bar + Header/Nav.
// Structure cloned from a reference group-therapy-practice site (thin
// top announcement bar, wordmark logo, centered nav, single outline CTA)
// — colors, logo, business name, and copy are ScaleKit's own placeholder
// brand for this template, not carried over from the reference.
// PLACEHOLDER: business name, announcement text, and nav link targets —
// swap for a real client's info when this template is used for an
// actual group therapy practice client build.
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  announcementText?: string;
  businessName?: string;
  businessTagline?: string;
  links?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  announcementText = 'Now accepting new clients — schedule a free consultation.',
  businessName = 'Willowmere',
  businessTagline = 'THERAPY GROUP',
  links = [
    { label: 'Home', href: '#home' },
    { label: 'About', href: '#about' },
    { label: 'Therapists', href: '#therapists' },
    { label: 'Specialties', href: '#specialties' },
    { label: 'Contact', href: '#contact' },
  ],
  ctaLabel = 'Book a Consultation',
  ctaHref = '#contact',
} = Astro.props;
---

<div class="announce-bar">
  <p>{announcementText}</p>
</div>

<header class="wg-header">
  <div class="header-inner">
    <a href="#home" class="logo">
      <span class="logo-name">{businessName}</span>
      <span class="logo-tagline">{businessTagline}</span>
    </a>

    <nav class="nav-links">
      {links.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <a href={ctaHref} class="cta">{ctaLabel}</a>
  </div>
</header>

<style>
  .announce-bar {
    background: #4A2545;
    padding: 9px 20px;
    text-align: center;
  }
  .announce-bar p {
    margin: 0;
    font-family: 'Karla', -apple-system, sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #F1E4EC;
  }

  .wg-header {
    font-family: 'Karla', -apple-system, sans-serif;
    background: #FAF6EF;
    border-bottom: 1px solid #E9DFCF;
  }
  .header-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-name {
    font-family: 'Fraunces', serif;
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #4A2545;
  }
  .logo-tagline {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #C98A3E;
    margin-top: 2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 34px;
  }
  .nav-link {
    font-size: 14.5px;
    font-weight: 600;
    color: #3A2E37;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.15s;
  }
  .nav-link:hover { opacity: 1; }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background: #4A2545;
    color: #FAF6EF;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 4px;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .cta:hover { background: #3A1C37; }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .header-inner { padding: 0 20px; }
  }

  /* Real bug: below 900px, logo (name+tagline) + full CTA button stay
     full size and can overflow a real phone-width screen. */
  @media (max-width: 420px) {
    .header-inner { padding: 0 16px; }
    .logo-name { font-size: 18px; }
    .logo-tagline { display: none; }
    .cta { padding: 9px 16px; font-size: 12px; }
  }
</style>
