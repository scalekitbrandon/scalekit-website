---
// Therapist Template 2 (group practice) — Quality Band.
// Structure cloned from the same reference site (full-width color band,
// two-column: left copy + 2 outline CTAs, right white card with 4
// stacked feature blurbs) — colors and copy reskinned to Willowmere's
// aubergine/amber/ivory palette, not carried over from the reference.
// No fabricated claims: insurance copy stays generic, no specific real
// insurer names are asserted for this invented practice.
interface Feature {
  heading: string;
  description: string;
}

interface Props {
  headline?: string;
  headlineEmphasis?: string;
  body?: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  features?: Feature[];
}

const {
  headline = 'Quality therapy.',
  headlineEmphasis = 'Done intentionally.',
  body = 'There are many therapy practices to choose from. Willowmere was built with structure and purpose — licensed clinicians, ongoing supervision, and clear scope so you know what to expect from the beginning. The goal is to make progress feel possible, not just to fill a seat.',
  primaryCtaLabel = 'Insurance & Billing',
  primaryCtaHref = '#insurance',
  secondaryCtaLabel = 'Our Therapists',
  secondaryCtaHref = '#therapists',
  features = [
    { heading: 'Thoughtful Matching', description: "We take care in pairing you with a therapist whose training, style, and scope align with what you're navigating." },
    { heading: 'Licensed, Experienced Clinicians', description: 'Our team is composed of licensed therapists with clinical training across anxiety, trauma, relationships, and life transitions.' },
    { heading: 'Insurance-Friendly Care', description: 'We accept a range of insurance plans and can walk you through what applies to you before you get started.' },
    { heading: 'Relational, Not Rushed', description: "We're not a revolving-door practice — our clinicians keep sustainable caseloads so they can show up present and engaged." },
  ],
} = Astro.props;
---

<section class="quality-band">
  <div class="quality-inner">
    <div class="quality-copy">
      <h2 class="headline">{headline} <span>{headlineEmphasis}</span></h2>
      <p class="body">{body}</p>
      <div class="cta-row">
        <a href={primaryCtaHref} class="cta-outline">{primaryCtaLabel}</a>
        <a href={secondaryCtaHref} class="cta-outline">{secondaryCtaLabel}</a>
      </div>
    </div>

    <div class="feature-card">
      {features.map((feature) => (
        <div class="feature-row">
          <h3 class="feature-heading">{feature.heading}</h3>
          <p class="feature-desc">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .quality-band {
    font-family: 'Karla', -apple-system, sans-serif;
    background: #4A2545;
    padding: 100px 40px;
  }
  .quality-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .headline {
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.3;
    color: #FFFFFF;
    margin: 0 0 22px;
  }
  .headline span { font-weight: 700; color: #E3C08A; }
  .body {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
    max-width: 460px;
    margin: 0 0 32px;
  }

  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }
  .cta-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 24px;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
  }
  .cta-outline:hover { background: #FFFFFF; color: #4A2545; }

  .feature-card {
    background: #FAF6EF;
    border-radius: 8px;
    padding: 36px 40px;
  }
  .feature-row {
    padding: 20px 0;
    border-bottom: 1px solid #E9DFCF;
  }
  .feature-row:first-child { padding-top: 0; }
  .feature-row:last-child { padding-bottom: 0; border-bottom: none; }
  .feature-heading {
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #C98A3E;
    margin: 0 0 8px;
  }
  .feature-desc {
    font-size: 15px;
    line-height: 1.6;
    color: #3A2E37;
    margin: 0;
  }

  @media (max-width: 900px) {
    .quality-inner { grid-template-columns: 1fr; gap: 40px; }
    .quality-band { padding: 72px 24px; }
    .feature-card { padding: 28px 24px; }
  }
</style>
