---
// Landscaping/Tree Care industry template — Hero. Structure cloned from a
// reference tree-care company's homepage (full-bleed photo hero, left
// copy + trust row, right single-step lead-capture form card with a
// service-type dropdown) — colors, copy, and the business identity are
// ScaleKit's own placeholder brand, not carried over from the reference.
// Deliberately distinct from the Roofing hero: serif display headline
// (Fraunces) instead of condensed all-caps sans, a single-step form with
// a service-select dropdown instead of a 2-step name/phone/address flow,
// forest green + terracotta instead of gold/near-black.
// PLACEHOLDER: [HERO_IMAGE_URL] needs a real photo before use — no
// fabricated/stock image is baked in here. Headline location, phone
// number, and rating are demo defaults; swap for the real client's info.
interface TrustItem {
  icon: 'shield' | 'clock' | 'calendar';
  label: string;
}

interface Props {
  ratingBadge?: string;
  headlineLine1?: string;
  headlineLine2?: string;
  headlineLine3?: string;
  subheadline?: string;
  callCtaLabel?: string;
  callCtaHref?: string;
  trustItems?: TrustItem[];
  formHeadline?: string;
  formSubheadline?: string;
  formNote?: string;
  heroImageUrl?: string;
}

const {
  ratingBadge = '★★★★★  Rated 5.0 by Local Homeowners',
  headlineLine1 = 'Your Local',
  headlineLine2 = 'Tree Care Experts',
  headlineLine3 = '— Trusted for 25+ Years',
  subheadline = 'Certified arborists for tree removal, trimming, and stump grinding across the Greater Metro Area. Careful, insured, and fairly priced — with free estimates seven days a week.',
  callCtaLabel = 'Call (555) 384-2960',
  callCtaHref = 'tel:5553842960',
  trustItems = [
    { icon: 'shield', label: 'Insured & Bonded' },
    { icon: 'clock', label: '24/7 Emergency Service' },
    { icon: 'calendar', label: 'Free Estimates 7 Days a Week' },
  ],
  formHeadline = 'Get a Free On-Site Estimate',
  formSubheadline = 'No obligation · Response within 24 hours',
  formNote = 'Your information is private. We never share your data.',
  heroImageUrl = '[HERO_IMAGE_URL]',
} = Astro.props;

const icons: Record<string, string> = {
  shield: '<path d="M12 2L4 5V11C4 16 7.5 20.5 12 22C16.5 20.5 20 16 20 11V5L12 2Z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
};
---

<section class="land-hero">
  <!-- PLACEHOLDER: replace heroImageUrl with a real photo before use -->
  <div class="hero-bg" style={`background-image: linear-gradient(rgba(20,35,25,0.6), rgba(20,35,25,0.72)), url('${heroImageUrl}');`}></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <span class="rating-badge">{ratingBadge}</span>
      <h1 class="headline">
        <span class="line">{headlineLine1}</span>
        <span class="line accent">{headlineLine2}</span>
        <span class="line sub-line">{headlineLine3}</span>
      </h1>
      <p class="sub">{subheadline}</p>

      <a href={callCtaHref} class="call-cta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92V19.92C22.0011 20.4853 21.7669 21.0251 21.3533 21.4132C20.9397 21.8013 20.3871 22.0067 19.823 21.98C16.7428 21.6227 13.7893 20.5805 11.19 18.93C8.77383 17.4233 6.72534 15.3748 5.21801 12.96C3.56226 10.3484 2.51997 7.3801 2.17001 4.28C2.1437 3.71754 2.34727 3.16776 2.73386 2.75523C3.12045 2.34269 3.65653 2.10713 4.22001 2.11H7.22001C8.10561 2.10083 8.86143 2.73545 9.00001 3.61C9.12662 4.48 9.34688 5.33422 9.65001 6.16C9.89284 6.78937 9.7418 7.50207 9.26001 7.98L8.09001 9.15C9.51356 11.6488 11.5712 13.7065 14.07 15.13L15.24 13.96C15.7179 13.4782 16.4306 13.3272 17.06 13.57C17.8858 13.8731 18.74 14.0934 19.61 14.22C20.4969 14.3598 21.1345 15.1302 21.12 16.02L22 16.92Z"/></svg>
        {callCtaLabel}
      </a>

      <div class="trust-row">
        {trustItems.map((item) => (
          <div class="trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="#9CB84E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="form-card">
      <p class="form-headline">{formHeadline}</p>
      <p class="form-sub">{formSubheadline}</p>

      <form class="lead-form">
        <div class="form-row">
          <input type="text" name="firstName" placeholder="First Name" required />
          <input type="text" name="lastName" placeholder="Last Name" required />
        </div>
        <select name="service" required>
          <option value="" selected disabled>Select a Service</option>
          <option value="removal">Tree Removal</option>
          <option value="trimming">Tree Trimming / Pruning</option>
          <option value="stump">Stump Grinding</option>
          <option value="emergency">Emergency Tree Service</option>
          <option value="other">Other</option>
        </select>
        <input type="text" name="zip" placeholder="ZIP or City" required />
        <button type="submit" class="form-submit">Get My Free Estimate</button>
      </form>

      <p class="form-privacy">{formNote}</p>
    </div>
  </div>
</section>

<style>
  .land-hero {
    position: relative;
    font-family: 'Work Sans', -apple-system, sans-serif;
    padding: 90px 40px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-color: #2A3F2E;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .rating-badge {
    display: inline-block;
    background: rgba(247, 243, 233, 0.12);
    border: 1px solid rgba(247, 243, 233, 0.35);
    color: #F7F3E9;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 8px 16px;
    border-radius: 100px;
    margin-bottom: 22px;
  }
  .headline {
    font-family: 'Fraunces', serif;
    font-size: clamp(36px, 4.6vw, 58px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.12;
    color: #ffffff;
    margin: 0 0 22px;
  }
  .headline .line { display: block; }
  .headline .accent { color: #B4CC5E; font-style: italic; }
  .headline .sub-line { font-size: 0.62em; font-weight: 400; color: rgba(255, 255, 255, 0.8); margin-top: 4px; }
  .sub {
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    max-width: 540px;
    margin: 0 0 32px;
  }
  .call-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px;
    background: #D97C4A;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    border-radius: 6px;
    margin-bottom: 32px;
    transition: background 0.15s;
  }
  .call-cta svg { width: 17px; height: 17px; }
  .call-cta:hover { background: #c56638; }

  .trust-row { display: flex; align-items: center; flex-wrap: wrap; gap: 26px; }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
  }
  .trust-item svg { width: 17px; height: 17px; flex-shrink: 0; }

  .form-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 38px 34px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
  }
  .form-headline {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 600;
    color: #1B211C;
    text-align: center;
    margin: 0 0 6px;
  }
  .form-sub {
    font-size: 13px;
    color: #6B7A6E;
    text-align: center;
    margin: 0 0 26px;
  }

  .lead-form { display: flex; flex-direction: column; gap: 14px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .lead-form input,
  .lead-form select {
    width: 100%;
    box-sizing: border-box;
    background: #F7F3E9;
    border: 1px solid #E4DCC6;
    border-radius: 7px;
    padding: 14px 16px;
    font-family: inherit;
    font-size: 14px;
    color: #1B211C;
    appearance: none;
  }
  .lead-form select { color: #5B6358; }
  .lead-form input::placeholder { color: #8A9285; }
  .form-submit {
    width: 100%;
    background: #1E3D2B;
    color: #ffffff;
    border: none;
    border-radius: 7px;
    padding: 16px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    margin-top: 6px;
    transition: background 0.15s;
  }
  .form-submit:hover { background: #16301F; }
  .form-privacy {
    font-size: 12px;
    color: #8A9285;
    text-align: center;
    margin: 16px 0 0;
  }

  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; }
    .land-hero { padding: 60px 20px; }
  }
  @media (max-width: 480px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
