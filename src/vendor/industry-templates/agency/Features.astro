---
// Agency & Consultant industry template — Features. Follows Header +
// Hero, same placeholder brand (purple-to-blue gradient, Sora + Inter).
// Structure cloned from the reference (centered gradient headline, intro
// paragraph, 2x2 icon-card feature grid, closing paragraph, centered
// CTA) — copy is reworded, not copied verbatim, describing the same
// general concept (what makes a business profile easy for AI models to
// surface) in ScaleKit's own words.
interface Feature {
  title: string;
  description: string;
  icon: 'database' | 'shield-check' | 'refresh' | 'video';
}

interface Props {
  eyebrow?: string;
  headlinePrefix?: string;
  headlineAccent?: string;
  intro?: string;
  features?: Feature[];
  closing?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'The Opportunity',
  headlinePrefix = 'Search is moving to AI.',
  headlineAccent = "Client visibility has to move with it.",
  intro = "AI assistants don't rank businesses the way search engines used to — they pull from whichever profiles are the most complete, consistent, and current. Four factors decide whether a client's business gets surfaced at all:",
  features = [
    {
      icon: 'database',
      title: 'Complete Profile Data',
      description: 'Every field filled in and categorized correctly is what lets an AI model recognize a business in the first place.',
    },
    {
      icon: 'shield-check',
      title: 'Consistent Listings',
      description: 'When the same details show up everywhere a business is listed, AI tools treat that business as a trustworthy source.',
    },
    {
      icon: 'refresh',
      title: 'Active Update History',
      description: "Profiles that are updated regularly get weighted higher than ones that haven't changed in months.",
    },
    {
      icon: 'video',
      title: 'Original Video Content',
      description: 'Video shows up disproportionately often in AI-generated answers, and most local business profiles still have none.',
    },
  ],
  closing = "Keeping all four current for even one client takes real, ongoing work. Nova handles it automatically, for every client on your roster, without adding to your team's plate.",
  ctaLabel = 'Start Free Trial',
  ctaHref = '#trial',
} = Astro.props;

const icons: Record<string, string> = {
  database: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>',
  'shield-check': '<path d="M12 2L4 5V11C4 16 7.5 20.5 12 22C16.5 20.5 20 16 20 11V5L12 2Z"/><path d="M9 12l2 2 4-4"/>',
  refresh: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v6h-6"/>',
  video: '<rect x="2" y="5" width="14" height="14" rx="2"/><path d="M16 10l6-4v12l-6-4"/>',
};
---

<section class="agency-features" id="why-it-matters">
  <div class="features-inner">

    <div class="features-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">
        <span class="line accent">{headlinePrefix}</span>
        <span class="line">{headlineAccent}</span>
      </h2>
      <p class="intro">{intro}</p>
    </div>

    <div class="feature-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="#6D4FF0" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[f.icon]} />
          </div>
          <div class="feature-copy">
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.description}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="closing">{closing}</p>

    <div class="features-cta-row">
      <a href={ctaHref} class="features-cta">{ctaLabel}</a>
    </div>

  </div>
</section>

<style>
  .agency-features {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #F8F9FE;
    padding: 76px 40px;
  }
  .features-inner { max-width: 900px; margin: 0 auto; text-align: center; }

  .features-header { margin: 0 auto 40px; }
  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6D4FF0;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Sora', sans-serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0 0 18px;
  }
  .headline .line { display: block; }
  .headline .accent {
    background: linear-gradient(135deg, #6D4FF0, #3E7BFA);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .headline .line:not(.accent) { color: #14162B; }
  .intro {
    font-size: 15px;
    line-height: 1.65;
    color: #5B5F7A;
    margin: 0 auto;
    max-width: 640px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    text-align: left;
    margin-bottom: 34px;
  }
  .feature-card {
    background: #ffffff;
    border: 1px solid #EDEEF7;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .icon-wrap {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 9px;
    background: #EEF1FF;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icon-wrap svg { width: 19px; height: 19px; }
  .feature-title {
    font-family: 'Sora', sans-serif;
    font-size: 15.5px;
    font-weight: 700;
    color: #14162B;
    margin: 0 0 6px;
  }
  .feature-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: #5B5F7A;
    margin: 0;
  }

  .closing {
    font-size: 13.5px;
    font-style: italic;
    color: #6D4FF0;
    max-width: 640px;
    margin: 0 auto 30px;
  }

  .features-cta-row { display: flex; justify-content: center; }
  .features-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    background: linear-gradient(135deg, #6D4FF0, #3E7BFA);
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 100px;
    transition: opacity 0.15s;
  }
  .features-cta:hover { opacity: 0.88; }

  @media (max-width: 700px) {
    .feature-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .agency-features { padding: 56px 20px; }
  }
</style>
