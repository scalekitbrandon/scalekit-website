---
// Therapists & Advisors industry template — Flexible. Second alternating
// illustration + copy section per README.md's deferred plan ("flexible,
// accessible support for the everyday person"). Mirrors Intro.astro's
// badge-icon treatment but flips the layout (copy left, badge right) for
// the alternating rhythm the reference used. Same placeholder brand.
interface Props {
  headline?: string;
  body?: string;
}

const {
  headline = 'Support That Fits Real Life',
  body = "You shouldn't have to wait weeks for a first appointment or rearrange your whole schedule to get help. In-person and telehealth sessions are both available, with times that actually work around your job, your kids, or your commute.",
} = Astro.props;
---

<section class="flexible">
  <div class="flexible-inner">
    <div class="flexible-copy">
      <h2 class="headline">{headline}</h2>
      <span class="underline"></span>
      <p class="body">{body}</p>
    </div>

    <div class="flexible-badge">
      <svg viewBox="0 0 100 100" class="badge-ring-svg">
        <circle cx="50" cy="50" r="47" fill="none" stroke="#3B5A4E" stroke-width="1.2" />
      </svg>
      <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="#3B5A4E" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2"/>
        <path d="M16 2v4M8 2v4M3 10h18"/>
        <path d="M8 14h.01M12 14h.01M16 14h.01"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .flexible {
    font-family: 'Karla', -apple-system, sans-serif;
    background: #F3E1D3;
    padding: 76px 40px;
  }
  .flexible-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 70px;
    align-items: center;
  }

  .headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 600;
    color: #2C3B35;
    margin: 0 0 12px;
  }
  .underline {
    display: block;
    width: 48px;
    height: 2px;
    background: #3B5A4E;
    margin: 0 0 20px;
  }
  .body {
    font-size: 15px;
    line-height: 1.7;
    color: #5C4A3D;
    margin: 0;
    max-width: 480px;
  }

  .flexible-badge {
    position: relative;
    width: 220px;
    height: 220px;
    margin: 0 auto;
  }
  .badge-ring-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .badge-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 46px;
    height: 46px;
  }

  @media (max-width: 760px) {
    .flexible-inner { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .flexible-inner { grid-template-areas: 'badge' 'copy'; }
    .flexible-badge { order: -1; }
    .underline { margin: 0 auto 20px; }
    .body { margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .flexible { padding: 56px 20px; }
  }
</style>
