---
// Therapists & Advisors industry template — Intro. Follows Header +
// Hero + Specialties, same placeholder brand (sage green / cream /
// blush, Cormorant Garamond + Karla). Structure cloned from the
// reference's illustration + copy intro section — the reference used a
// hand-drawn character illustration; this uses a simple line-art badge
// icon instead (no illustration asset was supplied), with copy written
// generic enough to cover both therapists and advisors.
interface Props {
  headline?: string;
  body?: string;
}

const {
  headline = 'A Practice Built Around You',
  body = "Whether you're working through a difficult season or planning for what comes next, having the right person in your corner makes all the difference. Sessions are unhurried, judgment-free, and built around your goals — not a one-size-fits-all script.",
} = Astro.props;
---

<section class="ther-intro">
  <div class="intro-inner">
    <div class="intro-badge">
      <svg viewBox="0 0 100 100" class="badge-ring-svg">
        <circle cx="50" cy="50" r="47" fill="none" stroke="#3B5A4E" stroke-width="1.2" />
      </svg>
      <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="#3B5A4E" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21s-7-4.35-9.5-8.5C.5 8.5 3 5 6.5 5c2 0 3.5 1.5 5.5 4 2-2.5 3.5-4 5.5-4 3.5 0 6 3.5 4 7.5C19 16.65 12 21 12 21z"/>
      </svg>
    </div>

    <div class="intro-copy">
      <h2 class="headline">{headline}</h2>
      <span class="underline"></span>
      <p class="body">{body}</p>
    </div>
  </div>
</section>

<style>
  .ther-intro {
    font-family: 'Karla', -apple-system, sans-serif;
    background: #FDFBF7;
    padding: 76px 40px;
  }
  .intro-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 70px;
    align-items: center;
  }

  .intro-badge {
    position: relative;
    width: 220px;
    height: 220px;
    margin: 0 auto;
  }
  .badge-ring-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .badge-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 46px;
    height: 46px;
  }

  .headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 600;
    color: #2C3B35;
    margin: 0 0 12px;
  }
  .underline {
    display: block;
    width: 48px;
    height: 2px;
    background: #3B5A4E;
    margin: 0 0 20px;
  }
  .body {
    font-size: 15px;
    line-height: 1.7;
    color: #6B7D75;
    margin: 0;
    max-width: 480px;
  }

  @media (max-width: 760px) {
    .intro-inner { grid-template-columns: 1fr; text-align: center; }
    .underline { margin: 0 auto 20px; }
    .body { margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .ther-intro { padding: 56px 20px; }
  }
</style>
