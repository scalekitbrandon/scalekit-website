---
// Therapists & Advisors industry template — Hero. Structure cloned from
// a reference therapy-practice homepage (full-bleed photo with a
// centered serif tagline, and a CTA anchored to the photo's bottom-right
// corner) — colors, copy, and business identity are ScaleKit's own
// placeholder brand, not carried over from the reference. Copy is
// written generic enough to cover both therapists and advisors (this
// trade slot covers both), not narrowly clinical.
// PLACEHOLDER: [HERO_IMAGE_URL] needs a real photo before use — no
// fabricated/stock image is baked in here. "Brooklyn NY" is a demo
// location default — swap for the real client's city.
interface Props {
  heroTagline?: string;
  ctaLabel?: string;
  ctaHref?: string;
  heroImageUrl?: string;
}

const {
  heroTagline = 'Professional Therapy Services in Brooklyn NY',
  ctaLabel = 'Get Started',
  ctaHref = '#contact',
  heroImageUrl = '[HERO_IMAGE_URL]',
} = Astro.props;
---

<section class="ther-hero">
  <div class="hero-bg" style={`background-image: linear-gradient(rgba(40,60,52,0.82), rgba(40,60,52,0.92)), url('${heroImageUrl}');`}></div>

  <div class="hero-center">
    <p class="hero-tagline">{heroTagline}</p>
  </div>

  <a href={ctaHref} class="hero-cta">
    {ctaLabel}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
  </a>
</section>

<style>
  .ther-hero {
    position: relative;
    font-family: 'Karla', -apple-system, sans-serif;
    height: 560px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-color: #6E7F76;
    background-size: cover;
    background-position: center 15%;
  }

  .hero-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 60px;
  }
  .hero-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    line-height: 1.3;
    color: #ffffff;
    text-align: center;
    max-width: 620px;
    margin: 0;
  }

  .hero-cta {
    position: absolute;
    bottom: 28px;
    right: 32px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    background: #3B5A4E;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 5px;
    transition: background 0.15s;
  }
  .hero-cta svg { width: 14px; height: 14px; }
  .hero-cta:hover { background: #2C453B; }

  @media (max-width: 700px) {
    .ther-hero { height: 460px; }
    .hero-center { padding: 0 30px; }
  }
</style>
