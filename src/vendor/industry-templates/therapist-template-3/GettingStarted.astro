---
// Therapist Template 3 (group therapy practice) — Getting Started.
// No reference screenshot was given for this one — designed to match
// the quality bar and blue/terracotta/cream palette established by the
// rest of this template, following the same 3-step process pattern
// used elsewhere in this template set.
interface Step {
  number: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  steps?: Step[];
}

const {
  eyebrow = 'Getting Started',
  headline = 'Three Steps to Your First Session',
  steps = [
    { number: '01', title: 'Reach Out', description: 'Send a message or give us a call — no lengthy intake form standing between you and a real answer.' },
    { number: '02', title: 'Free Consultation', description: "A short call to talk through what you're looking for and see if it's the right fit." },
    { number: '03', title: 'Begin Your Sessions', description: 'In-person or virtual, on a schedule that actually works for your life.' },
  ],
} = Astro.props;
---

<section class="getting-started">
  <div class="started-inner">
    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
    </div>

    <div class="step-row">
      {steps.map((step) => (
        <div class="step-card">
          <span class="step-number">{step.number}</span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .getting-started {
    font-family: 'Work Sans', -apple-system, sans-serif;
    background: #FFFFFF;
    padding: 100px 40px;
  }
  .started-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .header { text-align: center; margin: 0 0 56px; }
  .eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #D9A48A;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 3.2vw, 38px);
    color: #2E3A5C;
    margin: 0;
  }

  .step-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .step-card {
    background: #FBF6EF;
    border-radius: 16px;
    padding: 36px 32px;
    text-align: center;
  }
  .step-number {
    display: inline-block;
    font-family: 'Poppins', sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: #6B7FB0;
    margin-bottom: 14px;
  }
  .step-title {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #2E3A5C;
    margin: 0 0 10px;
  }
  .step-desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: #3A3A3A;
    margin: 0;
  }

  @media (max-width: 800px) {
    .step-row { grid-template-columns: 1fr; gap: 20px; }
    .getting-started { padding: 72px 24px; }
  }
</style>
