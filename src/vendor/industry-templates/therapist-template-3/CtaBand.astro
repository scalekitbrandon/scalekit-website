---
// Therapist Template 3 (group therapy practice) — CtaBand.
// No reference screenshot was given for this one — full-width navy band
// closing the page, reusing the blue/terracotta CTA pairing established
// in Hero.astro for visual consistency across the template.
interface Props {
  headline?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  headline = 'Ready When You Are',
  body = "There's no perfect time to reach out — just the moment you decide you're ready. Send a message and we'll take it from there.",
  ctaLabel = 'Contact Us',
  ctaHref = '#contact',
} = Astro.props;
---

<section class="cta-band">
  <div class="cta-inner">
    <h2 class="headline">{headline}</h2>
    <p class="body">{body}</p>
    <a href={ctaHref} class="cta">{ctaLabel}</a>
  </div>
</section>

<style>
  .cta-band {
    font-family: 'Work Sans', -apple-system, sans-serif;
    background: #2E3A5C;
    padding: 100px 40px;
    text-align: center;
  }
  .cta-inner { max-width: 640px; margin: 0 auto; }

  .headline {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 40px);
    color: #FFFFFF;
    margin: 0 0 18px;
  }
  .body {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 36px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 34px;
    background: #D9A48A;
    color: #2E3A5C;
    font-family: 'Poppins', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .cta:hover { background: #C68F73; }

  @media (max-width: 560px) {
    .cta-band { padding: 72px 24px; }
  }
</style>
