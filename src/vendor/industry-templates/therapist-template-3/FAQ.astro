---
// Therapist Template 3 (group therapy practice) — FAQ.
// No reference screenshot was given for this one — zero-JS <details>
// accordion pattern used site-wide across this template set. Answers
// are practical/logistics-focused (insurance, confidentiality,
// telehealth) — no clinical claims, no guaranteed outcomes.
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  items?: FaqItem[];
}

const {
  eyebrow = 'Good to Know',
  headline = 'Answers Before Your First Session',
  items = [
    {
      question: 'Do you accept insurance?',
      answer: "Coverage varies by plan — reach out and we'll help you figure out what applies before your first session, not after.",
    },
    {
      question: 'Is everything I share confidential?',
      answer: 'Yes. What you share stays between you and your therapist, within the standard legal and ethical limits any licensed practice follows.',
    },
    {
      question: 'What happens in a first session?',
      answer: "No pressure, no script — just a conversation about what brought you in and what you're hoping to get out of working together.",
    },
    {
      question: 'Do you offer virtual sessions?',
      answer: 'Yes. Both in-person and virtual sessions are available, whichever fits your schedule better.',
    },
  ],
} = Astro.props;
---

<section class="faq">
  <div class="faq-inner">
    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
    </div>

    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            {item.question}
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p class="faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    font-family: 'Work Sans', -apple-system, sans-serif;
    background: #FBF6EF;
    padding: 100px 40px;
  }
  .faq-inner { max-width: 760px; margin: 0 auto; }

  .header { text-align: center; margin: 0 0 44px; }
  .eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #D9A48A;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 3vw, 36px);
    color: #2E3A5C;
    margin: 0;
  }

  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: #FFFFFF;
    border: 1.5px solid #6B7FB0;
    border-radius: 12px;
    padding: 22px 26px;
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #2E3A5C;
    cursor: pointer;
    list-style: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .chevron { width: 17px; height: 17px; flex-shrink: 0; color: #6B7FB0; transition: transform 0.2s; }
  .faq-item[open] .chevron { transform: rotate(180deg); }
  .faq-answer {
    font-size: 14.5px;
    line-height: 1.65;
    color: #3A3A3A;
    margin: 14px 0 0;
    padding-right: 30px;
  }

  @media (max-width: 560px) {
    .faq { padding: 72px 24px; }
    .faq-item { padding: 18px 20px; }
  }
</style>
