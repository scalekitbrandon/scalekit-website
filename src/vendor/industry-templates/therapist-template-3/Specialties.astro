---
// Therapist Template 3 (group therapy practice) — Specialties.
// Structure AND palette cloned from the same reference (centered blue
// headline + subtext, then a row of bordered rounded cards — one per
// category — each listing specialty items with a chevron and a thin
// divider between rows) — per explicit direction this keeps the
// reference's blue/cream palette and border-card treatment matching
// About.astro. Category/specialty names are standard clinical
// terminology (same convention as the "Individual Therapy," "Couples
// Therapy," etc. lists already used elsewhere in this template set),
// not copied creative copy.
interface SpecialtyGroup {
  category: string;
  items: string[];
}

interface Props {
  headline?: string;
  subtext?: string;
  groups?: SpecialtyGroup[];
}

const {
  headline = 'What We Help With',
  subtext = 'From anxiety and relationships to identity and life transitions, we help with the patterns that make everyday life feel heavier than it should.',
  groups = [
    {
      category: 'Emotional Health',
      items: ['Anxiety Therapy', 'Depression Therapy', 'Trauma + PTSD', 'Grief + Loss', 'Anger Management'],
    },
    {
      category: 'Relationships',
      items: ['Relationship Issues', 'Couples Therapy', 'Marital + Premarital', 'Family Conflict', 'Sex Positive Therapy'],
    },
    {
      category: 'Identity + Life',
      items: ['Self-Esteem + Identity', 'LGBTQIA+ Affirming Therapy', 'Life Transitions + Career', 'Young Adults', 'Existential Stress + Political Anxiety'],
    },
    {
      category: 'Additional Support',
      items: ['ADHD + Executive Functioning', "Women's Issues", "Men's Issues"],
    },
  ],
} = Astro.props;
---

<section class="specialties">
  <div class="specialties-inner">
    <div class="specialties-header">
      <h2 class="headline">{headline}</h2>
      <p class="subtext">{subtext}</p>
    </div>

    <div class="groups-grid">
      {groups.map((group) => (
        <div class="group-card">
          <p class="category">{group.category}</p>
          <ul class="item-list">
            {group.items.map((item) => (
              <li class="item-row">
                <span>{item}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .specialties {
    font-family: 'Work Sans', -apple-system, sans-serif;
    background: #FBF6EF;
    padding: 100px 40px;
  }
  .specialties-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .specialties-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 56px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 3.2vw, 40px);
    color: #6B7FB0;
    margin: 0 0 16px;
  }
  .subtext {
    font-size: 16px;
    line-height: 1.65;
    color: #3A3A3A;
    margin: 0;
  }

  .groups-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .group-card {
    background: #FFFFFF;
    border: 1.5px solid #6B7FB0;
    border-radius: 16px;
    padding: 32px 28px;
  }
  .category {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6B7FB0;
    margin: 0 0 20px;
  }
  .item-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid #EDE3D6;
    font-size: 14.5px;
    color: #2E3A5C;
  }
  .item-row:last-child { border-bottom: none; padding-bottom: 0; }
  .item-row:first-child { padding-top: 0; }
  .item-row svg { width: 15px; height: 15px; flex-shrink: 0; color: #6B7FB0; }

  @media (max-width: 1080px) {
    .groups-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (max-width: 600px) {
    .groups-grid { grid-template-columns: 1fr; }
    .specialties { padding: 72px 24px; }
  }
</style>
