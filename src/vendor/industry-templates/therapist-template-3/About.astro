---
// Therapist Template 3 (group therapy practice) — About.
// Structure AND palette cloned from the same reference (two overlapping
// rounded cards on a cream background: left a bordered white copy card
// with eyebrow/headline/body/CTA, right a taller photo card that breaks
// past the copy card's top/bottom edge, with a thin divider + a founder
// name/title caption along the photo's bottom) — per explicit direction
// this keeps the reference's blue/cream palette. Copy rewritten from
// scratch for this invented practice; the reference's two real city
// labels (New York/New Jersey) were replaced with an invented founder
// name/title caption instead.
// PLACEHOLDER: [ABOUT_PHOTO_URL] needs a real photo before use — no
// fabricated/stock image is baked in here. Founder name/title are
// generic placeholders for this invented practice.
interface Props {
  eyebrow?: string;
  headline?: string;
  headlineEmphasis?: string;
  bodyLead?: string;
  bodyLeadEmphasis?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  photoUrl?: string;
  founderName?: string;
  founderTitle?: string;
}

const {
  eyebrow = 'About Ashford Therapy',
  headline = 'Therapy that ',
  headlineEmphasis = 'actually fits your life.',
  bodyLead = "You can be doing everything right and still feel like",
  bodyLeadEmphasis = "there's still something you haven't said out loud.",
  body = "At Ashford Therapy, our approach stays steady and personal — no scripts, no rushing. From your first conversation with us, the process is clear, collaborative, and focused on what actually helps.",
  ctaLabel = 'Start With a Consultation',
  ctaHref = '#contact',
  photoUrl = '[ABOUT_PHOTO_URL]',
  founderName = 'Elena Voss, LCSW',
  founderTitle = 'Founder & Clinical Director',
} = Astro.props;
---

<section class="about" id="about">
  <div class="about-inner">
    <div class="about-copy-card">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}<span>{headlineEmphasis}</span></h2>
      <p class="body-lead">{bodyLead} <strong>{bodyLeadEmphasis}</strong></p>
      <p class="body">{body}</p>
      <a href={ctaHref} class="cta">{ctaLabel}</a>
    </div>

    <div class="about-photo-card">
      <!-- PLACEHOLDER: replace photoUrl with a real photo before use -->
      <div class="about-photo-img" style={`background-image: url('${photoUrl}');`}></div>
      <div class="photo-footer">
        <span class="founder-name">{founderName}</span>
        <span class="founder-title">{founderTitle}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    font-family: 'Work Sans', -apple-system, sans-serif;
    background: #FBF6EF;
    padding: 60px 40px 120px;
  }
  .about-inner {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  .about-copy-card {
    position: relative;
    z-index: 1;
    background: #FFFFFF;
    border: 1.5px solid #6B7FB0;
    border-radius: 20px;
    padding: 64px 60px;
  }
  .eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6B7FB0;
    margin: 0 0 18px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.3;
    color: #8FA3D1;
    margin: 0 0 28px;
  }
  .headline span { font-weight: 700; color: #4C5D8A; }
  .body-lead {
    font-size: 16px;
    line-height: 1.7;
    color: #2E3A5C;
    margin: 0 0 18px;
  }
  .body-lead strong { font-weight: 700; }
  .body {
    font-size: 16px;
    line-height: 1.7;
    color: #3A3A3A;
    margin: 0 0 36px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 30px;
    background: #6B7FB0;
    color: #FFFFFF;
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .cta:hover { background: #4C5D8A; }

  .about-photo-card {
    position: relative;
    z-index: 2;
    margin-left: -30px;
    margin-top: -48px;
    margin-bottom: -48px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(46, 58, 92, 0.18);
    min-height: 560px;
  }
  .about-photo-img {
    position: absolute;
    inset: 0;
    background-color: #7A7A7A;
    background-size: cover;
    background-position: center;
  }
  .photo-footer {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.5);
  }
  .founder-name {
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #FFFFFF;
  }
  .founder-title {
    font-family: 'Work Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 900px) {
    .about-inner { grid-template-columns: 1fr; }
    .about-copy-card { padding: 48px 32px; }
    .about-photo-card {
      margin-left: 0;
      margin-top: 32px;
      margin-bottom: 0;
      min-height: 380px;
    }
    .about { padding: 56px 24px 80px; }
  }
</style>
