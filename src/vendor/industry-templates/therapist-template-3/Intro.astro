---
// Therapist Template 3 (group therapy practice) — Intro.
// Structure AND palette cloned from the same reference (two-column
// "something feels off" copy block in cream/blue, then a 3-image nav-
// card row) — per explicit direction this keeps the reference's blue +
// cream palette. Copy rewritten from scratch for this invented practice;
// real geography from the reference was not carried over.
// PLACEHOLDER: all three nav-card image URLs need real photos before
// use — no fabricated/stock images are baked in here.
interface NavCard {
  imageUrl: string;
  label: string;
  href: string;
}

interface Props {
  headline?: string;
  headlineEmphasis?: string;
  body1?: string;
  body2?: string;
  navCards?: NavCard[];
}

const {
  headline = 'When everything looks fine on paper, but something still',
  headlineEmphasis = 'feels heavy.',
  body1 = "Many of the people who come to Ashford Therapy are balancing work, relationships, and family responsibilities all at once. Over time, that weight can turn into something harder to carry alone — anxiety that lingers, tension at home, or a sense that life has gotten harder to navigate.",
  body2 = "Ashford Therapy is a team of licensed therapists providing care for individuals, couples, and families. Our work is thoughtful and collaborative, focused on helping you understand what you're carrying and move forward with more clarity and steadiness.",
  navCards = [
    { imageUrl: '[SPECIALTIES_IMAGE_URL]', label: 'Therapy Specialties', href: '#specialties' },
    { imageUrl: '[ABOUT_IMAGE_URL]', label: 'About Ashford Therapy', href: '#about' },
    { imageUrl: '[INSIGHTS_IMAGE_URL]', label: 'Insights & Resources', href: '#insights' },
  ],
} = Astro.props;
---

<section class="aa-intro">
  <div class="intro-inner">
    <div class="intro-copy">
      <h2 class="headline">
        {headline} <span>{headlineEmphasis}</span>
      </h2>
      <div class="body-copy">
        <p>{body1}</p>
        <p>{body2}</p>
      </div>
    </div>

    <div class="nav-cards">
      {navCards.map((card) => (
        <a href={card.href} class="nav-card">
          <!-- PLACEHOLDER: replace imageUrl with a real photo before use -->
          <div class="nav-card-image" style={`background-image: url('${card.imageUrl}');`}></div>
          <span class="nav-card-label">{card.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .aa-intro {
    font-family: 'Work Sans', -apple-system, sans-serif;
    background: #FBF6EF;
    padding: 100px 40px 80px;
  }
  .intro-inner {
    max-width: 1360px;
    margin: 0 auto;
  }

  .intro-copy {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 80px;
    margin-bottom: 72px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.35;
    color: #6B7FB0;
    margin: 0;
  }
  .headline span { font-weight: 700; color: #2E3A5C; }
  .body-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .body-copy p {
    font-size: 16.5px;
    line-height: 1.75;
    color: #3A3A3A;
    margin: 0;
  }

  .nav-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .nav-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }
  .nav-card-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    background-color: #E4DFD3;
    background-size: cover;
    background-position: center;
    margin-bottom: 18px;
    transition: opacity 0.15s;
  }
  .nav-card:hover .nav-card-image { opacity: 0.85; }
  .nav-card-label {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6B7FB0;
  }

  @media (max-width: 900px) {
    .intro-copy { grid-template-columns: 1fr; gap: 28px; }
    .nav-cards { grid-template-columns: 1fr; gap: 40px; }
    .aa-intro { padding: 72px 24px 56px; }
  }
</style>
