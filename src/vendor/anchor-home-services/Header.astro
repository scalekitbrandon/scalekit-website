---
// Home Services industry template — Header/Nav.
// Structure cloned from a reference home-services company's homepage
// (single navy nav bar, logo + tagline stack, dropdown-capable nav
// links, single gold CTA) — colors, logo, business name, and copy are
// ScaleKit's own placeholder brand, not carried over from the reference.
// Fifth distinct identity in the set: navy `#12294F` + warm gold
// `#F0A93B`, `Poppins` headline font + `Inter` body — different from
// every other template so far (Oswald/gold-black, Fraunces/forest-green,
// Manrope/navy-orange, Sora/purple-blue-gradient).
// PLACEHOLDER: business name, phone, and nav link targets — swap for a
// real client's info when this template is used for an actual
// home-services client build.
interface NavLink {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface Props {
  businessName?: string;
  tagline?: string;
  links?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  businessName = 'Anchor',
  tagline = 'Home Services, The Easy Way',
  links = [
    { label: 'Home', href: '#home' },
    { label: 'Services', href: '#services', hasDropdown: true },
    { label: 'About Us', href: '#about', hasDropdown: true },
    { label: 'Resources', href: '#resources', hasDropdown: true },
    { label: 'Service Areas', href: '#service-areas' },
  ],
  ctaLabel = 'Get Estimate',
  ctaHref = '#estimate',
} = Astro.props;
---

<header class="home-header">
  <div class="header-inner">
    <a href="#home" class="logo">
      <span class="logo-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="#12294F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11L12 4L21 11"/><path d="M5 10V20H19V10"/><path d="M9 20V14H15V20"/></svg>
      </span>
      <span class="logo-text">
        <span class="logo-name">{businessName}</span>
        <span class="logo-tagline">{tagline}</span>
      </span>
    </a>

    <nav class="nav-links">
      {links.map((link) => (
        <a href={link.href} class="nav-link">
          {link.label}
          {link.hasDropdown && (
            <svg viewBox="0 0 12 12" fill="none"><path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          )}
        </a>
      ))}
    </nav>

    <a href={ctaHref} class="cta">{ctaLabel}</a>
  </div>
</header>

<style>
  .home-header {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #12294F;
  }
  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    height: 96px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-badge {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: #F0A93B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .logo-badge svg { width: 21px; height: 21px; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.15; }
  .logo-name {
    font-family: 'Poppins', sans-serif;
    font-size: 19px;
    font-weight: 700;
    color: #ffffff;
  }
  .logo-tagline {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 2px;
  }
  .nav-links { display: flex; align-items: center; gap: 26px; margin-left: auto; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }
  .nav-link svg { width: 9px; height: 9px; }
  .nav-link:hover { color: #F0A93B; }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 17px 32px;
    background: #F0A93B;
    color: #12294F;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .cta:hover { background: #dc971f; }

  @media (max-width: 980px) {
    .nav-links { display: none; }
    .header-inner { padding: 0 20px; }
    .cta { margin-left: auto; }
  }

  /* Real bug, not a preview-scaling issue: below ~980px only .nav-links
     hides — the logo block (icon + name + tagline) and the full-size CTA
     button were never given their own narrower treatment, so on an
     actual phone width they still overflow and get clipped. Shrink both
     down (drop the tagline, smaller badge/name, smaller CTA) so the row
     genuinely fits at real mobile widths. */
  @media (max-width: 480px) {
    .header-inner { padding: 0 16px; gap: 12px; height: 76px; }
    .logo-badge { width: 34px; height: 34px; }
    .logo-badge svg { width: 17px; height: 17px; }
    .logo-name { font-size: 16px; }
    .logo-tagline { display: none; }
    .cta { padding: 10px 16px; font-size: 13px; }
  }
</style>
