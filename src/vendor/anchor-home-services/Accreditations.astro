---
// Home Services industry template — Accreditations. Dark full-bleed
// trust strip with a scrolling badge row (CSS-only marquee, no JS
// needed). Uses generic capability/policy badges (Licensed & Insured,
// Locally Owned, etc.) rather than real third-party certification logos
// (BBB, Angi, HomeAdvisor) — this is an invented placeholder business
// ("Anchor"), so implying a real accreditation body's endorsement would
// be a fabricated claim, not just placeholder copy.
interface Props {
  badges?: string[];
}

const {
  badges = [
    'Licensed & Insured',
    'Locally Owned & Operated',
    'Background-Checked Crews',
    'Upfront, Flat-Rate Pricing',
    'Satisfaction Guaranteed',
    'Same-Week Scheduling',
  ],
} = Astro.props;

// Duplicated once for a seamless CSS marquee loop.
const looped = [...badges, ...badges];
---

<section class="accreditations">
  <div class="track">
    {looped.map((b) => (
      <span class="badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="#F0A93B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        {b}
      </span>
    ))}
  </div>
</section>

<style>
  .accreditations {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #0B1B36;
    padding: 26px 0;
    overflow: hidden;
  }
  .track {
    display: flex;
    align-items: center;
    gap: 48px;
    width: max-content;
    animation: scroll 26s linear infinite;
  }
  .accreditations:hover .track { animation-play-state: paused; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
  }
  .badge svg { width: 16px; height: 16px; flex-shrink: 0; }

  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 560px) {
    .accreditations { padding: 20px 0; }
    .track { gap: 32px; }
  }
</style>
