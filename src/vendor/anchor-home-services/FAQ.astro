---
// Home Services industry template — FAQ. Added beyond README.md's
// original deferred list to round out a full home page (matching the
// quality bar of ScaleKit's own site, which closes every page with an
// FAQ + final CTA before the footer). Same zero-JS <details>/<summary>
// accordion pattern used site-wide on scalekit.io (PricingFaq.astro,
// ScoutFaq.astro) — generic, honest answers, no fabricated guarantees
// or timelines.
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  items?: FaqItem[];
}

const {
  eyebrow = 'Good to Know',
  headline = 'Common Questions',
  items = [
    {
      question: 'Do you offer free estimates?',
      answer: 'Yes. Every estimate is free, with no obligation to book. We\'ll give you a real, written price before any work starts.',
    },
    {
      question: 'Are your crews licensed and insured?',
      answer: 'Yes — every job is covered, and every crew member is background-checked before they ever step on your property.',
    },
    {
      question: 'How soon can you start?',
      answer: 'Scheduling depends on the season and scope of work, but we\'ll give you a real timeline on your free consultation — not a vague "we\'ll call you."',
    },
    {
      question: 'What if I\'m not happy with the work?',
      answer: "We come back and fix it, at no extra cost. That's the guarantee, not a marketing line.",
    },
  ],
} = Astro.props;
---

<section class="faq">
  <div class="faq-inner">
    <div class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline">{headline}</h2>
    </div>

    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            {item.question}
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <p class="faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #F6F7FA;
    padding: 84px 40px;
  }
  .faq-inner { max-width: 780px; margin: 0 auto; }

  .header { text-align: center; margin: 0 auto 40px; }
  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F0A93B;
    margin: 0 0 12px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(36px, 4.5vw, 58px);
    font-weight: 700;
    color: #12294F;
    margin: 0;
  }

  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    background: #ffffff;
    border: 1px solid #E6E9EF;
    border-radius: 8px;
    padding: 18px 22px;
  }
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 15.5px;
    font-weight: 700;
    color: #12294F;
    cursor: pointer;
    list-style: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .chevron { width: 17px; height: 17px; flex-shrink: 0; color: #8B96A5; transition: transform 0.2s; }
  .faq-item[open] .chevron { transform: rotate(180deg); }
  .faq-answer {
    font-size: 14.5px;
    line-height: 1.6;
    color: #4B5768;
    margin: 12px 0 0;
    padding-right: 30px;
  }

  @media (max-width: 560px) {
    .faq { padding: 56px 20px; }
    .faq-item { padding: 16px; }
  }
</style>
