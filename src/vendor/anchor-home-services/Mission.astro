---
// Home Services industry template — Mission. First of the sections
// deferred in README.md ("why we do this" mission-statement section with
// a centered CTA). Same placeholder brand as Header/Hero/Services (navy
// #12294F / gold #F0A93B, Poppins headline + Inter body, 1400px max
// width). No real claims — copy is generic "how we operate" positioning
// for the invented "Anchor" placeholder business, not a fabricated
// mission drawn from any real company.
interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Why We Do This',
  headline = 'Homeowners Deserve a Contractor They Can Actually Trust',
  body = "We started Anchor because too many homeowners get burned by vague quotes, no-shows, and work that doesn't hold up. Every job gets a clear price up front, a crew that shows up when we say we will, and work we stand behind after the truck leaves.",
  ctaLabel = 'See How We Work',
  ctaHref = '#services',
} = Astro.props;
---

<section class="mission">
  <div class="mission-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="headline">{headline}</h2>
    <p class="body">{body}</p>
    <a href={ctaHref} class="cta">{ctaLabel}</a>
  </div>
</section>

<style>
  .mission {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #F6F7FA;
    padding: 84px 40px;
    text-align: center;
  }
  .mission-inner { max-width: 760px; margin: 0 auto; }

  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F0A93B;
    margin: 0 0 14px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(36px, 4.5vw, 58px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: #12294F;
    margin: 0 0 24px;
  }
  .body {
    font-size: 19.5px;
    line-height: 1.7;
    color: #4B5768;
    margin: 0 0 32px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    background: #12294F;
    color: #ffffff;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .cta:hover { background: #0B1B36; }

  @media (max-width: 560px) {
    .mission { padding: 56px 20px; }
  }
</style>
