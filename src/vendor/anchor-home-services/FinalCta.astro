---
// Home Services industry template — FinalCta. Added beyond README.md's
// original deferred list, matching the quality bar of ScaleKit's own
// site (every page closes with a dark final CTA band before the
// footer). Same navy/gold placeholder brand as the rest of this
// template.
interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  ctaLabel?: string;
  ctaHref?: string;
  phone?: string;
  phoneHref?: string;
}

const {
  eyebrow = 'Ready When You Are',
  headline = 'Get Your Free, No-Pressure Estimate',
  subheadline = 'Tell us what you need done — we\'ll give you a real price and a real timeline, no games.',
  ctaLabel = 'Get Your Instant Estimate',
  ctaHref = '#estimate',
  phone = '(555) 123-4567',
  phoneHref = 'tel:5551234567',
} = Astro.props;
---

<section class="final-cta">
  <div class="final-cta-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="headline">{headline}</h2>
    <p class="sub">{subheadline}</p>
    <div class="cta-row">
      <a href={ctaHref} class="cta">{ctaLabel}</a>
      <a href={phoneHref} class="phone-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {phone}
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    font-family: 'Inter', -apple-system, sans-serif;
    background: #0B1B36;
    padding: 88px 40px;
    text-align: center;
  }
  .final-cta-inner { max-width: 680px; margin: 0 auto; }

  .eyebrow {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F0A93B;
    margin: 0 0 16px;
  }
  .headline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(36px, 4.5vw, 58px);
    font-weight: 700;
    line-height: 1.2;
    color: #ffffff;
    margin: 0 0 20px;
  }
  .sub {
    font-size: 19.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 34px;
  }

  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 17px 34px;
    background: #F0A93B;
    color: #12294F;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .cta:hover { background: #dc971f; }
  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .phone-link svg { width: 17px; height: 17px; }
  .phone-link:hover { color: #F0A93B; }

  @media (max-width: 560px) {
    .final-cta { padding: 64px 20px; }
  }
</style>
